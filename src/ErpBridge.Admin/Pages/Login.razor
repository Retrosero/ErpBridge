@page "/login"
@inject ErpBridge.Admin.Api.CentralApiClient Api
@inject ErpBridge.Admin.Auth.TokenStore Tokens
@inject NavigationManager Nav

<PageTitle>Giriş — ErpBridge Yönetim</PageTitle>

<div class="admin-login">
<div class="admin-login__brand"><span>EB</span> ErpBridge <small>YÖNETİM MERKEZİ</small></div>
<h1>Tekrar hoş geldiniz</h1>
<p>Bağlantıları ve operasyonları yönetmek için hesabınızla giriş yapın.</p>

<EditForm class="admin-form-card" Model="_model" OnValidSubmit="HandleLoginAsync" FormName="login">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label" for="login-email">E-posta adresi</label>
        <InputText id="login-email" class="form-control" type="email" autocomplete="username" @bind-Value="_model.Email" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="login-password">Parola</label>
        <InputText id="login-password" class="form-control" type="password" autocomplete="current-password" @bind-Value="_model.Password" />
    </div>

    <button type="submit" class="btn btn-primary" disabled="@_busy">
        @(_busy ? "Giriş yapılıyor…" : "Giriş yap")
    </button>
</EditForm>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger mt-3">@_error</div>
}
</div>

@code {
    private readonly LoginModel _model = new();
    private bool _busy;
    private string? _error;

    private sealed class LoginModel
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }

    private async Task HandleLoginAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var resp = await Api.LoginAsync(_model.Email, _model.Password);
            Tokens.Set(resp.Token, resp.AdminId, resp.Email, resp.DisplayName, resp.ExpiresAtUtc);
            Nav.NavigateTo("/");
        }
        catch (ErpBridge.Admin.Api.UnauthorizedApiException)
        {
            _error = "E-posta adresi veya parola hatalı.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
