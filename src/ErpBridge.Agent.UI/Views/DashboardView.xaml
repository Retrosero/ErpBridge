<UserControl x:Class="ErpBridge.Agent.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ErpBridge.Agent.UI.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Üst başlık satırı: başlık + durum rozeti + Bootstrap/Yenile butonları -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Vertical">
                <TextBlock Text="Dashboard"
                           FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource HeaderBrush}" />
                <TextBlock Text="Senkronizasyon durumu ve operatör özet bilgileri"
                           FontSize="12"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Margin="0,2,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{Binding StatusBadgeBrush}"
                        CornerRadius="10"
                        Padding="10,3"
                        Margin="0,0,12,0"
                        ToolTip="Senkronizasyon gecikmesi / sağlık durumu">
                    <TextBlock Text="{Binding StatusBadgeText}"
                               Foreground="White"
                               FontWeight="SemiBold"
                               FontSize="12" />
                </Border>
                <Button Content="🔄 Senkronize Et"
                        Command="{Binding RunSyncDeltaCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="160"
                        Margin="0,0,8,0"
                        Padding="10,4"
                        ToolTip="Son sync'ten bu yana değişen INSERT/UPDATE/DELETE satırlarını sunucuya gönderir. Tüm veriyi gönderen 'Şimdi Bootstrap Et'in aksine sadece değişenleri aktarır." />
                <Button Content="🚀 Şimdi Bootstrap Et"
                        Command="{Binding RunBootstrapCommand}"
                        Style="{StaticResource TintedButtonStyle}"
                        MinWidth="180"
                        Margin="0,0,8,0"
                        Padding="10,4"
                        ToolTip="Mikro'dan tüm referans verileri çek ve Central API'ye gönder (60 dk idempotency penceresini bypass eder)" />
                <Button Content="🔃 Yenile"
                        Command="{Binding RefreshCommand}"
                        MinWidth="110"
                        Padding="10,4" />
            </StackPanel>
        </Grid>

        <!-- Per-section bootstrap buttons (workaround for slow Cloudflare tunnel) -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="14,12"
                Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Her Tablo (yavaş tunnel için)"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Margin="0,0,0,6" />
                <TextBlock TextWrapping="Wrap"
                           FontSize="11"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Margin="0,0,0,8">
                    <Run Text="Toplu bootstrap tunnel'da takılırsa, her tabloyu ayrı ayrı gönder. Her buton sadece ilgili Mikro tablosunu okur ve Central API'ye push eder." />
                </TextBlock>
                <ItemsControl>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <Button Content="👥 Cariler" Command="{Binding PushCustomersCommand}" MinWidth="120" Margin="0,0,6,6" Padding="8,4" />
                    <Button Content="📦 Stoklar" Command="{Binding PushStocksCommand}" MinWidth="120" Margin="0,0,6,6" Padding="8,4" />
                    <Button Content="📋 Açık Siparişler" Command="{Binding PushOpenOrdersCommand}" MinWidth="140" Margin="0,0,6,6" Padding="8,4" />
                    <Button Content="💰 Kasa/Banka" Command="{Binding PushCashAndBankCommand}" MinWidth="130" Margin="0,0,6,6" Padding="8,4" />
                    <Button Content="🔍 Lookup" Command="{Binding PushLookupsCommand}" MinWidth="120" Margin="0,0,6,6" Padding="8,4" />
                    <Button Content="💲 Fiyatlar" Command="{Binding PushPricesCommand}" MinWidth="120" Margin="0,0,6,6" Padding="8,4" />
                    <Button Content="📊 Envanter" Command="{Binding PushInventoryCommand}" MinWidth="120" Margin="0,0,6,6" Padding="8,4" />
                    <Button Content="📰 Cari Hareketleri" Command="{Binding PushCustomerTransactionsCommand}" MinWidth="150" Margin="0,0,6,6" Padding="8,4" />
                    <Button Content="🔄 Stok Hareketleri" Command="{Binding PushStockTransactionsCommand}" MinWidth="150" Margin="0,0,6,6" Padding="8,4" />
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Ana içerik: 2 sütun. Sol = Son Senkronizasyon, Sağ = Veri paneli
             (MikroDB satır sayıları + son çalıştırma özeti). Kalan alanı
             oranı 4:5 — sol taraf kronolojik özet (büyük tarih + yaş),
             sağ taraf veri ağırlıklı (sayılar) olduğu için biraz daha geniş. -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <!-- SOL: Son Senkronizasyon kartı -->
            <Border Grid.Column="0"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="Son Senkronizasyon"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedTextBrush}" />

                    <!-- Tarih/saat blok: ekranda kart'ın ana vurgusu. FontSize
                         büyük tutuldu ki pencere uzaktan bakıldığında bile
                         son sync zamanı okunabilsin. -->
                    <TextBlock Text="{Binding LastSyncAtDisplay}"
                               FontSize="22" FontWeight="SemiBold"
                               Foreground="{DynamicResource HeaderBrush}"
                               Margin="0,8,0,0" />
                    <TextBlock Text="{Binding LastSyncRelativeDisplay}"
                               FontSize="13"
                               Foreground="{DynamicResource AccentBrush}"
                               Margin="0,2,0,0" />

                    <TextBlock Text="{Binding NextEligibleRunDisplay}"
                               FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,16,0,0"
                               TextWrapping="Wrap" />

                    <!-- Son hata varsa kartın altında uyarı bandı çıkar. -->
                    <Border Background="{DynamicResource WarningLightBrush}"
                            BorderBrush="{DynamicResource WarningBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,8"
                            Margin="0,16,0,0"
                            Visibility="{Binding LastErrorDisplay, Converter={StaticResource StringToVisibilityConverter}}">
                        <TextBlock Text="{Binding LastErrorDisplay}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource WarningBrush}" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- SAĞ: Veri paneli — MikroDB satır sayıları + son çalıştırma özeti.
                 İki alt bölüm üst üste: üstte MikroDB (büyük tablo), altta
                 son çalıştırma (kısa özet). ScrollViewer ile uzun listeyi
                 taşıyabilir; kısa olduğu için normalde scroll gözükmez. -->
            <Border Grid.Column="2"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Üst yarı: MikroDB Satır Sayıları -->
                    <DockPanel Grid.Row="0">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="MikroDB Satır Sayıları"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Margin="0,2,0,6">
                                <Run Text="MikroDB'den canlı satır sayıları. Push 0 dönüyorsa MikroDB gerçekten boş mu, SQL filtresi mi yanlış, ayırt etmek için kullanılır." />
                            </TextBlock>
                            <Button Content="🔢 MikroDB Satır Sayılarını Al"
                                    Command="{Binding CheckMikroRowCountsCommand}"
                                    MinWidth="220"
                                    Margin="0,0,0,8" Padding="8,4"
                                    HorizontalAlignment="Left"
                                    ToolTip="Tüm Mikro tablolarından SELECT COUNT(*) çalıştırır." />
                        </StackPanel>

                        <Border DockPanel.Dock="Bottom"
                                Margin="0,8,0,0"
                                Padding="10,8"
                                BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Background="{DynamicResource StatusBackgroundBrush}"
                                Visibility="{Binding HasMikroCountResult, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding MikroCountTimeDisplay, StringFormat='Son kontrol: {0}'}"
                                       FontSize="10"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding HasMikroCountResult, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="CARI_HESAPLAR" Margin="0,1" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding MikroCustomersCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="STOKLAR" Margin="0,1" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MikroStocksCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="SIPARISLER (açık)" Margin="0,1" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MikroOpenOrdersCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="KASALAR + BANKALAR" Margin="0,1" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding MikroCashAndBankCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" />
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="DEPOLAR + PERSONEL" Margin="0,1" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding MikroLookupsCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" />
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="STOK_SATIS_FIYAT_LISTELERI" Margin="0,1" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding MikroPricesCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" />
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="STOK_HAREKETLERI" Margin="0,1" />
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding MikroInventoryCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" />
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="CARI_HESAP_ADRESLERI" Margin="0,1" />
                                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding MikroCustomerAddressesCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" />
                                <TextBlock Grid.Row="8" Grid.Column="0" Text="CARI_HESAP_YETKILILERI" Margin="0,1" />
                                <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding MikroCustomerContactsCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" />
                                <TextBlock Grid.Row="9" Grid.Column="0" Text="BARKOD_TANIMLARI" Margin="0,1" />
                                <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding MikroBarcodesCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" />
                                <TextBlock Grid.Row="10" Grid.Column="0" Text="SATIS_SARTLARI" Margin="0,1" />
                                <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding MikroSalesConditionsCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" />
                                <TextBlock Grid.Row="11" Grid.Column="0" Text="CARI_HESAP_HAREKETLERI" Margin="0,1" />
                                <TextBlock Grid.Row="11" Grid.Column="1" Text="{Binding MikroCustomerTransactionsCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" />
                                <TextBlock Grid.Row="12" Grid.Column="0" Text="STOK_HAREKETLERI (satırlar)" Margin="0,1" />
                                <TextBlock Grid.Row="12" Grid.Column="1" Text="{Binding MikroStockTransactionsCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" />
                            </Grid>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- Alt yarı: Son Çalıştırma Özeti (özet satır + status rozeti) -->
                    <StackPanel Grid.Row="2">
                        <TextBlock Text="Son Çalıştırma Özeti"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Cariler" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LastCustomersCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Stoklar" Margin="0,2,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LastStocksCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" Margin="0,2,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Fiyatlar" Margin="0,2,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LastPricesCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" Margin="0,2,0,0" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Açık siparişler" Margin="0,2,0,0" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LastOpenOrdersCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" Margin="0,2,0,0" />
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Cari adresleri" Margin="0,2,0,0" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding LastCustomerAddressesCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" Margin="0,2,0,0" />
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Cari yetkilileri" Margin="0,2,0,0" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding LastCustomerContactsCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" Margin="0,2,0,0" />
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Barkodlar" Margin="0,2,0,0" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding LastBarcodesCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" Margin="0,2,0,0" />
                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Satış şartları" Margin="0,2,0,0" />
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding LastSalesConditionsCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" Margin="0,2,0,0" />
                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Cari hareketleri" Margin="0,2,0,0" />
                            <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding LastCustomerTransactionsCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" Margin="0,2,0,0" />
                            <TextBlock Grid.Row="9" Grid.Column="0" Text="Stok hareketleri" Margin="0,2,0,0" />
                            <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding LastStockTransactionsCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" Margin="0,2,0,0" />
                        </Grid>

                        <Border Background="{Binding LastRunStatusBrush}"
                                CornerRadius="10"
                                Padding="8,3"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Left">
                            <TextBlock Text="{Binding LastRunStatusDisplay}"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       FontSize="12" />
                        </Border>
                        <TextBlock Text="{Binding LastRunSummaryDisplay}"
                                   FontSize="11"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
