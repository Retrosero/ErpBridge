@inherits LayoutComponentBase

<PageTitle>ErpBridge Admin</PageTitle>

<div class="page admin-shell">
    <div class="sidebar">
        <div class="top-row navbar navbar-dark">
            <div class="container-fluid admin-brand">
                <a class="navbar-brand" href="">
                    <span class="admin-brand__mark" aria-hidden="true">E</span>
                    <span>ErpBridge <small>ADMIN</small></span>
                </a>
            </div>
        </div>
        <nav class="flex-column" aria-label="Yönetim menüsü">
            <AuthorizeView>
                <Authorized>
                    <div class="nav-item px-3">
                        <span class="admin-user">@context.User.Identity?.Name</span>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Dashboard</NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="tenants">Tenants</NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="licenses">Licenses</NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="apikeys">API Keys</NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="webhooks">Webhooks</NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="agents">Agents</NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="jobs">Jobs</NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="bootstrap">Bootstrap</NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="logout">Logout</NavLink>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="login">Login</NavLink>
                    </div>
                </NotAuthorized>
            </AuthorizeView>
        </nav>
    </div>

    <main>
        <div class="top-row admin-topbar px-4">
            <AuthorizeView>
                <Authorized>
                    <span class="admin-topbar__identity">@context.User.Identity?.Name</span>
                </Authorized>
            </AuthorizeView>
        </div>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>
