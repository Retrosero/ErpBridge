@page "/bootstrap"
@inject ErpBridge.Admin.Api.CentralApiClient Api
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Veri Özeti — ErpBridge Yönetim</PageTitle>

<AdminPageHeader Title="Veri anlık görüntüleri" Description="Müşteri ERP verilerinin son bootstrap alma durumunu inceleyin." />

<div class="admin-filter-bar mb-3 row g-2">
    <div class="col-auto">
        <select class="form-select" @bind="_tenantId">
            <option value="">Müşteri seçin…</option>
            @foreach (var t in _tenants)
            {
                <option value="@t.Id">@t.Name</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button class="btn btn-primary" @onclick="LoadAsync" disabled="@(string.IsNullOrEmpty(_tenantId) || _loading)">@(_loading ? "Yükleniyor…" : "Özeti getir")</button>
    </div>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <AdminState Tone="error" Icon="!" Title="Veri özeti alınamadı" Message="@_error" />
}

@if (_summary is not null)
{
    <div class="admin-insight"><span>Son alınma</span><strong>@(_summary.CapturedAtUtc?.LocalDateTime.ToString("dd MMM yyyy, HH:mm") ?? "Henüz alınmadı")</strong></div>
    <div class="admin-data-surface"><table class="table admin-data-table">
        <thead><tr><th>Veri grubu</th><th>Kayıt sayısı</th></tr></thead>
        <tbody>
            <tr><td data-label="Bölüm">Müşteriler</td><td data-label="Kayıt"><strong>@_summary.CustomersCount</strong></td></tr>
            <tr><td data-label="Bölüm">Stoklar</td><td data-label="Kayıt"><strong>@_summary.StocksCount</strong></td></tr>
            <tr><td data-label="Bölüm">Fiyatlar</td><td data-label="Kayıt"><strong>@_summary.PricesCount</strong></td></tr>
            <tr><td data-label="Bölüm">Envanter</td><td data-label="Kayıt"><strong>@_summary.InventoryCount</strong></td></tr>
            <tr><td data-label="Bölüm">Açık siparişler</td><td data-label="Kayıt"><strong>@_summary.OpenOrdersCount</strong></td></tr>
            <tr><td data-label="Bölüm">Kasa ve banka</td><td data-label="Kayıt"><strong>@_summary.CashAndBankCount</strong></td></tr>
            <tr><td data-label="Bölüm">Tanımlar</td><td data-label="Kayıt"><strong>@_summary.LookupsCount</strong></td></tr>
            <tr><td data-label="Bölüm">Müşteri adresleri</td><td data-label="Kayıt"><strong>@_summary.CustomerAddressesCount</strong></td></tr>
            <tr><td data-label="Bölüm">Müşteri ilişkileri</td><td data-label="Kayıt"><strong>@_summary.CustomerContactsCount</strong></td></tr>
            <tr><td data-label="Bölüm">Barkodlar</td><td data-label="Kayıt"><strong>@_summary.BarcodesCount</strong></td></tr>
            <tr><td data-label="Bölüm">Satış koşulları</td><td data-label="Kayıt"><strong>@_summary.SalesConditionsCount</strong></td></tr>
            <tr><td data-label="Bölüm">Cari hareketleri</td><td data-label="Kayıt"><strong>@_summary.CustomerTransactionsCount</strong></td></tr>
            <tr><td data-label="Bölüm">Stok hareketleri</td><td data-label="Kayıt"><strong>@_summary.StockTransactionsCount</strong></td></tr>
        </tbody>
    </table></div>
}
else if (!_loading && string.IsNullOrWhiteSpace(_error))
{
    <AdminState Title="Bir müşteri seçin" Message="Güncel ERP veri özetini görmek için yukarıdaki alandan müşteri seçin." Icon="↻" />
}

@code {
    private string _tenantId = string.Empty;
    private IReadOnlyList<ErpBridge.Admin.Api.TenantDto> _tenants = Array.Empty<ErpBridge.Admin.Api.TenantDto>();
    private ErpBridge.Admin.Api.BootstrapSummaryDto? _summary;
    private bool _loading;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try { _tenants = await Api.ListTenantsAsync(); }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task LoadAsync()
    {
        _loading = true; _error = null;
        try
        {
            if (Guid.TryParse(_tenantId, out var id))
                _summary = await Api.GetLatestBootstrapAsync(id);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }
}
