@page "/cariler"
@inherits PortalPageBase

<PageTitle>Cariler — Yönetim Paneli</PageTitle>

@if (!Ready)
{
    <PageLoading />
}
else
{
    <PageHeader Title="Cari bakiyeler" Eyebrow="Kayıtlar" Subtitle="Müşteri ve tedarikçi hesaplarının güncel bakiyesi" Busy="Busy">
        <Actions>
            <form class="toolbar-search" @onsubmit="SearchAsync" @onsubmit:preventDefault>
                <MudTextField T="string" @bind-Value="_search" Placeholder="Cari kodu veya unvan" Variant="Variant.Outlined" Margin="Margin.Dense"
                              InputId="balances-search" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Rounded.Search" Clearable="true" />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@Busy">Ara</MudButton>
            </form>
        </Actions>
    </PageHeader>

    @if (Error is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="page-alert" id="page-error">@Error</MudAlert>
    }

    @if (_balances is not null)
    {
        <section class="stat-grid stat-grid--three">
            <StatCard Id="total-receivable" Label="Toplam alacak" Value="@Fmt.Money(_balances.TotalReceivable)" Caption="müşterilerden alınacak"
                      Icon="@Icons.Material.Rounded.CallReceived" Tone="success" />
            <StatCard Id="total-payable" Label="Toplam borç" Value="@Fmt.Money(_balances.TotalPayable)" Caption="tedarikçilere ödenecek"
                      Icon="@Icons.Material.Rounded.CallMade" Tone="danger" />
            <StatCard Label="Net pozisyon" Value="@Fmt.Money(_balances.TotalReceivable - _balances.TotalPayable)" Caption="alacak − borç"
                      Icon="@Icons.Material.Rounded.AccountBalanceWallet" Tone="primary" />
        </section>

        <MudPaper Outlined="true" Class="panel panel--table mt-3">
            @if (_balances.Rows.Count == 0)
            {
                <EmptyState Id="balances-empty" Icon="@Icons.Material.Rounded.AccountBalanceWallet"
                            Title="@(_searched is null ? "Bakiyesi olan cari yok." : "Aramaya uyan cari yok.")" />
            }
            else
            {
                <div class="table-scroll">
                    <MudSimpleTable Hover="true" Dense="true" Elevation="0" Class="data-table" id="balances-table">
                        <thead>
                            <tr>
                                <th>Kod</th>
                                <th>Unvan</th>
                                <th class="num">Bakiye</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _balances.Rows)
                            {
                                <tr data-customer="@row.CustomerCode">
                                    <td class="mono">@row.CustomerCode</td>
                                    <td class="cell-title">@row.Title</td>
                                    <td class="num @(row.Balance < 0 ? "portal-negative" : "portal-positive")">@Fmt.Money(row.Balance)</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </div>
                @if (_balances.Truncated)
                {
                    <div class="table-foot" id="balances-truncated">İlk @_balances.Rows.Count cari gösteriliyor. Belirli bir cari için arama yapın.</div>
                }
            }
        </MudPaper>
        <MudText Typo="Typo.caption" Class="text-muted page-footnote">
            Pozitif bakiye firmanın alacağıdır. Vade bilgisi telefonlara taşınmadığı için yaşlandırma (vadesi geçen tutar) gösterilmez.
        </MudText>
    }
}

@code {
    private string? _search;
    private string? _searched;
    private BalancesResponse? _balances;

    protected override async Task LoadAsync() => _balances = await Api.BalancesAsync(_searched);

    private async Task SearchAsync()
    {
        _searched = string.IsNullOrWhiteSpace(_search) ? null : _search.Trim();
        await RunAsync(LoadAsync);
    }
}
