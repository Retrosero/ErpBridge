@page "/webhooks"
@inject ErpBridge.Admin.Api.CentralApiClient Api
@inject IJSRuntime Js
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Webhooklar — ErpBridge Yönetim</PageTitle>

<AdminPageHeader Title="Webhooklar" Description="İşlem olaylarını müşteri sistemlerine güvenli biçimde iletin." />

@if (_loading)
{
    <AdminLoading Text="Webhooklar yükleniyor…" />
}
else
{
    <div class="card admin-form-card mb-3">
        <div class="card-header">Yeni webhook uç noktası</div>
        <div class="card-body">
            <div class="row g-2">
                <div class="col-auto">
                    <select class="form-select" @bind="_create.TenantIdString">
                        <option value="">Müşteri seçin…</option>
                        @foreach (var t in _tenants)
                        {
                            <option value="@t.Id.ToString()">@t.Name</option>
                        }
                    </select>
                </div>
                <div class="col-auto">
                    <input class="form-control" aria-label="Webhook adı" placeholder="Webhook adı" @bind="_create.Name" />
                </div>
                <div class="col-auto flex-grow-1">
                    <input class="form-control" aria-label="Webhook adresi" placeholder="https://musteri.example/erp-bridge/hook" @bind="_create.Url" />
                </div>
                <div class="col-auto">
                    <button class="btn btn-primary" @onclick="CreateAsync" disabled="@(!CanCreate || _busy)">
                        @(_busy ? "Kaydediliyor…" : "Webhook ekle")
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_lastIssuedSecret))
    {
        <div class="alert alert-success">
            <strong>Şimdi kopyalayın — imzalama anahtarı yalnızca bir kez gösterilir.</strong>
            <div class="mt-2 d-flex align-items-center">
                <code class="me-2 flex-grow-1">@_lastIssuedSecret</code>
                <button class="btn btn-sm btn-outline-secondary" @onclick="CopyAsync">Kopyala</button>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(_error))
    {
        <AdminState Tone="error" Icon="!" Title="İşlem tamamlanamadı" Message="@_error" />
    }

    @foreach (var w in _webhooks)
    {
        <div class="card admin-webhook-card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <strong>@w.Name</strong>
                    <AdminStatusBadge Text="@(w.IsActive ? "Aktif" : "Devre dışı")" Tone="@(w.IsActive ? "success" : "muted")" />
                </div>
                <div>
                    <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => LoadDeliveriesAsync(w.Id)">Teslimatlar</button>
                    <button class="btn btn-sm btn-outline-danger" disabled="@_busy" @onclick="() => DeleteAsync(w.Id)">Sil</button>
                </div>
            </div>
            <div class="card-body">
                <div class="row small">
                    <div class="col-md-6">
                        <div><strong>Adres:</strong> <code>@w.Url</code></div><div><strong>Müşteri:</strong> @(TenantName(w.TenantId))</div><div><strong>İmzalama anahtarı:</strong> <code>@w.SigningSecretPrefix…</code></div>
                    </div>
                    <div class="col-md-6">
                        <div><strong>Olaylar:</strong> @(w.SubscribedEvents.Length == 0 ? "Tümü" : string.Join(", ", w.SubscribedEvents))</div><div><strong>Oluşturulma:</strong> @w.CreatedAtUtc.LocalDateTime.ToString("dd MMM yyyy, HH:mm")</div><div><strong>Son teslim:</strong> @(w.LastDeliveredAtUtc?.LocalDateTime.ToString("dd MMM yyyy, HH:mm") ?? "—")</div>
                    </div>
                </div>

                @if (_deliveriesEndpointId == w.Id)
                {
                    <hr />
                    <h3>Son teslimatlar</h3>
                    @if (_deliveriesLoading)
                    {
                        <AdminLoading Text="Teslimatlar yükleniyor…" />
                    }
                    else if (_deliveries.Count == 0)
                    {
                        <AdminState Title="Henüz teslimat yok" Message="Bu webhook için kaydedilmiş bir gönderim bulunmuyor." />
                    }
                    else
                    {
                        <table class="table table-sm admin-data-table">
                            <thead>
                                <tr>
                                    <th>Olay</th><th>Durum</th><th>Deneme</th><th>Yanıt kodu</th><th>Son hata</th><th>Son deneme</th><th>Sonraki deneme</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in _deliveries)
                                {
                                    <tr>
                                        <td data-label="Olay">@d.EventType</td><td data-label="Durum">@d.Status</td><td data-label="Deneme">@d.AttemptCount</td><td data-label="Yanıt">@(d.LastResponseCode?.ToString() ?? "—")</td><td data-label="Son hata">@(d.LastError ?? "—")</td><td data-label="Son deneme">@(d.LastAttemptAtUtc?.LocalDateTime.ToString("dd MMM, HH:mm") ?? "—")</td><td data-label="Sonraki">@(d.NextRetryAtUtc?.LocalDateTime.ToString("dd MMM, HH:mm") ?? "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                }
            </div>
        </div>
    }
}

@code {
    private bool _loading = true;
    private bool _busy;
    private IReadOnlyList<ErpBridge.Admin.Api.WebhookEndpointDto> _webhooks = Array.Empty<ErpBridge.Admin.Api.WebhookEndpointDto>();
    private IReadOnlyList<ErpBridge.Admin.Api.TenantDto> _tenants = Array.Empty<ErpBridge.Admin.Api.TenantDto>();
    private string? _lastIssuedSecret;
    private string? _error;
    private readonly CreateModel _create = new();

    private Guid? _deliveriesEndpointId;
    private bool _deliveriesLoading;
    private IReadOnlyList<ErpBridge.Admin.Api.WebhookDeliveryDto> _deliveries = Array.Empty<ErpBridge.Admin.Api.WebhookDeliveryDto>();

    private sealed class CreateModel
    {
        public string TenantIdString { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string Url { get; set; } = string.Empty;
        public Guid TenantId => Guid.TryParse(TenantIdString, out var g) ? g : Guid.Empty;
    }

    private bool CanCreate =>
        _create.TenantId != Guid.Empty
        && !string.IsNullOrWhiteSpace(_create.Name)
        && !string.IsNullOrWhiteSpace(_create.Url)
        && Uri.TryCreate(_create.Url, UriKind.Absolute, out var u)
        && (u.Scheme == Uri.UriSchemeHttps || u.Scheme == Uri.UriSchemeHttp);

    private string TenantName(Guid id) => _tenants.FirstOrDefault(t => t.Id == id)?.Name ?? id.ToString().Substring(0, 8);

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _loading = true; _error = null;
        try
        {
            _tenants = await Api.ListTenantsAsync();
            _webhooks = await Api.ListWebhooksAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private async Task CreateAsync()
    {
        _busy = true; _error = null; _lastIssuedSecret = null;
        try
        {
            var created = await Api.CreateWebhookAsync(_create.TenantId, _create.Name.Trim(), _create.Url.Trim());
            _lastIssuedSecret = created.SigningSecret;
            _create.Name = string.Empty;
            _create.Url = string.Empty;
            await ReloadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task DeleteAsync(Guid id)
    {
        _busy = true;
        try
        {
            await Api.DeleteWebhookAsync(id);
            if (_deliveriesEndpointId == id)
            {
                _deliveriesEndpointId = null;
                _deliveries = Array.Empty<ErpBridge.Admin.Api.WebhookDeliveryDto>();
            }
            await ReloadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task LoadDeliveriesAsync(Guid id)
    {
        if (_deliveriesEndpointId == id)
        {
            _deliveriesEndpointId = null;
            return;
        }
        _deliveriesEndpointId = id;
        _deliveriesLoading = true;
        try
        {
            _deliveries = await Api.ListWebhookDeliveriesAsync(id);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _deliveriesLoading = false; }
    }

    private async Task CopyAsync()
    {
        if (string.IsNullOrEmpty(_lastIssuedSecret)) return;
        try
        {
            await Js.InvokeVoidAsync("navigator.clipboard.writeText", _lastIssuedSecret);
        }
        catch
        {
            // Same reasoning as the API key page: clipboard access can be
            // blocked; the value is on screen and the operator can copy it
            // manually.
        }
    }
}
