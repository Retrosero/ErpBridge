@page "/plasiyerler"
@inherits PortalPageBase

<PageTitle>Plasiyerler — Yönetim Paneli</PageTitle>

@if (!Ready)
{
    <PageLoading />
}
else
{
    <PageHeader Title="Plasiyer performansı" Eyebrow="Genel bakış" Subtitle="@($"{Fmt.Day(_from)} – {Fmt.Day(_to)}")" Busy="Busy">
        <Actions>
            <MudDatePicker Label="Başlangıç" Date="@ToDateTime(_from)" DateChanged="ChangeFromAsync" Culture="Fmt.Turkish" DateFormat="dd.MM.yyyy"
                           Editable="true" Variant="Variant.Outlined" Margin="Margin.Dense" InputId="activity-from" Class="page-date" />
            <MudDatePicker Label="Bitiş" Date="@ToDateTime(_to)" DateChanged="ChangeToAsync" Culture="Fmt.Turkish" DateFormat="dd.MM.yyyy"
                           Editable="true" Variant="Variant.Outlined" Margin="Margin.Dense" InputId="activity-to" Class="page-date" />
        </Actions>
    </PageHeader>

    @if (Error is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="page-alert" id="page-error">@Error</MudAlert>
    }

    @if (_activity is not null)
    {
        @if (_activity.Users.Count == 0)
        {
            <EmptyState Id="activity-empty" Icon="@Icons.Material.Rounded.Groups" Title="Bu aralıkta kullanıcı yok." />
        }
        else
        {
            var totalSales = _activity.Users.Sum(u => u.Sales.Amount);
            var active = _activity.Users.Count(u => u.Sales.Count + u.Collections.Count + u.Disbursements.Count + u.Returns.Count + u.VisitsCompleted > 0);

            <section class="stat-grid stat-grid--three">
                <StatCard Label="Toplam satış" Value="@Fmt.Money(totalSales)" Caption="@($"{_activity.Users.Sum(u => u.Sales.Count)} belge")"
                          Icon="@Icons.Material.Rounded.TrendingUp" Tone="primary" />
                <StatCard Label="Toplam tahsilat" Value="@Fmt.Money(_activity.Users.Sum(u => u.Collections.Amount))" Caption="@($"{_activity.Users.Sum(u => u.Collections.Count)} belge")"
                          Icon="@Icons.Material.Rounded.Payments" Tone="success" />
                <StatCard Label="Aktif kullanıcı" Value="@($"{active} / {_activity.Users.Count}")" Caption="aralıkta en az bir işlem yapan"
                          Icon="@Icons.Material.Rounded.Groups" Tone="info" />
            </section>

            <MudGrid Spacing="3" Class="mt-1">
                <MudItem xs="12" lg="4">
                    <MudPaper Outlined="true" Class="panel panel--fill">
                        <div class="panel-head">
                            <div>
                                <MudText Typo="Typo.h6">Satış sıralaması</MudText>
                                <MudText Typo="Typo.body2" Class="text-muted">Toplam satıştaki pay</MudText>
                            </div>
                        </div>
                        <div class="rank-list">
                            @foreach (var (user, index) in _activity.Users.OrderByDescending(u => u.Sales.Amount).Select((u, i) => (u, i)))
                            {
                                var share = totalSales > 0 ? (double)(user.Sales.Amount / totalSales * 100) : 0;
                                <div class="rank-item">
                                    <span class="rank-pos">@(index + 1)</span>
                                    <div class="rank-body">
                                        <div class="rank-line">
                                            <span class="rank-name">@DisplayName(user)</span>
                                            <span class="rank-value">@Fmt.Money(user.Sales.Amount)</span>
                                        </div>
                                        <MudProgressLinear Color="Color.Primary" Rounded="true" Size="Size.Small" Value="@share" />
                                    </div>
                                </div>
                            }
                        </div>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" lg="8">
                    <MudPaper Outlined="true" Class="panel panel--table">
                        <div class="panel-head">
                            <div>
                                <MudText Typo="Typo.h6">Kullanıcı bazında</MudText>
                                <MudText Typo="Typo.body2" Class="text-muted">Tutarlar belgeyi telefondan gönderen kullanıcıya yazılır. Adet: belge sayısı.</MudText>
                            </div>
                        </div>
                        <div class="table-scroll">
                            <MudSimpleTable Hover="true" Dense="true" Elevation="0" Class="data-table" id="activity-table">
                                <thead>
                                    <tr>
                                        <th>Kullanıcı</th>
                                        <th class="num">Satış</th>
                                        <th class="num">Tahsilat</th>
                                        <th class="num">Tediye</th>
                                        <th class="num">İade</th>
                                        <th class="num">Ziyaret</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var user in _activity.Users)
                                    {
                                        <tr data-user="@user.Username">
                                            <td>
                                                <div class="person">
                                                    <MudAvatar Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@Initials(user)</MudAvatar>
                                                    <div>
                                                        <div class="person-name">@DisplayName(user)</div>
                                                        @if (!string.IsNullOrWhiteSpace(user.Role))
                                                        {
                                                            <div class="person-sub">@Fmt.Role(user.Role)</div>
                                                        }
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="num">@Fmt.Money(user.Sales.Amount)<small> · @user.Sales.Count</small></td>
                                            <td class="num">@Fmt.Money(user.Collections.Amount)<small> · @user.Collections.Count</small></td>
                                            <td class="num">@Fmt.Money(user.Disbursements.Amount)<small> · @user.Disbursements.Count</small></td>
                                            <td class="num">@Fmt.Money(user.Returns.Amount)<small> · @user.Returns.Count</small></td>
                                            <td class="num">@user.VisitsCompleted<small> · @user.VisitsSkipped atlandı</small></td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr id="activity-total">
                                        <th>Toplam</th>
                                        <th class="num">@Fmt.Money(totalSales)</th>
                                        <th class="num">@Fmt.Money(_activity.Users.Sum(u => u.Collections.Amount))</th>
                                        <th class="num">@Fmt.Money(_activity.Users.Sum(u => u.Disbursements.Amount))</th>
                                        <th class="num">@Fmt.Money(_activity.Users.Sum(u => u.Returns.Amount))</th>
                                        <th class="num">@_activity.Users.Sum(u => u.VisitsCompleted)</th>
                                    </tr>
                                </tfoot>
                            </MudSimpleTable>
                        </div>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        }
    }
}

@code {
    /// <summary>The server allows at most this many days in one request.</summary>
    private const int MaxDays = 92;

    private DateOnly _from;
    private DateOnly _to;
    private ActivityResponse? _activity;

    protected override void OnInitialized()
    {
        _to = Fmt.Today();
        _from = _to.AddDays(-6);
    }

    protected override async Task LoadAsync()
    {
        if (_to < _from)
        {
            _activity = null;
            Error = PortalMessages.For("INVALID_RANGE");
            return;
        }
        if (_to.DayNumber - _from.DayNumber + 1 > MaxDays)
        {
            _activity = null;
            Error = PortalMessages.For("RANGE_TOO_LONG");
            return;
        }
        _activity = await Api.ActivityAsync(_from, _to);
    }

    private async Task ChangeFromAsync(DateTime? value)
    {
        if (value is not { } date) return;
        _from = DateOnly.FromDateTime(date);
        await RunAsync(LoadAsync);
    }

    private async Task ChangeToAsync(DateTime? value)
    {
        if (value is not { } date) return;
        _to = DateOnly.FromDateTime(date);
        await RunAsync(LoadAsync);
    }

    private static DateTime ToDateTime(DateOnly day) => day.ToDateTime(TimeOnly.MinValue);

    private static string DisplayName(UserActivity user) => string.IsNullOrWhiteSpace(user.FullName) ? user.Username : user.FullName;

    private static string Initials(UserActivity user) => Fmt.Initials(DisplayName(user));
}
