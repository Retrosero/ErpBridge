@inherits LayoutComponentBase

<PageTitle>ErpBridge Yönetim</PageTitle>

<div class="admin-shell @(_menuOpen ? "admin-shell--menu-open" : null)">
    <button class="admin-menu-backdrop" aria-label="Menüyü kapat" @onclick="CloseMenu"></button>
    <aside class="admin-sidebar" aria-label="Ana navigasyon">
        <div class="admin-brand">
            <a href="/" class="admin-brand__link" @onclick="CloseMenu">
                <span class="admin-brand__mark" aria-hidden="true">EB</span>
                <span><strong>ErpBridge</strong><small>YÖNETİM MERKEZİ</small></span>
            </a>
            <button class="admin-icon-button admin-sidebar__close" type="button" aria-label="Menüyü kapat" @onclick="CloseMenu">×</button>
        </div>
        <AuthorizeView>
            <Authorized>
                <nav class="admin-nav">
                    <p class="admin-nav__label">GENEL</p>
                    <NavLink class="admin-nav__link" href="" Match="NavLinkMatch.All" @onclick="CloseMenu"><span aria-hidden="true">⌂</span> Genel bakış</NavLink>
                    <NavLink class="admin-nav__link" href="tenants" @onclick="CloseMenu"><span aria-hidden="true">◇</span> Müşteriler</NavLink>
                    <NavLink class="admin-nav__link" href="licenses" @onclick="CloseMenu"><span aria-hidden="true">✓</span> Lisanslar</NavLink>
                    <p class="admin-nav__label">ERİŞİM</p>
                    <NavLink class="admin-nav__link" href="apikeys" @onclick="CloseMenu"><span aria-hidden="true">⌁</span> API anahtarları</NavLink>
                    <NavLink class="admin-nav__link" href="webhooks" @onclick="CloseMenu"><span aria-hidden="true">↗</span> Webhooklar</NavLink>
                    <p class="admin-nav__label">OPERASYON</p>
                    <NavLink class="admin-nav__link" href="agents" @onclick="CloseMenu"><span aria-hidden="true">◉</span> Ajanlar</NavLink>
                    <NavLink class="admin-nav__link" href="jobs" @onclick="CloseMenu"><span aria-hidden="true">≡</span> İş kuyruğu</NavLink>
                    <NavLink class="admin-nav__link" href="bootstrap" @onclick="CloseMenu"><span aria-hidden="true">↻</span> Veri özeti</NavLink>
                </nav>
                <div class="admin-sidebar__account">
                    <span class="admin-avatar" aria-hidden="true">@Initial(context.User.Identity?.Name)</span>
                    <span class="admin-account-copy"><strong>@(context.User.Identity?.Name ?? "Yönetici")</strong><small>Yönetici hesabı</small></span>
                    <a class="admin-icon-button" href="logout" title="Çıkış yap" aria-label="Çıkış yap">↪</a>
                </div>
            </Authorized>
            <NotAuthorized><nav class="admin-nav"><NavLink class="admin-nav__link" href="login" @onclick="CloseMenu">Giriş yap</NavLink></nav></NotAuthorized>
        </AuthorizeView>
    </aside>
    <div class="admin-main">
        <header class="admin-topbar">
            <button class="admin-icon-button admin-menu-button" type="button" aria-label="Menüyü aç" aria-expanded="@_menuOpen" @onclick="ToggleMenu">☰</button>
            <div class="admin-topbar__title"><span class="admin-brand__mark" aria-hidden="true">EB</span><strong>ErpBridge</strong></div>
            <AuthorizeView><Authorized><span class="admin-topbar__status"><i aria-hidden="true"></i> Sistem bağlı</span></Authorized></AuthorizeView>
        </header>
        <main id="main-content" class="admin-content" tabindex="-1">@Body</main>
    </div>
</div>

@code {
    private bool _menuOpen;
    private void ToggleMenu() => _menuOpen = !_menuOpen;
    private void CloseMenu() => _menuOpen = false;
    private static string Initial(string? value) => string.IsNullOrWhiteSpace(value) ? "Y" : value.Trim()[0].ToString().ToUpperInvariant();
}
