<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ErpBridge.Erp.Mikro</RootNamespace>
    <AssemblyName>ErpBridge.Erp.Mikro</AssemblyName>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!--
    Dependencies for ErpBridge.Erp.Mikro:
      - ErpBridge.Shared                    (DTOs / Result<T> / utilities)
      - ErpBridge.Erp.Abstractions          (IErpAdapter / IMappingStore / payloads)
      - ErpBridge.Core                      (AgentConfig + IAgentConfigToErpSettingsMapper
                                             — added in Faz 2 Track 1 so the Mikro mapper
                                             can implement the Core-defined contract)
      - Microsoft.Data.SqlClient            (real SQL only ships in Phase 3+)
      - Microsoft.Extensions.DependencyInjection.Abstractions

    MUST NOT reference:
      - ErpBridge.LocalStore
      - ErpBridge.RemoteApi
      - ErpBridge.Agent.Service
      - ErpBridge.Agent.UI
  -->
  <ItemGroup>
    <ProjectReference Include="..\ErpBridge.Shared\ErpBridge.Shared.csproj" />
    <ProjectReference Include="..\ErpBridge.Erp.Abstractions\ErpBridge.Erp.Abstractions.csproj" />
    <ProjectReference Include="..\ErpBridge.Core\ErpBridge.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Faz 10: Microsoft.Data.SqlClient 7.0.2 transitively pulls in
         System.Security.Cryptography.ProtectedData 9.0.13, but the CPM
         pin in Directory.Packages.props is 8.0.0. The newer package wins
         via CentralPackageTransitivePinningEnabled, but a direct
         reference makes the dependency explicit and removes the
         restore-time ambiguity. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

</Project>
