@page "/licenses"
@inject ErpBridge.Admin.Api.CentralApiClient Api
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using ErpBridge.Admin.Api

<PageTitle>Lisanslar — ErpBridge Admin</PageTitle>

<section class="license-page" aria-labelledby="licenses-title">
    <header class="license-page__header">
        <div>
            <p class="license-page__eyebrow">ERPBIDGE ADMIN</p>
            <h1 id="licenses-title">Lisanslar</h1>
            <p class="license-page__subtitle">ErpBridge ve Go (pazaryeri) lisanslarını oluşturun, sürelerini yönetin ve erişim durumlarını izleyin.</p>
        </div>
        <button class="btn license-refresh" @onclick="ReloadAsync" disabled="@_loading" aria-label="Lisans listesini yenile"><span aria-hidden="true">↻</span> Yenile</button>
    </header>

    @if (_loading)
    {
        <div class="license-loading" role="status"><span class="license-loading__spinner" aria-hidden="true"></span>Lisanslar hazırlanıyor…</div>
    }
    else
    {
        <div class="license-summary" aria-label="Lisans özeti">
            <div class="license-stat"><span>Toplam lisans</span><strong>@_licenses.Count</strong></div>
            <div class="license-stat license-stat--active"><span>Aktif</span><strong>@_licenses.Count(l => l.IsActive)</strong></div>
            <div class="license-stat license-stat--inactive"><span>Pasif</span><strong>@_licenses.Count(l => !l.IsActive)</strong></div>
        </div>

        <section class="license-issue" aria-labelledby="issue-license-title">
            <div class="license-issue__heading"><span class="license-issue__icon" aria-hidden="true">+</span><div><h2 id="issue-license-title">Yeni lisans oluştur</h2><p>Ürünü ve müşteriyi seçin; isterseniz lisans için bitiş tarihi belirleyin. Go anahtarı tek bilgisayarda etkinleşir.</p></div></div>
            <div class="license-issue__form license-issue__form--product">
                <label><span>Ürün</span><select class="form-select" @bind="_create.Product" aria-label="Ürün seçin"><option value="@LicenseProductNames.ErpBridge">ErpBridge</option><option value="@LicenseProductNames.Go">Go (pazaryeri)</option></select></label>
                <label><span>Müşteri</span><select class="form-select" @bind="_create.TenantIdString" aria-label="Müşteri seçin"><option value="">Müşteri seçin…</option>@foreach (var t in _tenants) { <option value="@t.Id.ToString()">@t.Name</option> }</select></label>
                <label><span>Bitiş tarihi <em>(isteğe bağlı)</em></span><input class="form-control" type="datetime-local" @bind="_create.ExpiresAtLocal" /></label>
                <button class="btn btn-primary license-issue__button" @onclick="CreateAsync" disabled="@(string.IsNullOrEmpty(_create.TenantIdString) || _busy)">@(_busy ? "Oluşturuluyor…" : "Lisans oluştur")</button>
            </div>
        </section>

        @if (!string.IsNullOrEmpty(_lastIssuedKey))
        {
            <div class="license-notice license-notice--success" role="status"><span class="license-notice__icon" aria-hidden="true">✓</span><div><strong>Lisans başarıyla oluşturuldu</strong><p>Bu anahtar yalnızca şimdi tam olarak görüntülenir.</p><code>@_lastIssuedKey</code></div></div>
        }
        @if (!string.IsNullOrEmpty(_info)) { <div class="license-notice license-notice--success" role="status"><span class="license-notice__icon" aria-hidden="true">✓</span><div><strong>@_info</strong></div></div> }
        @if (!string.IsNullOrEmpty(_error)) { <div class="license-notice license-notice--error" role="alert">@_error</div> }

        <section class="license-list" aria-labelledby="license-list-title">
            <div class="license-list__heading">
                <div><h2 id="license-list-title">Tüm lisanslar</h2><p>@Visible.Count() kayıt</p></div>
                <label class="license-filter"><span>Ürün</span><select class="form-select" @bind="_productFilter" aria-label="Ürüne göre süz"><option value="">Tümü</option><option value="@LicenseProductNames.ErpBridge">ErpBridge</option><option value="@LicenseProductNames.Go">Go (pazaryeri)</option></select></label>
            </div>
            @if (!Visible.Any())
            {
                <div class="license-empty"><span aria-hidden="true">⌁</span><h3>Henüz lisans yok</h3><p>İlk lisansı yukarıdaki formdan oluşturabilirsiniz.</p></div>
            }
            else
            {
                <div class="license-cards">
                    @foreach (var l in Visible)
                    {
                        var isGo = l.Product == LicenseProductNames.Go;
                        <article class="license-card">
                            <div class="license-card__topline">
                                <span class="license-status @(l.IsActive ? "license-status--active" : "license-status--inactive")"><span aria-hidden="true">●</span>@(l.IsActive ? "Aktif" : "Pasif")</span>
                                <span class="license-product @(isGo ? "license-product--go" : "")">@LicenseProductNames.Label(l.Product)</span>
                                <span class="license-card__tenant">@(TenantName(l.TenantId))</span>
                            </div>
                            <code class="license-card__key">@l.LicenseKey</code>
                            <dl class="license-card__details"><div><dt>Oluşturulma</dt><dd>@l.IssuedAtUtc.LocalDateTime.ToString("dd MMM yyyy, HH:mm")</dd></div><div><dt>Bitiş</dt><dd>@(l.ExpiresAtUtc?.LocalDateTime.ToString("dd MMM yyyy, HH:mm") ?? "Süresiz")</dd></div></dl>
                            @if (isGo)
                            {
                                <div class="license-device">
                                    @if (l.GoInstallation is { } device)
                                    {
                                        <p><strong>Bilgisayar:</strong> @(device.MachineName ?? "adı bilinmiyor") @(device.AppVersion is { } v ? $"· sürüm {v}" : "")</p>
                                        <p class="license-device__meta">Etkinleştirme @device.ActivatedAtUtc.LocalDateTime.ToString("dd MMM yyyy, HH:mm") · son görülme @device.LastSeenAtUtc.LocalDateTime.ToString("dd MMM yyyy, HH:mm")</p>
                                    }
                                    else
                                    {
                                        <p class="license-device__meta">Henüz bir bilgisayarda etkinleştirilmedi.</p>
                                    }
                                </div>
                            }
                            <div class="license-card__actions">
                                @if (!isGo)
                                {
                                    <button class="btn btn-outline-primary license-mobile-toggle" @onclick="() => ToggleMobileLogin(l.Id)" aria-expanded="@(_mobileLoginFor == l.Id)">@(_mobileLoginFor == l.Id ? "Telefon girişini kapat" : "Telefon girişi oluştur")</button>
                                }
                                @if (l.IsActive)
                                {
                                    <button class="btn btn-outline-secondary" @onclick="() => ToggleExpiry(l)" aria-expanded="@(_expiryFor == l.Id)">Süreyi değiştir</button>
                                }
                                @if (isGo && l.GoInstallation is not null)
                                {
                                    <button class="btn btn-outline-secondary" @onclick="() => ReleaseAsync(l.Id)" disabled="@_busy" title="Anahtar başka bir bilgisayarda etkinleştirilebilir hale gelir">Bilgisayarı serbest bırak</button>
                                }
                                @if (l.IsActive) { <button class="btn license-revoke" @onclick="() => RevokeAsync(l.Id)" disabled="@_busy">Lisansı iptal et</button> }
                            </div>
                            @if (_expiryFor == l.Id)
                            {
                                <div class="license-expiry">
                                    <label><span>Yeni bitiş tarihi <em>(boş = süresiz)</em></span><input class="form-control" type="datetime-local" @bind="_expiryLocal" /></label>
                                    <button class="btn btn-primary" @onclick="() => SaveExpiryAsync(l.Id)" disabled="@_busy">Kaydet</button>
                                </div>
                            }
                            @if (_mobileLoginFor == l.Id)
                            {
                                <ErpBridge.Admin.Shared.MobileLoginPanel TenantId="l.TenantId" />
                            }
                        </article>
                    }
                </div>
            }
        </section>
    }
</section>

@code {
    private bool _loading = true;
    private bool _busy;
    private IReadOnlyList<LicenseDto> _licenses = Array.Empty<LicenseDto>();
    private IReadOnlyList<TenantDto> _tenants = Array.Empty<TenantDto>();
    private string? _lastIssuedKey;
    private string? _info;
    private string? _error;
    private string _productFilter = string.Empty;
    private readonly CreateModel _create = new();
    private sealed class CreateModel { public string Product { get; set; } = LicenseProductNames.ErpBridge; public string TenantIdString { get; set; } = string.Empty; public DateTime? ExpiresAtLocal { get; set; } public Guid TenantId => Guid.TryParse(TenantIdString, out var g) ? g : Guid.Empty; }
    // One license at a time shows the phone-login panel; each panel loads its tenant on demand.
    private Guid? _mobileLoginFor;
    private Guid? _expiryFor;
    private DateTime? _expiryLocal;
    private IEnumerable<LicenseDto> Visible => string.IsNullOrEmpty(_productFilter) ? _licenses : _licenses.Where(l => l.Product == _productFilter);
    private void ToggleMobileLogin(Guid licenseId) => _mobileLoginFor = _mobileLoginFor == licenseId ? null : licenseId;
    private void ToggleExpiry(LicenseDto l) { _expiryFor = _expiryFor == l.Id ? null : l.Id; _expiryLocal = l.ExpiresAtUtc?.LocalDateTime; }
    private string TenantName(Guid id) => _tenants.FirstOrDefault(t => t.Id == id)?.Name ?? id.ToString().Substring(0, 8);
    private static DateTimeOffset? ToOffset(DateTime? local) => local is { } d ? new DateTimeOffset(DateTime.SpecifyKind(d, DateTimeKind.Local)) : null;
    protected override async Task OnInitializedAsync() => await ReloadAsync();
    private async Task ReloadAsync() { _loading = true; _error = null; try { _tenants = await Api.ListTenantsAsync(); _licenses = await Api.ListLicensesAsync(); } catch (Exception ex) { _error = ex.Message; } finally { _loading = false; } }
    private async Task CreateAsync() { _busy = true; _error = null; _info = null; try { var lic = await Api.CreateLicenseAsync(_create.TenantId, ToOffset(_create.ExpiresAtLocal), _create.Product); _lastIssuedKey = lic.LicenseKey; await ReloadAsync(); } catch (Exception ex) { _error = ex.Message; } finally { _busy = false; } }
    private async Task RevokeAsync(Guid id) { _busy = true; _info = null; try { await Api.RevokeLicenseAsync(id); await ReloadAsync(); } catch (Exception ex) { _error = ex.Message; } finally { _busy = false; } }
    private async Task SaveExpiryAsync(Guid id) { _busy = true; _error = null; _info = null; try { await Api.UpdateLicenseExpiryAsync(id, ToOffset(_expiryLocal)); _expiryFor = null; _info = "Bitiş tarihi güncellendi. Go uygulaması yeni tarihi bir sonraki yenilemede alır."; await ReloadAsync(); } catch (Exception ex) { _error = ex.Message; } finally { _busy = false; } }
    private async Task ReleaseAsync(Guid id) { _busy = true; _error = null; _info = null; try { await Api.ReleaseGoInstallationAsync(id); _info = "Bilgisayar serbest bırakıldı. Anahtarı yeni bilgisayarda hemen etkinleştirin; eski bilgisayar açıksa ve önce yenilerse anahtarı yeniden alır."; await ReloadAsync(); } catch (Exception ex) { _error = ex.Message; } finally { _busy = false; } }
}
