{
  "AgentService": {
    "ServiceName": "ErpBridge Agent"
  },
  "Agent": {
    "LicenseKey": "",
    "TenantId": "",
    "AgentId": "",
    "ErpType": "Mikro",
    "SqlServer": "",
    "SqlUserName": "",
    "SqlPassword": "",
    "MikroDatabaseName": "",
    "CompanyNo": 1,
    "BranchNo": 1,
    "ApiBaseUrl": "https://api.erpbridge.local",
    "Jwt": ""
  },
  "Mikro": {
    "Server": "",
    "UserId": "",
    "Password": "",
    "DatabaseName": ""
  },
  "CentralApi": {
    "BaseUrl": "https://api.erpbridge.local",
    "TimeoutSeconds": 30,
    "Retry": {
      "MaxAttempts": 4,
      "InitialDelaySeconds": 5
    },
    "Jwt": ""
  },
  "LocalStore": {
    "ConnectionString": "Data Source=%LOCALAPPDATA%\\ErpBridge\\agent.db"
  },
  "Logging": {
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/agent-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  }
}
