@page "/apikeys"
@inject ErpBridge.Admin.Api.CentralApiClient Api
@inject IJSRuntime Js
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>API Anahtarları — ErpBridge Yönetim</PageTitle>

<AdminPageHeader Title="API anahtarları" Description="Müşteri servislerinin ErpBridge API’sine güvenli erişimini yönetin." />

@if (_loading)
{
    <AdminLoading Text="API anahtarları yükleniyor…" />
}
else
{
    <div class="card admin-form-card mb-3">
        <div class="card-header">Yeni API anahtarı</div>
        <div class="card-body">
            <div class="row g-2">
                <div class="col-auto">
                    <select class="form-select" @bind="_create.TenantIdString">
                        <option value="">Müşteri seçin…</option>
                        @foreach (var t in _tenants)
                        {
                            <option value="@t.Id.ToString()">@t.Name</option>
                        }
                    </select>
                </div>
                <div class="col-auto">
                    <input class="form-control" aria-label="Anahtar adı" placeholder="Anahtar adı" @bind="_create.Name" />
                </div>
                <div class="col-auto">
                    <select class="form-select" @bind="_create.Scope">
                        <option value="ingest:write">Sunucu yazma (ingest:write)</option>
                        <option value="mobile:read">Android veri okuma (mobile:read)</option>
                    </select>
                </div>
                <div class="col-auto">
                    <button class="btn btn-primary" @onclick="CreateAsync" disabled="@(string.IsNullOrEmpty(_create.TenantIdString) || string.IsNullOrWhiteSpace(_create.Name) || _busy)">
                        @(_busy ? "Oluşturuluyor…" : "Anahtar oluştur")
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_notice))
    {
        <div class="alert alert-success">
            <strong>@_notice</strong>
        </div>
    }

    @if (!string.IsNullOrEmpty(_error))
    {
        <AdminState Tone="error" Icon="!" Title="İşlem tamamlanamadı" Message="@_error" />
    }

    <div class="admin-data-surface"><table class="table admin-data-table">
        <thead>
            <tr>
                <th>Anahtar</th><th>Ad</th><th>Müşteri</th><th>Yetki</th><th>Oluşturulma</th><th>Son kullanım</th><th>Durum</th><th>İşlem</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var k in _keys)
            {
                <tr>
                    <td data-label="Anahtar"><code>@k.KeyPrefix••••••••</code></td>
                    <td data-label="Ad"><strong>@k.Name</strong></td>
                    <td data-label="Müşteri">@(TenantName(k.TenantId))</td>
                    <td data-label="Yetki">@string.Join(", ", k.Scopes)</td>
                    <td data-label="Oluşturulma">@k.CreatedAtUtc.LocalDateTime.ToString("dd MMM yyyy")</td>
                    <td data-label="Son kullanım">@(k.LastUsedAtUtc?.LocalDateTime.ToString("dd MMM yyyy") ?? "—")</td>
                    <td data-label="Durum"><AdminStatusBadge Text="@(k.IsActive ? "Aktif" : "Pasif")" Tone="@(k.IsActive ? "success" : "muted")" /></td>
                    <td data-label="İşlem" class="admin-data-table__action">
                        @if (k.IsActive)
                        {
                            <button class="btn btn-sm btn-outline-secondary me-1" disabled="@_busy" title="@(k.SecretAvailable ? "Maskeli anahtarı panoya kopyala" : "Bu eski anahtarı geri almak için önce yenilemeniz gerekir")" @onclick="() => CopyStoredAsync(k.Id)">Kopyala</button>
                            <button class="btn btn-sm btn-warning me-1" disabled="@_busy" @onclick="() => RevokeAsync(k.Id)">İptal et</button>
                            <button class="btn btn-sm btn-outline-primary" disabled="@_busy" @onclick="() => RotateAsync(k.Id)">Yenile</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table></div>
}

@code {
    private bool _loading = true;
    private bool _busy;
    private IReadOnlyList<ErpBridge.Admin.Api.ApiKeyDto> _keys = Array.Empty<ErpBridge.Admin.Api.ApiKeyDto>();
    private IReadOnlyList<ErpBridge.Admin.Api.TenantDto> _tenants = Array.Empty<ErpBridge.Admin.Api.TenantDto>();
    private string? _notice;
    private string? _error;
    private readonly CreateModel _create = new();

    private sealed class CreateModel
    {
        public string TenantIdString { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string Scope { get; set; } = "ingest:write";
        public Guid TenantId => Guid.TryParse(TenantIdString, out var g) ? g : Guid.Empty;
    }

    private string TenantName(Guid id) => _tenants.FirstOrDefault(t => t.Id == id)?.Name ?? id.ToString().Substring(0, 8);

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _loading = true; _error = null;
        try
        {
            _tenants = await Api.ListTenantsAsync();
            _keys = await Api.ListApiKeysAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private async Task CreateAsync()
    {
        _busy = true; _error = null; _notice = null;
        try
        {
            var created = await Api.CreateApiKeyAsync(_create.TenantId, _create.Name.Trim(), new[] { _create.Scope });
            await CopyToClipboardAsync(created.RawKey);
            _notice = "Anahtar oluşturuldu ve panoya kopyalandı. Anahtar ekranda gösterilmez.";
            await ReloadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task RevokeAsync(Guid id)
    {
        _busy = true;
        try
        {
            await Api.RevokeApiKeyAsync(id);
            await ReloadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task RotateAsync(Guid id)
    {
        _busy = true; _notice = null;
        try
        {
            var rotated = await Api.RotateApiKeyAsync(id);
            await CopyToClipboardAsync(rotated.RawKey);
            _notice = "Anahtar yenilendi ve panoya kopyalandı. Eski anahtar artık geçersizdir.";
            await ReloadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task CopyStoredAsync(Guid id)
    {
        _busy = true; _error = null; _notice = null;
        try { var secret = await Api.CopyApiKeyAsync(id); await CopyToClipboardAsync(secret.RawKey); _notice = "Anahtar güvenli biçimde panoya kopyalandı. Bu erişim kayda alındı."; }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task CopyToClipboardAsync(string rawKey)
    {
        try { await Js.InvokeVoidAsync("navigator.clipboard.writeText", rawKey); }
        catch { throw new InvalidOperationException("Tarayıcı pano erişimine izin vermedi. Anahtar güvenlik nedeniyle ekranda gösterilmez."); }
    }
}
