@page "/hareketler"
@inherits PortalPageBase

<PageTitle>Hareketler — Yönetim Paneli</PageTitle>

@if (!Ready)
{
    <PageLoading />
}
else
{
    <PageHeader Title="Hareketler" Eyebrow="Kayıtlar" Subtitle="Şirket genelinde bütün cari hareketleri" Busy="Busy" />

    @if (Error is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="page-alert" id="page-error">@Error</MudAlert>
    }

    <form class="ledger-toolbar" id="movements-filter" @onsubmit="SearchAsync" @onsubmit:preventDefault>
        <label class="inline-field">
            Başlangıç
            <input type="date" class="portal-input portal-input--date" id="movements-from" value="@Fmt.IsoDay(_from)" disabled="@Busy"
                   @onchange="e => { if (Fmt.TryIsoDay(e.Value?.ToString(), out var d)) _from = d; }" />
        </label>
        <label class="inline-field">
            Bitiş
            <input type="date" class="portal-input portal-input--date" id="movements-to" value="@Fmt.IsoDay(_to)" disabled="@Busy"
                   @onchange="e => { if (Fmt.TryIsoDay(e.Value?.ToString(), out var d)) _to = d; }" />
        </label>
        <label class="inline-field">
            Tür
            <select class="portal-select portal-select--short" id="movements-kind" value="@_kind" disabled="@Busy" @onchange="e => _kind = e.Value?.ToString() ?? string.Empty">
                <option value="">Tümü</option>
                @foreach (var (kind, label) in Kinds)
                {
                    <option value="@kind">@label</option>
                }
            </select>
        </label>
        <label class="inline-field">
            Cari
            <input class="portal-input" id="movements-customer" placeholder="Kod" value="@_customer" disabled="@Busy" @onchange="e => _customer = e.Value?.ToString() ?? string.Empty" />
        </label>
        @if (_users.Length > 0)
        {
            <label class="inline-field">
                Kullanıcı
                <select class="portal-select portal-select--short" id="movements-user" value="@(_userId?.ToString() ?? string.Empty)" disabled="@Busy"
                        @onchange="e => _userId = Guid.TryParse(e.Value?.ToString(), out var id) ? id : null">
                    <option value="">Tümü</option>
                    @foreach (var user in _users)
                    {
                        <option value="@user.Id">@(string.IsNullOrWhiteSpace(user.FullName) ? user.Username : user.FullName)</option>
                    }
                </select>
            </label>
        }
        <label class="inline-field">
            Tutar
            <input type="number" class="portal-input portal-input--number" id="movements-min" placeholder="en az" min="0" step="any" value="@_min" disabled="@Busy" @onchange="e => _min = Blank(e.Value?.ToString())" />
            –
            <input type="number" class="portal-input portal-input--number" id="movements-max" placeholder="en çok" min="0" step="any" value="@_max" disabled="@Busy" @onchange="e => _max = Blank(e.Value?.ToString())" />
        </label>
        <label class="inline-field">
            <input type="checkbox" id="movements-voided" checked="@_includeVoided" disabled="@Busy" @onchange="e => _includeVoided = e.Value is true" />
            İptal edilenler
        </label>
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Disabled="@Busy" id="movements-search">Süz</MudButton>
    </form>

    @if (_result is not null)
    {
        <section class="stat-grid stat-grid--four">
            <StatCard Id="movements-debit" Label="Borç" Value="@Fmt.Money(_result.TotalDebit)" Icon="@Icons.Material.Rounded.CallReceived" Tone="warning" />
            <StatCard Id="movements-credit" Label="Alacak" Value="@Fmt.Money(_result.TotalCredit)" Icon="@Icons.Material.Rounded.CallMade" Tone="success" />
            <StatCard Id="movements-net" Label="Net" Value="@Fmt.Money(_result.TotalDebit - _result.TotalCredit)" Icon="@Icons.Material.Rounded.AccountBalanceWallet" Tone="primary" />
            <StatCard Id="movements-count" Label="Hareket" Value="@_result.Total.ToString()" Icon="@Icons.Material.Rounded.ReceiptLong" Tone="violet" />
        </section>

        @if (_result.Items.Count == 0)
        {
            <EmptyState Id="movements-empty" Icon="@Icons.Material.Rounded.ReceiptLong" Title="Bu süzgeçle hareket yok." Hint="Tarih aralığını genişletin ya da süzgeci kaldırın." />
        }
        else
        {
            <MudPaper Outlined="true" Class="panel panel--table">
                <div class="table-scroll">
                    <table class="data-table data-table--plain" id="movements-table">
                        <thead>
                            <tr>
                                <th>Tarih</th><th>Cari</th><th>Tür</th><th>Belge no</th><th>Açıklama</th><th>Kullanıcı</th>
                                <th class="num">Borç</th><th class="num">Alacak</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _result.Items)
                            {
                                <tr data-movement="@row.Id" class="row-clickable @(row.Voided ? "is-voided" : null)" @onclick="() => Open(row)"
                                    title="@(row.DocumentKey is not null && Session.CanEditNativeData ? "Evrakı aç" : "Cari ekstresini aç")">
                                    <td class="nowrap">@DayText(row.Date)</td>
                                    <td>
                                        <div class="cell-title">@row.CustomerTitle</div>
                                        <div class="cell-sub">@row.CustomerCode</div>
                                    </td>
                                    <td>
                                        <span class="badge badge--@KindTone(row.Kind)">@KindLabel(row)</span>
                                        @if (row.Voided)
                                        {
                                            <div class="cell-sub">İptal: @row.Reason</div>
                                        }
                                    </td>
                                    <td class="mono">@(row.DocumentNo ?? "—")</td>
                                    <td class="wrap">@(row.Description ?? row.PaymentType)</td>
                                    <td>@(row.UserName ?? "—")</td>
                                    <td class="num">@(row.Debit == 0 ? null : Fmt.Money(row.Debit))</td>
                                    <td class="num">@(row.Credit == 0 ? null : Fmt.Money(row.Credit))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <Pager Id="movements-pager" Page="_page" PageSize="_pageSize" Total="_result.Total" Busy="Busy" Unit="hareket"
                       PageChanged="GoToAsync" PageSizeChanged="PageSizeAsync" />
            </MudPaper>
        }
    }
}

@code {
    protected override PortalArea Requires => PortalArea.Ledger;

    private static readonly (string Kind, string Label)[] Kinds =
    [
        ("sale", "Satış"), ("sale_return", "Satış iadesi"), ("purchase", "Alış"), ("purchase_return", "Alış iadesi"),
        ("collection", "Tahsilat"), ("payment", "Tediye"), ("other", "Diğer (düzeltme, iptal…)"),
    ];

    private DateOnly _from = new(Fmt.Today().Year, Fmt.Today().Month, 1);
    private DateOnly _to = Fmt.Today();
    private string _kind = string.Empty;
    private string _customer = string.Empty;
    private Guid? _userId;
    private string? _min;
    private string? _max;
    private bool _includeVoided;
    private int _page = 1;
    private int _pageSize = 50;
    private CompanyMovementsResponse? _result;
    private UserDto[] _users = [];

    protected override async Task LoadAsync()
    {
        // The user list is an admin-only call; others read the movements without that filter.
        if (Session.IsAdmin && _users.Length == 0) _users = (await Api.UsersAsync()).Users;
        var kinds = string.IsNullOrEmpty(_kind) ? [] : new[] { _kind };
        _result = await Api.CompanyMovementsAsync(_from, _to, kinds, Blank(_customer), _userId, Amount(_min), Amount(_max), _includeVoided, _page, _pageSize);
    }

    private Task SearchAsync()
    {
        _page = 1;
        return RunAsync(LoadAsync);
    }

    private Task GoToAsync(int page)
    {
        _page = page;
        return RunAsync(LoadAsync);
    }

    private Task PageSizeAsync(int size)
    {
        _pageSize = size;
        _page = 1;
        return RunAsync(LoadAsync);
    }

    /// <summary>An invoice opens in Evraklar (ERP-less company: edit/cancel/print there); anything else in the customer's statement.</summary>
    private void Open(CompanyMovementDto row) =>
        Nav.NavigateTo(row.DocumentKey is not null && Session.CanEditNativeData
            ? "evraklar?belge=" + Uri.EscapeDataString(row.DocumentKey)
            : "cari?kod=" + Uri.EscapeDataString(row.CustomerCode));

    private static string KindLabel(CompanyMovementDto row) =>
        row.Kind == "other" && !string.IsNullOrWhiteSpace(row.SourceType) ? row.SourceType! : Kinds.FirstOrDefault(k => k.Kind == row.Kind).Label ?? row.Kind;

    private static string KindTone(string kind) => kind switch
    {
        "sale" => "primary",
        "collection" => "success",
        "sale_return" or "purchase_return" => "danger",
        "payment" or "purchase" => "warning",
        _ => "muted",
    };

    private static string DayText(string iso) => Fmt.TryIsoDay(iso, out var day) ? day.ToString("dd.MM.yyyy", Fmt.Turkish) : iso;

    private static string? Blank(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static decimal? Amount(string? value) =>
        decimal.TryParse(value?.Replace(',', '.'), System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var n) ? n : null;
}
