<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Log Merkezi (L2): log shipping shared by the web hosts. The CentralApi stores its own log lines in the
    database; the Portal and the Admin console ship theirs to the CentralApi. Framework-only (no packages),
    so referencing it adds nothing to the hosts' dependency graphs.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ErpBridge.Diagnostics</RootNamespace>
    <AssemblyName>ErpBridge.Diagnostics</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
