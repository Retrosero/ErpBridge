@inherits LayoutComponentBase
@implements IDisposable
@inject PortalSession Session
@inject ISessionPersistence Persistence
@inject NavigationManager Nav

<MudThemeProvider Theme="PortalTheme.Theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@if (Session.IsSignedIn)
{
    <MudLayout Class="portal-shell">
        <MudAppBar Elevation="0" Class="portal-appbar" Gutters="true">
            <MudIconButton Icon="@Icons.Material.Rounded.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" aria-label="Menüyü aç veya kapat" />
            <div class="portal-appbar-title">
                <span class="portal-appbar-tenant">@Session.TenantName</span>
                <span class="portal-appbar-code">Firma kodu @Session.TenantCode</span>
            </div>
            <MudSpacer />
            <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true" aria-label="Hesap menüsü">
                <ActivatorContent>
                    <div class="portal-user">
                        <MudAvatar Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">@Initials</MudAvatar>
                        <div class="portal-user-text">
                            <span class="portal-user-name">@Session.FullName</span>
                            <span class="portal-user-role" id="user-roles">@Fmt.Roles(Session.Roles)</span>
                        </div>
                        <MudIcon Icon="@Icons.Material.Rounded.ExpandMore" Size="Size.Small" />
                    </div>
                </ActivatorContent>
                <ChildContent>
                    <MudMenuItem Icon="@Icons.Material.Rounded.Logout" OnClick="SignOutAsync" id="logout">Çıkış yap</MudMenuItem>
                </ChildContent>
            </MudMenu>
        </MudAppBar>

        <MudDrawer @bind-Open="_drawerOpen" Elevation="0" Variant="DrawerVariant.Responsive" ClipMode="DrawerClipMode.Never" Class="portal-drawer">
            <div class="portal-brand">
                <div class="portal-brand-mark">
                    <MudIcon Icon="@Icons.Material.Rounded.Insights" />
                </div>
                <div>
                    <div class="portal-brand-name">Sipariş Cepte</div>
                    <div class="portal-brand-sub">Yönetim Paneli</div>
                </div>
            </div>

            <nav id="portal-nav">
                @if (Session.Allows(PortalArea.Reports))
                {
                    <div class="portal-nav-label">Genel bakış</div>
                    <MudNavMenu Class="portal-nav" Rounded="true" Margin="Margin.Dense">
                        <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Rounded.SpaceDashboard">Özet</MudNavLink>
                        <MudNavLink Href="plasiyerler" Icon="@Icons.Material.Rounded.Leaderboard">Plasiyerler</MudNavLink>
                        <MudNavLink Href="ziyaretler" Icon="@Icons.Material.Rounded.Route">Ziyaretler</MudNavLink>
                        <MudNavLink Href="depo-performans" Icon="@Icons.Material.Rounded.Speed">Depo performansı</MudNavLink>
                    </MudNavMenu>
                }

                @if (Session.Allows(PortalArea.Ledger))
                {
                    <div class="portal-nav-label">Kayıtlar</div>
                    <MudNavMenu Class="portal-nav" Rounded="true" Margin="Margin.Dense">
                        <MudNavLink Href="cariler" Icon="@Icons.Material.Rounded.AccountBalanceWallet">Cariler</MudNavLink>
                        <MudNavLink Href="stok" Icon="@Icons.Material.Rounded.Inventory2">Stok</MudNavLink>
                    </MudNavMenu>
                }

                @if (Session.Allows(PortalArea.Approvals) || Session.Allows(PortalArea.Warehouse) || Session.Allows(PortalArea.Displays) || Session.Allows(PortalArea.Users))
                {
                    <div class="portal-nav-label">İşlemler</div>
                    <MudNavMenu Class="portal-nav" Rounded="true" Margin="Margin.Dense">
                        @if (Session.Allows(PortalArea.Approvals))
                        {
                            <MudNavLink Href="muhasebe" Icon="@Icons.Material.Rounded.Keyboard">Onay masası</MudNavLink>
                            <MudNavLink Href="onaylar" Icon="@Icons.Material.Rounded.FactCheck">Onaylar</MudNavLink>
                        }
                        @if (Session.Allows(PortalArea.Warehouse))
                        {
                            <MudNavLink Href="depo" Icon="@Icons.Material.Rounded.Warehouse">Depo</MudNavLink>
                        }
                        @if (Session.Allows(PortalArea.Displays))
                        {
                            <MudNavLink Href="ekranlar" Icon="@Icons.Material.Rounded.Tv">Ekranlar</MudNavLink>
                        }
                        @if (Session.Allows(PortalArea.Users))
                        {
                            <MudNavLink Href="kullanicilar" Icon="@Icons.Material.Rounded.ManageAccounts">Kullanıcılar</MudNavLink>
                        }
                    </MudNavMenu>
                }
            </nav>

            <div class="portal-drawer-footer" id="session-scope">
                <MudIcon Icon="@Icons.Material.Rounded.Lock" Size="Size.Small" />
                <span>@(Session.RememberMe ? "Bu tarayıcıda hatırlanıyor" : "Oturum bu sekmeye özeldir")</span>
            </div>
        </MudDrawer>

        <MudMainContent Class="portal-main">
            <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="portal-container">
                <PortalErrorBoundary @ref="_errorBoundary">@Body</PortalErrorBoundary>
            </MudContainer>
        </MudMainContent>
    </MudLayout>
}
else
{
    <PortalErrorBoundary @ref="_signedOutErrorBoundary">@Body</PortalErrorBoundary>
}

@code {
    private bool _drawerOpen = true;
    private PortalErrorBoundary? _errorBoundary;
    private PortalErrorBoundary? _signedOutErrorBoundary;

    // A new page starts clean: an error shown on the previous page must not stick to the next one.
    protected override void OnParametersSet()
    {
        _errorBoundary?.Recover();
        _signedOutErrorBoundary?.Recover();
    }

    private string Initials => Fmt.Initials(string.IsNullOrWhiteSpace(Session.FullName) ? Session.Username : Session.FullName);

    protected override void OnInitialized() => Session.Changed += Redraw;

    private void Redraw() => InvokeAsync(StateHasChanged);

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private async Task SignOutAsync()
    {
        Session.SignOut();
        await Persistence.ClearAsync();
        Nav.NavigateTo("login");
    }

    public void Dispose() => Session.Changed -= Redraw;
}
