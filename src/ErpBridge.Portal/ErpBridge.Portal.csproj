<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ErpBridge.Portal</RootNamespace>
    <AssemblyName>ErpBridge.Portal</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!--
    The company manager portal. Like the operator console (ErpBridge.Admin) it talks to the
    central API over HTTP only and mirrors the DTOs it needs in Api/Models.cs, so it takes
    no project reference on ErpBridge.CentralApi.
  -->

</Project>
