@page "/jobs"
@using Microsoft.AspNetCore.Components
@inject ErpBridge.Admin.Api.CentralApiClient Api
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>İş Kuyruğu — ErpBridge Yönetim</PageTitle>
<AdminPageHeader Title="İş kuyruğu" Description="Merkezi API'ye iletilen işlemleri filtreleyin ve gerektiğinde tekrar deneyin." />

<div class="admin-filter-bar mb-3 row g-2">
    <div class="col-auto"><select class="form-select" @bind="_status"><option value="">Tüm durumlar</option><option value="pending">Bekliyor</option><option value="processing">İşleniyor</option><option value="succeeded">Başarılı</option><option value="failed">Başarısız</option><option value="deadletter">İşlenemedi</option></select></div>
    <div class="col-auto"><button class="btn btn-primary" @onclick="ReloadAsync">Listele</button></div>
</div>

@if (_loading) { <AdminLoading Text="İş kuyruğu yükleniyor…" /> }
else if (!string.IsNullOrEmpty(_error)) { <AdminState Tone="error" Icon="!" Title="İş kuyruğu alınamadı" Message="@_error" /> }
else if (_jobs.Count == 0) { <AdminState Tone="empty" Icon="✓" Title="İş bulunamadı" Message="Seçilen filtre için kuyrukta kayıt yok." /> }
else
{
    <div class="admin-record-list" aria-label="İş kuyruğu kayıtları">
        @foreach (var j in _jobs)
        {
            var expanded = _expandedId == j.Id;
            <article class="admin-record @(expanded ? "admin-record--expanded" : null)">
                <button class="admin-record__summary" @onclick="() => Toggle(j.Id)" aria-expanded="@expanded">
                    <span class="admin-record__primary"><strong>@j.DocumentType</strong><code>@j.ExternalId</code></span>
                    <span class="admin-record__customer">@TenantName(j.TenantId)</span>
                    <AdminStatusBadge Text="@StatusText(j.Status)" Tone="@StatusTone(j.Status)" />
                    <time datetime="@j.EnqueuedAtUtc.ToString("O")">@j.EnqueuedAtUtc.LocalDateTime.ToString("dd MMM yyyy, HH:mm")</time>
                    <span class="admin-record__chevron" aria-hidden="true">⌄</span>
                </button>
                @if (expanded)
                {
                    <div class="admin-record__detail" id="job-detail">
                        <dl class="admin-kv">
                            <div><dt>Kimlik</dt><dd><code>@j.Id</code></dd></div>
                            <div><dt>Deneme</dt><dd>@j.RetryCount</dd></div>
                            <div><dt>Tamamlanma</dt><dd>@When(j.CompletedAtUtc)</dd></div>
                            <div><dt>Sonraki deneme</dt><dd id="job-next-attempt">@When(j.NextAttemptAtUtc)</dd></div>
                            <div><dt>Kilit bitişi</dt><dd id="job-leased-until">@When(j.LeasedUntilUtc)</dd></div>
                            <div><dt>Son hata</dt><dd>@(j.LastError ?? "—")</dd></div>
                            @if (_detail is { } d && d.Id == j.Id)
                            {
                                <div><dt>Son hata kodu</dt><dd id="job-error-code">@(d.LastErrorCode ?? "—")</dd></div>
                                <div><dt>Kendiliğinden düzelebilir</dt><dd id="job-retryable">@(d.Retryable switch { true => "Evet (ERP'ye ulaşılamadı)", false => "Hayır", _ => "—" })</dd></div>
                                <div><dt>ERP belge no</dt><dd id="job-erp-no">@(d.ErpDocumentNo ?? "—")</dd></div>
                            }
                        </dl>
                        @if (_detail is { } detail && detail.Id == j.Id)
                        {
                            @if (detail.Acks.Count > 0)
                            {
                                <h3 class="job-section-title">Ajan sonuçları</h3>
                                <ul class="job-acks" id="job-acks">
                                    @foreach (var ack in detail.Acks)
                                    {
                                        <li><AdminStatusBadge Text="@AckText(ack.Status)" Tone="@AckTone(ack.Status)" /> @When(ack.AckedAtUtc) · @(ack.ErpDocumentNo ?? ack.ErrorCode ?? "") @ack.ErrorMessage</li>
                                    }
                                </ul>
                            }
                            @if (detail.ErpContext is { } context)
                            {
                                <h3 class="job-section-title">ERP bağlamı (ajan şimdi alsa)</h3>
                                <pre class="job-context" id="job-erp-context">@System.Text.Json.JsonSerializer.Serialize(context, IndentedJson)</pre>
                            }
                        }
                        @if (j.Status.ToLowerInvariant() is "processing" or "failed" or "deadletter") { <button class="btn btn-sm btn-warning" @onclick="() => RetryAsync(j.Id)">Tekrar dene</button> }
                    </div>
                }
            </article>
        }
    </div>
}

@code {
    private bool _loading = true;
    [SupplyParameterFromQuery(Name = "status")] public string? StatusFromQuery { get; set; }
    private string _status = ""; private Guid? _expandedId;
    private IReadOnlyList<ErpBridge.Admin.Api.JobDto> _jobs = Array.Empty<ErpBridge.Admin.Api.JobDto>();
    private IReadOnlyList<ErpBridge.Admin.Api.TenantDto> _tenants = Array.Empty<ErpBridge.Admin.Api.TenantDto>();
    private string? _error;
    protected override async Task OnInitializedAsync() { _status = StatusFromQuery ?? string.Empty; _tenants = await Api.ListTenantsAsync(); await ReloadAsync(); }
    private async Task ReloadAsync() { _loading = true; _error = null; _expandedId = null; try { _jobs = await Api.ListJobsAsync(_status, 200); } catch (Exception ex) { _error = ex.Message; } finally { _loading = false; } }
    private async Task RetryAsync(Guid id) { try { await Api.RetryJobAsync(id); await ReloadAsync(); } catch (Exception ex) { _error = ex.Message; } }
    private ErpBridge.Admin.Api.JobDetailDto? _detail;
    private static readonly System.Text.Json.JsonSerializerOptions IndentedJson = new() { WriteIndented = true, Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping };

    private async Task Toggle(Guid id)
    {
        _expandedId = _expandedId == id ? null : id;
        _detail = null;
        if (_expandedId is not { } open) return;
        try { _detail = await Api.GetJobAsync(open); } catch (Exception ex) { _error = ex.Message; }
    }

    private static string When(DateTimeOffset? instant) => instant?.LocalDateTime.ToString("dd MMM yyyy, HH:mm") ?? "—";
    private static string AckText(string status) => status.ToLowerInvariant() switch { "succeeded" => "Yazıldı", "retry" => "Yeniden denenecek", "failed" => "Hata", _ => status };
    private static string AckTone(string status) => status.ToLowerInvariant() switch { "succeeded" => "success", "retry" => "warning", _ => "danger" };
    private string TenantName(Guid id) => _tenants.FirstOrDefault(t => t.Id == id)?.Name ?? id.ToString().Substring(0, 8);
    private static string StatusText(string status) => status.ToLowerInvariant() switch { "pending" => "Bekliyor", "processing" => "İşleniyor", "succeeded" => "Başarılı", "failed" => "Başarısız", "deadletter" => "İşlenemedi", _ => status };
    private static string StatusTone(string status) => status.ToLowerInvariant() switch { "succeeded" => "success", "failed" or "deadletter" => "danger", "pending" or "processing" => "warning", _ => "muted" };
}
