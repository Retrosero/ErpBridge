@page "/agents"
@inject ErpBridge.Admin.Api.CentralApiClient Api
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Ajanlar — ErpBridge Yönetim</PageTitle>

<AdminPageHeader Title="Ajanlar" Description="Müşteri sistemlerinde çalışan ErpBridge ajanlarının bağlantı ve kuyruk durumunu izleyin." />

@if (_loading)
{
    <AdminLoading Text="Ajanlar yükleniyor…" />
}
else if (!string.IsNullOrEmpty(_error))
{
    <AdminState Tone="error" Icon="!" Title="Ajanlar alınamadı" Message="@_error" />
}
else
{
    <div class="d-flex justify-content-end mb-3">
        <button class="btn btn-outline-primary" @onclick="ReloadAsync">Yenile</button>
    </div>
    <div class="admin-data-surface"><table class="table admin-data-table">
        <thead>
            <tr>
                <th>Müşteri</th><th>Makine</th><th>Son bağlantı</th><th>Durum</th><th>Kuyruk</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in _agents)
            {
                <tr>
                    <td data-label="Müşteri"><strong>@(TenantName(a.TenantId))</strong></td>
                    <td data-label="Makine"><code>@a.MachineId</code></td>
                    <td data-label="Son bağlantı">@(a.LastHeartbeatAtUtc?.LocalDateTime.ToString("dd MMM yyyy, HH:mm") ?? "—")</td>
                    <td data-label="Durum"><AdminStatusBadge Text="@(IsOnline(a) ? "Çevrimiçi" : "Çevrimdışı")" Tone="@(IsOnline(a) ? "success" : "muted")" /></td>
                    <td data-label="Kuyruk"><strong>@a.LastQueueDepth</strong></td>
                </tr>
            }
        </tbody>
    </table></div>
}

@code {
    private bool _loading = true;
    private IReadOnlyList<ErpBridge.Admin.Api.AgentDto> _agents = Array.Empty<ErpBridge.Admin.Api.AgentDto>();
    private IReadOnlyList<ErpBridge.Admin.Api.TenantDto> _tenants = Array.Empty<ErpBridge.Admin.Api.TenantDto>();
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _tenants = await Api.ListTenantsAsync();
            _agents = await Api.ListAgentsAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private string TenantName(Guid id) => _tenants.FirstOrDefault(t => t.Id == id)?.Name ?? id.ToString().Substring(0, 8);
    private static bool IsOnline(ErpBridge.Admin.Api.AgentDto agent) => agent.LastHeartbeatAtUtc is not null && agent.LastHeartbeatAtUtc > DateTimeOffset.UtcNow.AddMinutes(-5);
}
