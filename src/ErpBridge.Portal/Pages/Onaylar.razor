@page "/onaylar"
@inherits PortalPageBase

<PageTitle>Onaylar — Yönetim Paneli</PageTitle>

@if (!Ready)
{
    <PageLoading />
}
else
{
    <PageHeader Title="Bekleyen onaylar" Eyebrow="Yönetim" Subtitle="Sahadan onaya gönderilen işlemler" Busy="Busy">
        <Actions>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Refresh" Disabled="@Busy"
                       OnClick="RefreshAsync" id="approvals-refresh">Yenile</MudButton>
        </Actions>
    </PageHeader>

    @if (!Session.CanApprove)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="page-alert" id="approvals-readonly">
            Talepleri görebilirsiniz; onay vermek için firma admininizin size onay yetkisi vermesi gerekir.
        </MudAlert>
    }
    @if (Notice is not null)
    {
        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="page-alert" id="page-notice">@Notice</MudAlert>
    }
    @if (Error is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="page-alert" id="page-error">@Error</MudAlert>
    }

    @if (_pending is not null)
    {
        @if (_pending.Count == 0)
        {
            <MudPaper Outlined="true" Class="panel">
                <EmptyState Id="approvals-empty" Icon="@Icons.Material.Rounded.TaskAlt" Title="Bekleyen talep yok." Hint="Sahadan onaya gönderilen işlemler burada listelenir." />
            </MudPaper>
        }
        else
        {
            <p class="section-caption">@_pending.Count talep sonuç bekliyor · toplam @Fmt.Money(_pending.Sum(r => r.Amount))</p>
            <div class="approval-list" id="approvals-list">
                @foreach (var request in _pending)
                {
                    <MudPaper Outlined="true" Class="approval-card" data-request="@request.Id">
                        <div class="approval-main">
                            <span class="approval-icon tone-@KindTone(request.Kind)"><MudIcon Icon="@KindIcon(request.Kind)" /></span>
                            <div class="approval-text">
                                <div class="approval-title">
                                    <span class="badge badge--@KindTone(request.Kind)">@Fmt.ApprovalKind(request.Kind)</span>
                                    <strong>@request.CounterpartyName</strong>
                                </div>
                                <div class="approval-meta">
                                    <MudIcon Icon="@Icons.Material.Rounded.Person" Size="Size.Small" />
                                    <span>@(request.RequestedByName ?? "Bilinmeyen kullanıcı")</span>
                                    <MudIcon Icon="@Icons.Material.Rounded.Schedule" Size="Size.Small" />
                                    <span>@Fmt.Time(request.RequestedAtUtc)</span>
                                </div>
                            </div>
                            <div class="approval-amount">@Fmt.Money(request.Amount)</div>
                        </div>
                        @if (Session.CanApprove)
                        {
                            <div class="approval-actions">
                                <MudTextField T="string" Value="@NoteFor(request.Id)" ValueChanged="v => _notes[request.Id] = v" Placeholder="Not (isteğe bağlı)"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="500" Class="portal-note" />
                                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Rounded.Close" Disabled="@Busy"
                                           Class="reject-btn" OnClick="() => DecideAsync(request, approve: false)">Reddet</MudButton>
                                <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Rounded.Check" Disabled="@Busy"
                                           Class="approve-btn" OnClick="() => DecideAsync(request, approve: true)">Onayla</MudButton>
                            </div>
                        }
                    </MudPaper>
                }
            </div>
        }
    }
}

@code {
    protected override PortalArea Requires => PortalArea.Approvals;

    /// <summary>Codes after which the list on screen is stale and is read again.</summary>
    private static readonly HashSet<string> StaleCodes = ["APPROVAL_ALREADY_DECIDED", "APPROVAL_STATE_CHANGED", "APPROVAL_NOT_FOUND"];

    private List<ApprovalDto>? _pending;
    private readonly Dictionary<Guid, string?> _notes = [];

    private string? Notice { get; set; }

    protected override async Task LoadAsync() => _pending = [.. await Api.PendingApprovalsAsync()];

    private string? NoteFor(Guid id) => _notes.GetValueOrDefault(id);

    private Task RefreshAsync()
    {
        Notice = null;
        return RunAsync(LoadAsync);
    }

    private async Task DecideAsync(ApprovalDto request, bool approve)
    {
        Notice = null;
        await RunAsync(async () =>
        {
            try
            {
                var note = NoteFor(request.Id);
                await Api.DecideAsync(request.Id, approve, string.IsNullOrWhiteSpace(note) ? null : note.Trim());
                _pending?.RemoveAll(r => r.Id == request.Id);
                _notes.Remove(request.Id);
                Notice = $"{request.CounterpartyName} — {Fmt.ApprovalKind(request.Kind).ToLower(Fmt.Turkish)} talebi {(approve ? "onaylandı" : "reddedildi")}.";
            }
            catch (PortalApiException stale) when (StaleCodes.Contains(stale.Code))
            {
                await LoadAsync();
                throw;
            }
        });
    }

    private static string KindTone(string kind) => kind switch
    {
        "sale" => "primary",
        "collection" => "success",
        "return" => "danger",
        "disbursement" or "purchase" => "warning",
        _ => "violet",
    };

    private static string KindIcon(string kind) => kind switch
    {
        "sale" => Icons.Material.Rounded.ShoppingCart,
        "collection" => Icons.Material.Rounded.Payments,
        "return" => Icons.Material.Rounded.AssignmentReturn,
        "disbursement" => Icons.Material.Rounded.ReceiptLong,
        "purchase" => Icons.Material.Rounded.LocalShipping,
        "stock_count" => Icons.Material.Rounded.Inventory2,
        _ => Icons.Material.Rounded.EditNote,
    };
}
