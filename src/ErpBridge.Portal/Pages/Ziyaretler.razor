@page "/ziyaretler"
@inherits PortalPageBase

<PageTitle>Ziyaretler — Yönetim Paneli</PageTitle>

@if (!Ready)
{
    <PageLoading />
}
else
{
    <PageHeader Title="Rota ve ziyaretler" Eyebrow="Genel bakış" Subtitle="@Fmt.Day(_day)" Busy="Busy">
        <Actions>
            <MudDatePicker Label="Tarih" Date="@_day.ToDateTime(TimeOnly.MinValue)" DateChanged="ChangeDayAsync" Culture="Fmt.Turkish" DateFormat="dd.MM.yyyy"
                           Editable="true" Variant="Variant.Outlined" Margin="Margin.Dense" InputId="visits-date" Class="page-date" />
        </Actions>
    </PageHeader>

    @if (Error is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="page-alert" id="page-error">@Error</MudAlert>
    }

    @if (_visits is not null)
    {
        @if (_visits.Rows.Count == 0)
        {
            <EmptyState Id="visits-empty" Icon="@Icons.Material.Rounded.Route" Title="Bu gün için planlanmış rota veya kayıtlı ziyaret yok."
                        Hint="Rotalar telefondaki Rota ekranından planlanır." />
        }
        else
        {
            var completed = _visits.Rows.Count(r => r.Status == "COMPLETED");
            var planned = _visits.Rows.Count(r => r.Planned);
            var skipped = _visits.Rows.Count(r => r.Status == "SKIPPED");

            <section class="stat-grid stat-grid--three">
                <StatCard Label="Ziyaret edildi" Value="@completed.ToString(Fmt.Turkish)" Icon="@Icons.Material.Rounded.CheckCircle" Tone="success" />
                <StatCard Label="Planlı durak" Value="@planned.ToString(Fmt.Turkish)" Icon="@Icons.Material.Rounded.Route" Tone="info" />
                <StatCard Label="Atlandı" Value="@skipped.ToString(Fmt.Turkish)" Icon="@Icons.Material.Rounded.EventBusy" Tone="warning" />
            </section>
            <p class="section-caption" id="visits-count">@completed ziyaret edildi · @planned planlı durak</p>

            <div class="card-stack">
                @foreach (var group in _visits.Rows.GroupBy(r => r.Username))
                {
                    var rows = group.ToList();
                    var done = rows.Count(r => r.Status != "PENDING");
                    var rate = rows.Count == 0 ? 0 : 100.0 * done / rows.Count;
                    <MudPaper Outlined="true" Class="panel panel--table">
                        <div class="panel-head">
                            <div class="person">
                                <MudAvatar Size="Size.Medium" Color="Color.Primary" Variant="Variant.Filled">@Fmt.Initials(group.Key)</MudAvatar>
                                <div>
                                    <MudText Typo="Typo.h6" HtmlTag="h2" data-user="@group.Key">@group.Key</MudText>
                                    <div class="person-sub">@done / @rows.Count durak sonuçlandı</div>
                                </div>
                            </div>
                            <div class="panel-head-progress">
                                <MudProgressLinear Color="Color.Success" Rounded="true" Size="Size.Small" Value="@rate" />
                            </div>
                        </div>
                        <div class="table-scroll">
                            <MudSimpleTable Hover="true" Dense="true" Elevation="0" Class="data-table">
                                <thead>
                                    <tr>
                                        <th class="num">Sıra</th>
                                        <th>Cari</th>
                                        <th>Durum</th>
                                        <th>Saat</th>
                                        <th>Not</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in rows)
                                    {
                                        <tr data-customer="@row.CustomerCode">
                                            <td class="num">@(row.Planned ? row.VisitOrder.ToString(Fmt.Turkish) : "—")</td>
                                            <td>
                                                <div class="cell-title">@(string.IsNullOrWhiteSpace(row.CustomerName) ? row.CustomerCode : row.CustomerName)</div>
                                                <div class="cell-sub">
                                                    @row.CustomerCode
                                                    @if (!row.Planned)
                                                    {
                                                        <span class="badge badge--info" title="Rotada olmayan bir cari ziyaret edildi">Plan dışı</span>
                                                    }
                                                </div>
                                            </td>
                                            <td><span class="badge @StatusClass(row.Status)">@Fmt.VisitStatus(row.Status)</span></td>
                                            <td class="nowrap">@Fmt.ClockTime(row.CompletedAt)</td>
                                            <td class="wrap">@row.Note</td>
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        </div>
                    </MudPaper>
                }
            </div>
        }
    }
}

@code {
    protected override PortalArea Requires => PortalArea.Reports;

    [SupplyParameterFromQuery(Name = "date")] public string? DateQuery { get; set; }

    private DateOnly _day;
    private VisitsResponse? _visits;

    protected override void OnInitialized() =>
        _day = Fmt.TryIsoDay(DateQuery, out var day) ? day : Fmt.Today();

    protected override async Task LoadAsync() => _visits = await Api.VisitsAsync(_day);

    private async Task ChangeDayAsync(DateTime? value)
    {
        if (value is not { } date) return;
        _day = DateOnly.FromDateTime(date);
        await RunAsync(LoadAsync);
    }

    private static string StatusClass(string status) => status switch
    {
        "COMPLETED" => "badge--ok",
        "SKIPPED" => "badge--warn",
        _ => "badge--muted",
    };
}
