@inherits LayoutComponentBase
@implements IDisposable
@inject PortalSession Session
@inject ISessionPersistence Persistence
@inject NavigationManager Nav
@inject PortalApiClient Api
@inject PortalRefreshTiming Refresh

<MudThemeProvider Theme="PortalTheme.Theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@if (Session.IsSignedIn)
{
    <a class="skip-link" href="@(Nav.Uri.Split('#')[0] + "#portal-content")" @onclick="async () => await _content.FocusAsync()" @onclick:preventDefault>İçeriğe geç</a>
    <MudLayout Class="portal-shell">
        <MudAppBar Elevation="0" Class="portal-appbar" Gutters="true">
            <MudIconButton Icon="@Icons.Material.Rounded.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" aria-label="Menüyü aç veya kapat" />
            <div class="portal-appbar-title">
                <span class="portal-appbar-tenant">@Session.TenantName</span>
                <span class="portal-appbar-code">Firma kodu @Session.TenantCode</span>
            </div>
            <MudSpacer />
            <NotificationBell />
            <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true" aria-label="Hesap menüsü">
                @* MudBlazor 9: a custom activator opens the menu itself; the wrapper no longer listens for the click.
                   A real button so Enter and Space open it too. *@
                <ActivatorContent>
                    <button type="button" class="portal-user" id="account-menu" aria-haspopup="menu" @onclick="@(e => context.ToggleAsync(e))">
                        <MudAvatar Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">@Initials</MudAvatar>
                        <span class="portal-user-text">
                            <span class="portal-user-name">@Session.FullName</span>
                            <span class="portal-user-role" id="user-roles">@Fmt.Roles(Session.Roles)</span>
                        </span>
                        <MudIcon Icon="@Icons.Material.Rounded.ExpandMore" Size="Size.Small" />
                    </button>
                </ActivatorContent>
                <ChildContent>
                    <MudMenuItem Icon="@Icons.Material.Rounded.Logout" OnClick="SignOutAsync" id="logout">Çıkış yap</MudMenuItem>
                </ChildContent>
            </MudMenu>
        </MudAppBar>

        <MudDrawer @bind-Open="_drawerOpen" Elevation="0" Variant="DrawerVariant.Responsive" Breakpoint="Breakpoint.Md" ClipMode="DrawerClipMode.Never" Class="portal-drawer">
            <div class="portal-brand">
                <div class="portal-brand-mark">
                    <MudIcon Icon="@Icons.Material.Rounded.Insights" />
                </div>
                <div>
                    <div class="portal-brand-name">Sipariş Cepte</div>
                    <div class="portal-brand-sub">Yönetim Paneli</div>
                </div>
            </div>

            <nav id="portal-nav">
                @if (Session.Allows(PortalArea.Reports))
                {
                    <div class="portal-nav-label">Genel bakış</div>
                    <MudNavMenu Class="portal-nav" Rounded="true" Margin="Margin.Dense">
                        <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Rounded.SpaceDashboard">Özet</MudNavLink>
                        <MudNavLink Href="plasiyerler" Icon="@Icons.Material.Rounded.Leaderboard">Plasiyerler</MudNavLink>
                        <MudNavLink Href="ziyaretler" Icon="@Icons.Material.Rounded.Route">Ziyaretler</MudNavLink>
                        <MudNavLink Href="depo-performans" Icon="@Icons.Material.Rounded.Speed">Depo performansı</MudNavLink>
                    </MudNavMenu>
                }

                @if (Session.Allows(PortalArea.Targets))
                {
                    <div class="portal-nav-label">Hedefler &amp; rut</div>
                    <MudNavMenu Class="portal-nav" Rounded="true" Margin="Margin.Dense">
                        <MudNavLink Href="hedefler" Match="NavLinkMatch.All" Icon="@Icons.Material.Rounded.TrackChanges" id="nav-targets">Hedef takibi</MudNavLink>
                        <MudNavLink Href="hedefler/giris" Icon="@Icons.Material.Rounded.EditNote" id="nav-target-entry">Hedef girişi</MudNavLink>
                        <MudNavLink Href="rut" Match="NavLinkMatch.All" Icon="@Icons.Material.Rounded.Route" id="nav-routes">Rut planı</MudNavLink>
                        <MudNavLink Href="rut/uyum" Icon="@Icons.Material.Rounded.FactCheck" id="nav-route-compliance">Rut uyumu</MudNavLink>
                        <MudNavLink Href="ekipler" Icon="@Icons.Material.Rounded.Groups" id="nav-teams">Bölge ve ekipler</MudNavLink>
                    </MudNavMenu>
                }

                @if (Session.Allows(PortalArea.Ledger))
                {
                    <div class="portal-nav-label">Kayıtlar</div>
                    <MudNavMenu Class="portal-nav" Rounded="true" Margin="Margin.Dense">
                        <MudNavLink Href="cariler" Icon="@Icons.Material.Rounded.AccountBalanceWallet">Cariler</MudNavLink>
                        <MudNavLink Href="stok" Icon="@Icons.Material.Rounded.Inventory2">Stok</MudNavLink>
                        <MudNavLink Href="tahsilatlar" Icon="@Icons.Material.Rounded.Payments" id="nav-payments">Tahsilatlar</MudNavLink>
                        <MudNavLink Href="evraklar" Icon="@Icons.Material.Rounded.Description" id="nav-documents">Evraklar</MudNavLink>
                        <MudNavLink Href="hareketler" Icon="@Icons.Material.Rounded.ReceiptLong" id="nav-movements">Hareketler</MudNavLink>
                        <MudNavLink Href="fisler" Icon="@Icons.Material.Rounded.Receipt" id="nav-receipts">Gider fişleri</MudNavLink>
                    </MudNavMenu>
                }

                @if (Session.Allows(PortalArea.Entries) || Session.CanEditNativeData)
                {
                    @* GOAL_PANEL_GIRIS: the phone's documents, entered from the panel in both kinds of company, each by its phone module.
                       The stock count stays the ERP-less admin's (GOAL_PANEL_ERPSIZ E6c). *@
                    <div class="portal-nav-label">Hızlı giriş</div>
                    <MudNavMenu Class="portal-nav" Rounded="true" Margin="Margin.Dense">
                        @if (Session.Allows(PortalArea.EntrySales))
                        {
                            <MudNavLink Href="giris/satis" Icon="@Icons.Material.Rounded.PointOfSale" id="nav-new-sale">Satış</MudNavLink>
                        }
                        @if (Session.Allows(PortalArea.EntryCollection))
                        {
                            <MudNavLink Href="giris/tahsilat" Icon="@Icons.Material.Rounded.Payments" id="nav-new-collection">Tahsilat</MudNavLink>
                        }
                        @if (Session.Allows(PortalArea.EntryPurchase))
                        {
                            <MudNavLink Href="giris/alis" Icon="@Icons.Material.Rounded.LocalShipping" id="nav-new-purchase">Alış</MudNavLink>
                        }
                        @if (Session.Allows(PortalArea.EntryReturns))
                        {
                            <MudNavLink Href="giris/iade" Icon="@Icons.Material.Rounded.AssignmentReturn" id="nav-new-return">İade</MudNavLink>
                        }
                        @if (Session.Allows(PortalArea.EntryDisbursement))
                        {
                            <MudNavLink Href="giris/tediye" Icon="@Icons.Material.Rounded.Outbound" id="nav-new-disbursement">Tediye</MudNavLink>
                        }
                        @if (Session.Allows(PortalArea.EntryExpenses))
                        {
                            <MudNavLink Href="giris/gider" Icon="@Icons.Material.Rounded.ReceiptLong" id="nav-new-expense">Gider</MudNavLink>
                        }
                        @if (Session.Allows(PortalArea.Entries))
                        {
                            <MudNavLink Href="girisler" Icon="@Icons.Material.Rounded.History" id="nav-entries">Son girişler</MudNavLink>
                        }
                        @if (Session.CanEditNativeData)
                        {
                            <MudNavLink Href="stok/sayim" Icon="@Icons.Material.Rounded.Checklist" id="nav-stock-count">Stok sayımı</MudNavLink>
                        }
                    </MudNavMenu>
                }

                @if (Session.Allows(PortalArea.Tasks))
                {
                    @* GOAL_PANEL_GIRIS P6: the phone's tasks, gated on module.tasks (the server checks it for a panel session too). *@
                    <div class="portal-nav-label">Ekip</div>
                    <MudNavMenu Class="portal-nav" Rounded="true" Margin="Margin.Dense">
                        <MudNavLink Href="gorevler" Match="NavLinkMatch.All" Icon="@Icons.Material.Rounded.TaskAlt" id="nav-tasks">Görevler</MudNavLink>
                        <MudNavLink Href="gorevler/seriler" Icon="@Icons.Material.Rounded.EventRepeat" id="nav-task-series">Tekrarlayan görevler</MudNavLink>
                    </MudNavMenu>
                }

                @if (Session.Allows(PortalArea.CustomerCatalog))
                {
                    @* GOAL_MUSTERI_KATALOGU: only while the company has the customer_catalog module; same for ERP and ERP-less companies. *@
                    <div class="portal-nav-label">Müşteri kataloğu</div>
                    <MudNavMenu Class="portal-nav" Rounded="true" Margin="Margin.Dense">
                        <MudNavLink Href="katalog" Icon="@Icons.Material.Rounded.Storefront" id="nav-catalog">Katalog yönetimi</MudNavLink>
                        <MudNavLink Href="musteri-siparisleri" Icon="@Icons.Material.Rounded.ShoppingCartCheckout" id="nav-customer-orders">
                            Müşteri siparişleri
                            @if (_newOrders is int waiting && waiting > 0)
                            {
                                <span class="nav-count" id="nav-customer-orders-new" title="@($"{waiting} yeni talep")">@(waiting > 99 ? "99+" : waiting.ToString(System.Globalization.CultureInfo.InvariantCulture))</span>
                            }
                        </MudNavLink>
                    </MudNavMenu>
                }

                @if (Session.Allows(PortalArea.Approvals) || Session.Allows(PortalArea.Warehouse) || Session.Allows(PortalArea.Displays) || Session.Allows(PortalArea.Users) || Session.Allows(PortalArea.NativeAudit) || Session.Allows(PortalArea.Storage))
                {
                    <div class="portal-nav-label">İşlemler</div>
                    <MudNavMenu Class="portal-nav" Rounded="true" Margin="Margin.Dense">
                        @if (Session.Allows(PortalArea.Approvals))
                        {
                            <MudNavLink Href="muhasebe" Icon="@Icons.Material.Rounded.Keyboard">Onay masası</MudNavLink>
                            <MudNavLink Href="onaylar" Icon="@Icons.Material.Rounded.FactCheck">Onaylar</MudNavLink>
                        }
                        @if (Session.Allows(PortalArea.Warehouse))
                        {
                            <MudNavLink Href="depo" Icon="@Icons.Material.Rounded.Warehouse">Depo</MudNavLink>
                        }
                        @if (Session.Allows(PortalArea.Displays))
                        {
                            <MudNavLink Href="ekranlar" Icon="@Icons.Material.Rounded.Tv">Ekranlar</MudNavLink>
                        }
                        @if (Session.Allows(PortalArea.Users))
                        {
                            <MudNavLink Href="kullanicilar" Icon="@Icons.Material.Rounded.ManageAccounts">Kullanıcılar</MudNavLink>
                            <MudNavLink Href="yetkiler" Icon="@Icons.Material.Rounded.AdminPanelSettings" id="nav-permissions">Yetkiler</MudNavLink>
                            <MudNavLink Href="gorunum-sablonlari" Icon="@Icons.Material.Rounded.Dashboard" id="nav-view-templates">Görünüm şablonları</MudNavLink>
                        }
                        @if (Session.Allows(PortalArea.Storage))
                        {
                            @* GOAL_DEPOLAMA_R2 P1: quota, "Alan aç" and the trash; action.storage.manage (ADMIN, MANAGER). *@
                            <MudNavLink Href="depolama" Icon="@Icons.Material.Rounded.Storage" id="nav-storage">Depolama</MudNavLink>
                        }
                        @if (Session.Allows(PortalArea.ErpDocuments) && string.Equals(Session.DataSource, "erp", StringComparison.OrdinalIgnoreCase))
                        {
                            <MudNavLink Href="erp-belgeler" Icon="@Icons.Material.Rounded.ReceiptLong" id="nav-erp-documents">ERP belgeleri</MudNavLink>
                        }
                        @if (Session.Allows(PortalArea.ErpWrite) && string.Equals(Session.DataSource, "erp", StringComparison.OrdinalIgnoreCase))
                        {
                            <MudNavLink Href="erp-aktarim" Icon="@Icons.Material.Rounded.SyncAlt" id="nav-erp-write">ERP aktarım ayarları</MudNavLink>
                            <MudNavLink Href="erp-gider-kartlari" Icon="@Icons.Material.Rounded.Receipt" id="nav-erp-expense-cards">Gider kartları</MudNavLink>
                        }
                        @if (Session.Allows(PortalArea.NativeAudit) && string.Equals(Session.DataSource, "native", StringComparison.OrdinalIgnoreCase))
                        {
                            <MudNavLink Href="denetim" Icon="@Icons.Material.Rounded.History" id="nav-native-audit">Denetim</MudNavLink>
                        }
                    </MudNavMenu>
                }
            </nav>

            <div class="portal-drawer-footer" id="session-scope">
                <MudIcon Icon="@Icons.Material.Rounded.Lock" Size="Size.Small" />
                <span>@(Session.RememberMe ? "Bu tarayıcıda hatırlanıyor" : "Oturum bu sekmeye özeldir")</span>
            </div>
        </MudDrawer>

        <MudMainContent Class="portal-main">
            <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="portal-container">
                <main id="portal-content" tabindex="-1" @ref="_content"><PortalErrorBoundary @ref="_errorBoundary">@Body</PortalErrorBoundary></main>
            </MudContainer>
        </MudMainContent>
    </MudLayout>
}
else
{
    <PortalErrorBoundary @ref="_signedOutErrorBoundary">@Body</PortalErrorBoundary>
}

@code {
    private bool _drawerOpen = true;
    private ElementReference _content;
    private PortalErrorBoundary? _errorBoundary;
    private PortalErrorBoundary? _signedOutErrorBoundary;

    // A new page starts clean: an error shown on the previous page must not stick to the next one.
    protected override void OnParametersSet()
    {
        _errorBoundary?.Recover();
        _signedOutErrorBoundary?.Recover();
    }

    private string Initials => Fmt.Initials(string.IsNullOrWhiteSpace(Session.FullName) ? Session.Username : Session.FullName);

    // GOAL_MUSTERI_KATALOGU P7: the new customer requests, read once a minute and on every page change, while the module and
    // the roles open the area. The loop lives as long as the layout (the circuit) and stops when it is disposed.
    private readonly CancellationTokenSource _live = new();
    private int? _newOrders;
    private bool _counting;
    private string? _countedPath;

    protected override void OnInitialized()
    {
        Session.Changed += Redraw;
        Nav.LocationChanged += PageChanged;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) _ = WatchNewOrdersAsync(_live.Token);
    }

    private void Redraw() => InvokeAsync(async () =>
    {
        StateHasChanged();
        // Signed in (or the roles read again) after the layout was drawn: the badge needn't wait for the next minute.
        if (_newOrders is null) await CountNewOrdersAsync();
    });

    private void PageChanged(object? sender, LocationChangedEventArgs e)
    {
        // A page that rewrites its own address (filters, paging) is not a page change.
        if (string.Equals(PathOf(e.Location), _countedPath, StringComparison.OrdinalIgnoreCase)) return;
        _ = InvokeAsync(CountNewOrdersAsync);
    }

    private static string PathOf(string uri) => new Uri(uri).AbsolutePath;

    private async Task WatchNewOrdersAsync(CancellationToken token)
    {
        try
        {
            using var timer = new PeriodicTimer(Refresh.CustomerOrders);
            do
            {
                await InvokeAsync(CountNewOrdersAsync);
            }
            while (await timer.WaitForNextTickAsync(token));
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task CountNewOrdersAsync()
    {
        if (_live.IsCancellationRequested || _counting) return;
        _countedPath = PathOf(Nav.Uri);
        if (!Session.IsSignedIn || !Session.Allows(PortalArea.CustomerCatalog))
        {
            if (_newOrders is null) return;
            _newOrders = null;
            StateHasChanged();
            return;
        }
        _counting = true;
        try
        {
            _newOrders = (await Api.CatalogOrderCountsAsync(_live.Token)).New;
        }
        catch (Exception ex) when (ex is PortalApiException or SessionEndedException or HttpRequestException or TaskCanceledException)
        {
            // The badge is a hint: it keeps the last count, and the page the user is on deals with an ended session.
        }
        finally
        {
            _counting = false;
        }
        if (!_live.IsCancellationRequested) StateHasChanged();
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    // The saved session goes first: a page reloaded while it is still stored would sign the user back in.
    // A storage failure must not keep the user signed in; the full reload drops the circuit and its session.
    private async Task SignOutAsync()
    {
        try
        {
            await Persistence.ClearAsync();
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException)
        {
        }
        Session.SignOut();
        Nav.NavigateTo("login", forceLoad: true);
    }

    public void Dispose()
    {
        Session.Changed -= Redraw;
        Nav.LocationChanged -= PageChanged;
        _live.Cancel();
    }
}
