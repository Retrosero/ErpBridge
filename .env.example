# =============================================================================
# ErpBridge — local operator secrets template
# =============================================================================
# Bu dosya repoya commit EDİLİR. Gerçek şifreler .env dosyasına yazılır (git'te
# yok, .gitignore'da whitelist dışı). Kopyala:  cp .env.example .env
# Sonra .env içindeki placeholder'ları doldur.
#
# Test çalıştırmadan önce dotnet user-secrets veya bu .env yükleyici kullanılır.
# Şifre alanlarına dummy değer koyma — boş bırakırsan TulparLiveSettings
# IsConfigured=false döner, test skip olur (hermetik davranış bozulmaz).
# =============================================================================

# TULPAR canlı Mikro V15 SQL Server — operator'ün doldurduğu değerler
ERPBridge_TULPAR_SERVER=TULPAR
ERPBridge_TULPAR_DATABASE=MikroDB_V15_02
ERPBridge_TULPAR_USER=mikro_sync_user
ERPBridge_TULPAR_PASSWORD=MikroSync2025

# Docker-compose V15/V16 fixture gate. Default 0 — hermetik integration testleri
# skip olur. TULPAR canlı testi bu gate'e bağlı değildir (kendi env-var'larına
# bakar), dolayısıyla TULPAR için bu satırı 1 yapmanıza gerek yok. Docker-compose
# V15/V16 fixture'ı çalıştırmak istediğinizde sadece burayı 1 yapın.
ERPBridge_RUN_INTEGRATION=0
