<UserControl x:Class="ErpBridge.Agent.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ErpBridge.Agent.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header row: title + status badge + refresh button -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Vertical">
                <TextBlock Text="Pano"
                           FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource HeaderBrush}" />
                <TextBlock Text="Senkronizasyon durumu ve operatör özet bilgileri"
                           FontSize="12"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Margin="0,2,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{Binding StatusBadgeBrush}"
                        CornerRadius="3"
                        Padding="10,3"
                        Margin="0,0,12,0"
                        ToolTip="Senkronizasyon gecikmesi / sağlık durumu">
                    <TextBlock Text="{Binding StatusBadgeText}"
                               Foreground="White"
                               FontWeight="SemiBold"
                               FontSize="13" />
                </Border>
                <Button Content="🚀 Şimdi Bootstrap Et"
                        Command="{Binding RunBootstrapCommand}"
                        MinWidth="180"
                        Margin="0,0,8,0"
                        Padding="10,4"
                        ToolTip="Mikro'dan referans verileri çek ve Central API'ye gönder (60 dk idempotency penceresini bypass eder)" />
                <Button Content="🔄 Yenile"
                        Command="{Binding RefreshCommand}"
                        MinWidth="110"
                        Padding="10,4" />
            </StackPanel>
        </Grid>

        <!-- Per-section bootstrap buttons (workaround for slow Cloudflare tunnel) -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,8"
                Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Her Tablo (yavaş tunnel için)"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Margin="0,0,0,6" />
                <TextBlock TextWrapping="Wrap"
                           FontSize="11"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Margin="0,0,0,8">
                    <Run Text="Toplu bootstrap tunnel'da takılırsa, her tabloyu ayrı ayrı gönder. Her buton sadece ilgili Mikro tablosunu okur ve Central API'ye push eder." />
                </TextBlock>
                <ItemsControl>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <Button Content="👥 Cariler" Command="{Binding PushCustomersCommand}" MinWidth="120" Margin="0,0,6,6" Padding="8,4" />
                    <Button Content="📦 Stoklar" Command="{Binding PushStocksCommand}" MinWidth="120" Margin="0,0,6,6" Padding="8,4" />
                    <Button Content="📋 Açık Siparişler" Command="{Binding PushOpenOrdersCommand}" MinWidth="140" Margin="0,0,6,6" Padding="8,4" />
                    <Button Content="💰 Kasa/Banka" Command="{Binding PushCashAndBankCommand}" MinWidth="130" Margin="0,0,6,6" Padding="8,4" />
                    <Button Content="🔍 Lookup" Command="{Binding PushLookupsCommand}" MinWidth="120" Margin="0,0,6,6" Padding="8,4" />
                    <Button Content="💲 Fiyatlar" Command="{Binding PushPricesCommand}" MinWidth="120" Margin="0,0,6,6" Padding="8,4" />
                    <Button Content="📊 Envanter" Command="{Binding PushInventoryCommand}" MinWidth="120" Margin="0,0,6,6" Padding="8,4" />
                </ItemsControl>

                <!-- MikroDB row-count diagnostic. Disambiguates "MikroDB empty"
                     from "SQL filter wrong" — both look like 0-row push. -->
                <Button Content="🔢 MikroDB Satır Sayıları"
                        Command="{Binding CheckMikroRowCountsCommand}"
                        MinWidth="220" Margin="0,8,0,0" Padding="8,4"
                        ToolTip="Tüm Mikro tablolarından SELECT COUNT(*) çalıştırır. Push 0 dönüyorsa MikroDB gerçekten boş mu yoksa SQL filtresi mi yanlış, bunu ayırt etmek için kullanılır." />

                <Border Margin="0,8,0,0"
                        Padding="10,8"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Background="{DynamicResource StatusBackgroundBrush}"
                        Visibility="{Binding HasMikroCountResult, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{Binding MikroCountSummaryDisplay}"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Foreground="{DynamicResource HeaderBrush}"
                                   TextWrapping="Wrap" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="CARI_HESAPLAR" Margin="0,1" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding MikroCustomersCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="STOKLAR" Margin="0,1" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MikroStocksCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="SIPARISLER (açık)" Margin="0,1" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MikroOpenOrdersCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="KASALAR + BANKALAR" Margin="0,1" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding MikroCashAndBankCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" />
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="DEPOLAR + PERSONEL" Margin="0,1" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding MikroLookupsCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" />
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="STOK_SATIS_FIYAT_LISTELERI" Margin="0,1" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding MikroPricesCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" />
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="STOK_HAREKETLERI" Margin="0,1" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding MikroInventoryCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" />
                        </Grid>
                        <TextBlock Text="{Binding MikroCountTimeDisplay, StringFormat='Son kontrol: {0}'}"
                                   FontSize="10"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Top cards: last sync + counts -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Last sync card -->
            <Border Grid.Column="0"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="Son Senkronizasyon"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock Text="{Binding LastSyncAtDisplay}"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource HeaderBrush}"
                               Margin="0,6,0,0" />
                    <TextBlock Text="{Binding LastSyncRelativeDisplay}"
                               FontSize="12"
                               Foreground="{DynamicResource AccentBrush}"
                               Margin="0,2,0,0" />
                    <TextBlock Text="{Binding NextEligibleRunDisplay}"
                               FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- Last run summary card -->
            <Border Grid.Column="2"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="Son Çalıştırma Özeti"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Cariler" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LastCustomersCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Stoklar" Margin="0,2,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LastStocksCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" Margin="0,2,0,0" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Fiyatlar" Margin="0,2,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LastPricesCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" Margin="0,2,0,0" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Açık siparişler" Margin="0,2,0,0" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LastOpenOrdersCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" Margin="0,2,0,0" />

                        <TextBlock Grid.Row="3" Grid.Column="1" Visibility="Collapsed" />
                    </Grid>

                    <Border Background="{Binding LastRunStatusBrush}"
                            CornerRadius="3"
                            Padding="8,3"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Left">
                        <TextBlock Text="{Binding LastRunStatusDisplay}"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   FontSize="12" />
                    </Border>
                    <TextBlock Text="{Binding LastRunSummaryDisplay}"
                               FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Bottom: status / hint area -->
        <Border Grid.Row="3"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16">
            <StackPanel>
                <TextBlock Text="Hatırlatma"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedTextBrush}" />
                <TextBlock TextWrapping="Wrap"
                           Foreground="{DynamicResource SubtleHeaderBrush}"
                           Margin="0,8,0,0">
                    <Run Text="Uygulama sistem tepsisine (saat kısmının yanı) küçültüldüğünde arka planda çalışmaya devam eder. Çift tıklayarak pencereyi geri getirebilirsiniz." />
                    <LineBreak />
                    <LineBreak />
                    <Run Text="Son senkronizasyon, Central API'ye gönderilen en son başarılı bootstrap yüklemesidir. İdempotency penceresi 60 dakikadır — bu süre içinde yeni bir tetikleme yapılmaz." />
                </TextBlock>

                <Border Background="{DynamicResource WarningLightBrush}"
                        BorderBrush="{DynamicResource WarningBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10,8"
                        Margin="0,16,0,0"
                        Visibility="{Binding LastErrorDisplay, Converter={StaticResource StringToVisibilityConverter}}">
                    <TextBlock Text="{Binding LastErrorDisplay}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource WarningBrush}" />
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
