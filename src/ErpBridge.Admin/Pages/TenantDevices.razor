@page "/tenants/{TenantId:guid}/devices"
@inject ErpBridge.Admin.Api.CentralApiClient Api
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
<PageTitle>Cihaz Lisansları</PageTitle>
@if (_loading) { <p>Yükleniyor…</p> }
else if (_tenant is null) { <div class="alert alert-danger">@_error</div> }
else { <div class="d-flex justify-content-between align-items-center mb-4"><div><h1>@_tenant.Name · Cihazlar</h1><p class="text-muted">@_devices.Count(x=>x.IsActive) / @_tenant.DeviceSeatLimit aktif koltuk</p></div><a class="btn btn-outline-secondary" href="tenants">Tenantlar</a></div>
<div class="row g-3 mb-4"><div class="col-md-5"><div class="card shadow-sm"><div class="card-body"><h5>Koltuk limiti</h5><div class="input-group"><input class="form-control" type="number" min="1" @bind="_seatLimit"/><button class="btn btn-primary" @onclick="SaveSeatsAsync">Kaydet</button></div></div></div></div><div class="col-md-7"><div class="card shadow-sm"><div class="card-body"><h5>Yeni cihaz</h5><button class="btn btn-success" @onclick="CreateCodeAsync">Aktivasyon kodu üret</button>@if(_code is not null){<div class="alert alert-success mt-3 mb-0"><strong>@_code.Code</strong><br/><small>QR kod içeriği olarak kullanılabilir. Son kullanım: @_code.ExpiresAtUtc.LocalDateTime.ToString("g")</small></div>}</div></div></div></div>
@if(!string.IsNullOrWhiteSpace(_error)){<div class="alert alert-danger">@_error</div>}<div class="card shadow-sm"><div class="table-responsive"><table class="table mb-0 align-middle"><thead><tr><th>Cihaz</th><th>Sürüm</th><th>Son bağlantı</th><th>Durum</th><th></th></tr></thead><tbody>@foreach(var d in _devices){<tr><td><strong>@d.DisplayName</strong><br/><small class="text-muted">@d.InstallationId</small></td><td>@d.AppVersion</td><td>@d.LastSeenAtUtc.LocalDateTime.ToString("g")</td><td>@(d.IsActive ? "Aktif" : "Kaldırıldı")</td><td>@if(d.IsActive){<button class="btn btn-sm btn-outline-danger" @onclick="()=>RevokeAsync(d.Id)">Kaldır</button>}</td></tr>}</tbody></table></div></div> }
@code { [Parameter] public Guid TenantId {get;set;} bool _loading=true; ErpBridge.Admin.Api.TenantDto? _tenant; IReadOnlyList<ErpBridge.Admin.Api.MobileDeviceDto> _devices=Array.Empty<ErpBridge.Admin.Api.MobileDeviceDto>(); int _seatLimit; ErpBridge.Admin.Api.DeviceActivationCodeDto? _code; string? _error; protected override async Task OnParametersSetAsync()=>await LoadAsync(); async Task LoadAsync(){try{_tenant=await Api.GetTenantAsync(TenantId);_seatLimit=_tenant.DeviceSeatLimit;_devices=await Api.ListMobileDevicesAsync(TenantId);}catch(Exception e){_error=e.Message;}finally{_loading=false;}} async Task SaveSeatsAsync(){try{_tenant=await Api.UpdateDeviceSeatLimitAsync(TenantId,_seatLimit);}catch(Exception e){_error=e.Message;}} async Task CreateCodeAsync(){try{_code=await Api.CreateDeviceActivationCodeAsync(TenantId);}catch(Exception e){_error=e.Message;}} async Task RevokeAsync(Guid id){try{await Api.RevokeMobileDeviceAsync(id);await LoadAsync();}catch(Exception e){_error=e.Message;}} }
