    /// <summary>The copy request, or null (with <see cref="PortalPageBase.Error"/> set) when the percentage does not read.</summary>
    private TargetCopyRequest? CopyRequest(bool apply)
    {
        var percent = string.IsNullOrWhiteSpace(_copyPercent) ? 0m : ParseSigned(_copyPercent);
        if (percent is not (>= -100m and <= 1000m))
        {
            Error = "Değişim yüzdesi -100 ile 1000 arasında bir sayı olmalı (ör. 10 ya da -5).";
            return null;
        }
        return new TargetCopyRequest
        {
            PeriodType = _type,
            FromPeriodKey = TargetText.KeyOf(_type, TargetText.Shift(_type, _day, -1)),
            ToPeriodKey = TargetText.KeyOf(_type, _day),
            Percent = percent.Value,
            Overwrite = _copyOverwrite,
            Apply = apply,
            OperationId = Guid.NewGuid(),
        };
    }

    private async Task PreviewCopyAsync()
    {
        if (CopyRequest(false) is not { } request) return;
        await RunAsync(async () => _copyPreview = (await Api.CopyTargetsAsync(request)).Items);
    }

    private async Task ApplyCopyAsync()
    {
        if (CopyRequest(true) is not { } request) return;
        TargetPreviewResponse? response = null;
        await RunAsync(async () =>
        {
            response = await Api.CopyTargetsAsync(request);
            await LoadAsync();
        });
        if (response?.Result is { } result)
        {
            _copyOpen = false;
            Notice = result.Errors.Length > 0 ? null : $"{result.Saved} hedef kopyalandı.";
            if (result.Errors.Length > 0) Error = string.Join(" ", result.Errors.Select(e => e.Message));
        }
    }

    private void OpenDistribute()
    {
        _distPreview = null;
        _dist = new DistributeForm { Source = Owners.FirstOrDefault(o => o.OwnerKind != TargetOwners.User)?.Key ?? string.Empty };
        _distributeOpen = true;
    }

    private Task PreviewDistributeAsync() => RunAsync(async () =>
    {
        var source = Owners.FirstOrDefault(o => o.Key == _dist.Source);
        if (source is null)
        {
            Error = "Kaynak seçin.";
            return;
        }
        // A typo must not fall back to the source's own target (Codex, PR #216): only an empty field does.
        if (!string.IsNullOrWhiteSpace(_dist.Value) && ParseNumber(_dist.Value) is null)
        {
            Error = "Dağıtılacak değer okunamadı; boş bırakırsanız kaynağın hedefi dağıtılır.";
            return;
        }
        _distPreview = (await Api.DistributeTargetAsync(new TargetDistributeRequest
        {
            PeriodType = _type,
            PeriodKey = TargetText.KeyOf(_type, _day),
            Metric = _dist.Metric,
            SourceOwnerKind = source.OwnerKind,
            SourceOwnerId = source.OwnerKind == TargetOwners.Company ? null : source.OwnerId,
            Value = string.IsNullOrWhiteSpace(_dist.Value) ? null : ParseNumber(_dist.Value),
            Method = _dist.Method,
            TargetLevel = _dist.Level,
        })).Items;
    });

    /// <summary>The shares go into the grid as unsaved edits: the manager reviews them there and saves.</summary>
    private void TakeDistribution()
    {
        foreach (var item in _distPreview ?? [])
        {
            var key = item.OwnerKind == TargetOwners.Company ? TargetOwners.Company : $"{item.OwnerKind}:{item.OwnerId}";
            if (Owners.Any(o => o.Key == key)) Edit((key, item.Metric), Plain(item.Value ?? 0));
        }
        _distributeOpen = false;
        Notice = "Dağıtım tabloya aktarıldı; kontrol edip kaydedin.";
    }

    private async Task OpenImport()
    {
        _importItems = null;
        _importErrors.Clear();
        _importOpen = true;
        if (_people is null) await RunAsync(async () => _people = await Api.TeamsAsync());
    }

    private async Task ReadImportAsync(InputFileChangeEventArgs e)
    {
        _importItems = null;
        _importErrors.Clear();
        List<SpreadsheetReader.Row> rows;
        try
        {
            await using var stream = e.File.OpenReadStream(5 * 1024 * 1024);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            buffer.Position = 0;
            rows = SpreadsheetReader.Read(buffer, e.File.Name);
        }
        catch (Exception ex) when (ex is InvalidDataException or IOException)
        {
            _importErrors.Add("Dosya okunamadı: CSV ya da .xlsx olmalı, en çok 5 MB.");
            return;
        }
        _importItems = ParseImport(rows);
    }

    private List<TargetInput> ParseImport(List<SpreadsheetReader.Row> rows)
    {
        var items = new List<TargetInput>();
        foreach (var row in rows)
        {
            string Cell(int i) => i < row.Cells.Length ? row.Cells[i].Trim() : string.Empty;
            if (row.Number == 1 && Normalize(Cell(0)) is "kim" or "sahip") continue;
            var (owner, ownerError) = ResolveOwner(Cell(0));
            var metric = ResolveMetric(Cell(1));
            if (owner is null) { _importErrors.Add($"Satır {row.Number}: {ownerError}"); continue; }
            if (metric is null) { _importErrors.Add($"Satır {row.Number}: tür '{Cell(1)}' tanınmadı."); continue; }
            var itemCode = Cell(3);
            if (TargetText.ItemMetrics.Contains(metric) && itemCode.Length == 0) { _importErrors.Add($"Satır {row.Number}: kalem kodu boş."); continue; }
            if (ParseNumber(Cell(4)) is not { } value) { _importErrors.Add($"Satır {row.Number}: hedef '{Cell(4)}' okunamadı."); continue; }
            var measure = Normalize(Cell(2)) switch { "" => null, "miktar" or "quantity" => "QUANTITY", "tutar" or "amount" => AmountMeasure, _ => "?" };
            if (measure == "?") { _importErrors.Add($"Satır {row.Number}: ölçü '{Cell(2)}' tanınmadı (Tutar ya da Miktar)."); continue; }
            items.Add(Input(owner, metric, TargetText.ItemMetrics.Contains(metric) ? measure : null, TargetText.ItemMetrics.Contains(metric) ? itemCode : null, null, value));
        }
        return items;
    }

    /// <summary>
    /// The owner a cell names: "Firma", a username (unique), or a full name / team / region name that names exactly one —
    /// two people, or a team and a region, with the same name are refused, not guessed (Codex, PR #216).
    /// </summary>
    private (OwnerProgressDto? Owner, string? Error) ResolveOwner(string text)
    {
        var wanted = Normalize(text);
        if (wanted.Length == 0) return (null, "'Kim' boş.");
        if (wanted is "firma" or "firma geneli" or "company")
            return Owners.FirstOrDefault(o => o.OwnerKind == TargetOwners.Company) is { } company ? (company, null) : (null, "Firma geneli hedefi giremezsiniz.");
        if (_people?.People.FirstOrDefault(p => Normalize(p.Username) == wanted) is { } byUsername)
            return Visible(byUsername.Id, text);

        var people = _people?.People.Where(p => Normalize(p.FullName) == wanted).Select(p => p.Id).ToList() ?? [];
        var teams = Owners.Where(o => o.OwnerKind == TargetOwners.Team && Normalize(o.Name) == wanted).ToList();
        if (people.Count + teams.Count > 1) return (null, $"'{text}' birden çok kişi ya da ekiple eşleşiyor; kullanıcı adını yazın.");
        if (people.Count == 1) return Visible(people[0], text);
        if (teams.Count == 1) return (teams[0], null);
        return (null, $"'{text}' bulunamadı.");
    }

    private (OwnerProgressDto? Owner, string? Error) Visible(Guid userId, string text) =>
        Owners.FirstOrDefault(o => o.OwnerKind == TargetOwners.User && o.OwnerId == userId) is { } owner
            ? (owner, null)
            : (null, $"'{text}' sizin sorumluluğunuzda değil.");

    private static string? ResolveMetric(string text) => Normalize(text) switch
    {
        "ciro" or "revenue" => TargetText.Revenue,
        "tahsilat" or "collection" => TargetText.Collection,
        "ziyaret" or "visit" => TargetText.Visit,
        "fiş adedi" or "fis adedi" or "fiş" or "document_count" => TargetText.DocumentCount,
        "ürün" or "urun" or "product" => TargetText.Product,
        "kategori" or "category" => TargetText.Category,
        "alt kategori" or "sub_category" => TargetText.SubCategory,
        "marka" or "brand" => TargetText.Brand,
        _ => null,
    };

    private static string Normalize(string? text) => (text ?? string.Empty).Trim().ToLower(Fmt.Turkish);

