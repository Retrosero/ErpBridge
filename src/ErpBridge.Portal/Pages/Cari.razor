@page "/cari"
@inherits PortalPageBase

<PageTitle>@(_card?.Title ?? "Cari") — Yönetim Paneli</PageTitle>

@if (!Ready)
{
    <PageLoading />
}
else
{
    <PageHeader Title="@(_card?.Title ?? _code ?? "Cari")" Eyebrow="Cari ekstresi" Subtitle="@_card?.CustomerCode" Busy="Busy">
        <Actions>
            @if (Session.CanEditNativeData && _card is not null)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Rounded.CallReceived" OnClick="@(() => OpenPayment(collection: true))" id="customer-collect">Tahsilat al</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Rounded.CallMade" OnClick="@(() => OpenPayment(collection: false))" id="customer-pay">Ödeme yap</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Rounded.Balance" OnClick="OpenAdjustment" id="customer-adjust">Manuel düzeltme</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Edit" OnClick="OpenEditCard" id="customer-edit">Düzenle</MudButton>
            }
            <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.ArrowBack" Href="@BackHref" id="customer-back">Carilere dön</MudButton>
        </Actions>
    </PageHeader>

    <ErpReadOnlyNote Text="Bu cari ve hareketleri ERP'den gelir; tahsilat, ödeme, düzeltme ve kart değişikliği ERP'de yapılır." />

    @if (Error is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="page-alert" id="page-error">@Error</MudAlert>
    }
    @if (Notice is not null)
    {
        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="page-alert" id="page-notice">@Notice</MudAlert>
    }

    @if (_card is not null)
    {
        <MudPaper Outlined="true" Class="panel customer-card" id="customer-card">
            <div class="customer-card-balance">
                <span class="field-label">Güncel bakiye</span>
                <strong class="@(_card.Balance < 0 ? "portal-negative" : null)" id="customer-balance">@Fmt.Money(_card.Balance)</strong>
                <small class="text-muted">@(_card.Balance > 0 ? "firmanın alacağı" : _card.Balance < 0 ? "firmanın borcu" : "bakiye yok")</small>
                @if (_card.IsLocked)
                {
                    <span class="badge badge--off">Kilitli</span>
                }
            </div>
            <dl class="detail-facts customer-facts">
                @Fact("Telefon", _card.Phone)
                @Fact("E-posta", _card.Email)
                @Fact("Vergi dairesi / no", Join(_card.TaxOffice, _card.TaxNo))
                @Fact("Adres", _card.Address)
                @Fact("Plasiyer", _card.SalespersonCode)
                @Fact("Bölge / grup", Join(_card.RegionCode, _card.GroupCode))
            </dl>
        </MudPaper>

        <div class="ledger-toolbar">
            <label class="inline-field">
                Başlangıç
                <input type="date" class="portal-input portal-input--date" id="ledger-from" value="@Iso(_from)" @onchange="FromChangedAsync" disabled="@Busy" />
            </label>
            <label class="inline-field">
                Bitiş
                <input type="date" class="portal-input portal-input--date" id="ledger-to" value="@Iso(_to)" @onchange="ToChangedAsync" disabled="@Busy" />
            </label>
            <span class="ledger-presets">
                <button type="button" class="link-button" data-preset="year" @onclick="() => PresetAsync(new DateOnly(Today.Year, 1, 1), Today)">Bu yıl</button>
                <button type="button" class="link-button" data-preset="3m" @onclick="() => PresetAsync(Today.AddMonths(-3), Today)">Son 3 ay</button>
                <button type="button" class="link-button" data-preset="all" @onclick="() => PresetAsync(null, null)">Tümü</button>
            </span>
        </div>
        <div class="filter-chips" id="ledger-kinds" role="group" aria-label="Hareket türü">
            @foreach (var (kind, label) in KindLabels)
            {
                var on = _kinds.Contains(kind);
                <button type="button" class="kind-toggle @(on ? "is-active" : null)" aria-pressed="@(on ? "true" : "false")" data-kind="@kind" disabled="@Busy" @onclick="() => ToggleKindAsync(kind)">@label</button>
            }
            @if (_kinds.Count > 0)
            {
                <button type="button" class="link-button" id="ledger-kinds-clear" @onclick="ClearKindsAsync">Tüm türler</button>
            }
            @if (Session.CanEditNativeData)
            {
                <button type="button" class="kind-toggle @(_includeVoided ? "is-active" : null)" aria-pressed="@(_includeVoided ? "true" : "false")"
                        id="ledger-include-voided" disabled="@Busy" @onclick="ToggleIncludeVoidedAsync">İptal edilenleri göster</button>
            }
        </div>
    }

    @if (_ledger is not null)
    {
        <section class="stat-grid stat-grid--four">
            <StatCard Id="ledger-opening" Label="Devir" Value="@Fmt.Money(_ledger.Opening)" Caption="@(_from is null ? "ilk hareketten önce" : $"{_from.Value.ToString("dd.MM.yyyy", Fmt.Turkish)} öncesi")" Icon="@Icons.Material.Rounded.History" Tone="primary" />
            <StatCard Id="ledger-debit" Label="Borç" Value="@Fmt.Money(_ledger.TotalDebit)" Caption="satış, iade ödemesi…" Icon="@Icons.Material.Rounded.CallReceived" Tone="warning" />
            <StatCard Id="ledger-credit" Label="Alacak" Value="@Fmt.Money(_ledger.TotalCredit)" Caption="tahsilat, iade…" Icon="@Icons.Material.Rounded.CallMade" Tone="success" />
            <StatCard Id="ledger-closing" Label="Dönem sonu" Value="@Fmt.Money(_ledger.Closing)" Icon="@Icons.Material.Rounded.AccountBalanceWallet" Tone="violet" />
        </section>

        <MudPaper Outlined="true" Class="panel panel--table mt-3">
            @if (_ledger.Items.Count == 0)
            {
                <EmptyState Id="ledger-empty" Icon="@Icons.Material.Rounded.ReceiptLong" Title="Bu aralıkta hareket yok." Hint="Tarih aralığını genişletin ya da tür filtresini kaldırın." />
            }
            else
            {
                <div class="table-scroll">
                    <table class="data-table data-table--plain" id="ledger-table">
                        <thead>
                            <tr>
                                <th>Tarih</th>
                                <th>Tür</th>
                                <th>Belge no</th>
                                <th>Açıklama</th>
                                <th class="num">Borç</th>
                                <th class="num">Alacak</th>
                                <th class="num">Bakiye</th>
                                @if (Session.CanEditNativeData)
                                {
                                    <th>İşlemler</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _ledger.Items)
                            {
                                var opens = row.DocumentKey is not null;
                                var historyEntity = LedgerEntityOf(row);
                                <tr data-movement="@row.Id" class="@(opens ? "row-clickable" : null) @(row.Voided ? "is-voided" : null)" @onclick="() => OpenAsync(row)" title="@(opens ? "Kalemleri göster" : null)">
                                    <td class="nowrap">@DayText(row.Date)</td>
                                    <td>
                                        <span class="badge badge--@KindTone(row.Kind)">@KindLabel(row)</span>
                                        @if (opens)
                                        {
                                            <MudIcon Icon="@Icons.Material.Rounded.ListAlt" Size="Size.Small" Class="ledger-open-icon" />
                                        }
                                        @if (row.Voided)
                                        {
                                            <div class="cell-sub">İptal: @row.Reason</div>
                                        }
                                    </td>
                                    <td class="mono">@(row.DocumentNo ?? "—")</td>
                                    <td class="wrap">@row.Description</td>
                                    <td class="num">@(row.Debit == 0 ? null : Fmt.Money(row.Debit))</td>
                                    <td class="num">@(row.Credit == 0 ? null : Fmt.Money(row.Credit))</td>
                                    <td class="num @(row.Balance < 0 ? "portal-negative" : null)">@Fmt.Money(row.Balance)</td>
                                    @if (Session.CanEditNativeData)
                                    {
                                        <td class="ledger-row-actions" @onclick:stopPropagation="true">
                                            @if (row.Editable)
                                            {
                                                <button type="button" class="link-button" data-action="edit" @onclick="() => OpenEditMovement(row)">Düzenle</button>
                                                <button type="button" class="link-button" data-action="void" @onclick="() => OpenVoidMovement(row)">İptal et</button>
                                            }
                                            @if (historyEntity is not null)
                                            {
                                                <a class="link-button" href="@($"denetim?entity={historyEntity}")" target="_blank" data-action="history">Geçmiş</a>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            <Pager Id="ledger-pager" Page="_page" PageSize="_pageSize" Total="_ledger.Total" Busy="Busy" Unit="hareket"
                   PageChanged="GoToAsync" PageSizeChanged="PageSizeAsync" />
        </MudPaper>
        <MudText Typo="Typo.caption" Class="text-muted page-footnote">
            En yeni hareket en üstte. Bakiye kolonu tür filtresinden bağımsız olarak tüm hareketlere göre yürür; bitiş tarihi seçilmediyse güncel cari bakiyesinde biter.
        </MudText>
    }

    <DetailSheet Id="document-detail" Open="_documentOpen" Busy="_documentBusy" Eyebrow="@(_opened is null ? "Belge" : KindLabel(_opened))"
                 Title="@(_opened?.DocumentNo ?? "Belge")" OnClose="CloseDocument">
        @if (_documentError is not null)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="page-alert" id="document-error">@_documentError</MudAlert>
        }
        @if (_document is { } document)
        {
            <div class="detail-summary">
                <div class="detail-amount" id="document-amount">@Fmt.Money(document.Amount)</div>
                <dl class="detail-facts">
                    <dt>Tarih</dt><dd>@DayText(document.Date)</dd>
                    @if (!string.IsNullOrWhiteSpace(document.Description))
                    {
                        <dt>Açıklama</dt><dd>@document.Description</dd>
                    }
                    <dt>Kalem</dt><dd>@document.Lines.Count</dd>
                </dl>
            </div>
            @if (!document.LinesAvailable)
            {
                <EmptyState Id="document-no-lines" Icon="@Icons.Material.Rounded.ListAlt" Title="Bu belgenin kalem bilgisi yok." />
            }
            else
            {
                <div class="table-scroll">
                    <table class="data-table detail-lines" id="document-lines">
                        <thead>
                            <tr>
                                <th>Kod</th>
                                <th>Ürün</th>
                                <th class="num">Miktar</th>
                                <th class="num">Birim fiyat</th>
                                @if (document.Lines.Any(l => l.Tax is not null and not 0))
                                {
                                    <th class="num">KDV</th>
                                }
                                <th class="num">Tutar</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in document.Lines)
                            {
                                <tr data-line="@line.StockCode">
                                    <td class="mono">@line.StockCode</td>
                                    <td class="cell-title">
                                        @(line.Name ?? "—")
                                        @if (line.Description is not null)
                                        {
                                            <div class="text-muted detail-line-note">@line.Description</div>
                                        }
                                    </td>
                                    <td class="num">@Fmt.Quantity(line.Quantity)</td>
                                    <td class="num">@Fmt.Money(line.UnitPrice)</td>
                                    @if (document.Lines.Any(l => l.Tax is not null and not 0))
                                    {
                                        <td class="num">@(line.Tax is { } tax ? Fmt.Money(tax) : "—")</td>
                                    }
                                    <td class="num">@Fmt.Money(line.Amount)</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th colspan="@(document.Lines.Any(l => l.Tax is not null and not 0) ? 5 : 4)">Kalemler toplamı</th>
                                <th class="num" id="document-lines-total">@Fmt.Money(document.Lines.Sum(l => l.Amount))</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
            @if (Session.CanEditNativeData)
            {
                <div class="form-actions mt-3">
                    <a class="link-button" href="@($"evraklar?belge={Uri.EscapeDataString(document.DocumentKey)}")" id="document-open-in-documents">Evraklarda aç (düzenle · iptal · yazdır)</a>
                </div>
            }
        }
    </DetailSheet>

    @if (Session.CanEditNativeData)
    {
        <DetailSheet Id="customer-edit-sheet" Open="_editOpen" Busy="Busy" Eyebrow="Cari" Title="Müşteriyi düzenle" OnClose="CloseEditCard">
            <ChildContent>
                <form class="stack-form" id="customer-edit-form" @onsubmit="SaveEditCardAsync" @onsubmit:preventDefault>
                    <MudTextField T="string" @bind-Value="_editCard.CustomerCode" Label="Kod" Variant="Variant.Outlined" Margin="Margin.Dense" InputId="cedit-code" ReadOnly="true"
                                  HelperText="Kaydedildikten sonra değiştirilemez" />
                    <MudTextField T="string" @bind-Value="_editCard.Title" Label="Unvan" Variant="Variant.Outlined" Margin="Margin.Dense" InputId="cedit-title" Required="true" />
                    <MudTextField T="string" @bind-Value="_editCard.Phone" Label="Telefon" Variant="Variant.Outlined" Margin="Margin.Dense" InputId="cedit-phone" />
                    <MudTextField T="string" @bind-Value="_editCard.Email" Label="E-posta" Variant="Variant.Outlined" Margin="Margin.Dense" InputId="cedit-email" />
                    <MudTextField T="string" @bind-Value="_editCard.TaxOffice" Label="Vergi dairesi" Variant="Variant.Outlined" Margin="Margin.Dense" InputId="cedit-taxoffice" />
                    <MudTextField T="string" @bind-Value="_editCard.TaxNo" Label="Vergi no" Variant="Variant.Outlined" Margin="Margin.Dense" InputId="cedit-taxno" />
                    <MudTextField T="string" @bind-Value="_editCard.RegionCode" Label="Bölge" Variant="Variant.Outlined" Margin="Margin.Dense" InputId="cedit-region" />
                    <div class="form-actions">
                        <span style="flex: 1"></span>
                        <MudButton Variant="Variant.Text" Disabled="@Busy" OnClick="CloseEditCard">Vazgeç</MudButton>
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@Busy" id="customer-edit-save">Kaydet</MudButton>
                    </div>
                </form>
            </ChildContent>
        </DetailSheet>

        <DetailSheet Id="customer-payment-sheet" Open="_paymentOpen" Busy="Busy" Eyebrow="Cari" Title="@(_paymentIsCollection ? "Tahsilat al" : "Ödeme yap")" OnClose="ClosePayment">
            <ChildContent>
                <form class="stack-form" id="customer-payment-form" @onsubmit="SavePaymentAsync" @onsubmit:preventDefault>
                    <MudNumericField T="decimal?" @bind-Value="_payment.Amount" Label="Tutar" Variant="Variant.Outlined" Margin="Margin.Dense" id="payment-amount" Min="@(0.01m)" Adornment="Adornment.End" AdornmentText="TL" Required="true" />
                    <label class="stack-field">
                        <span class="field-label">Ödeme şekli</span>
                        <select class="portal-select" id="payment-type" value="@_payment.PaymentType" @onchange="e => _payment.PaymentType = e.Value?.ToString()">
                            @foreach (var type in PaymentTypes)
                            {
                                <option value="@type">@type</option>
                            }
                        </select>
                    </label>
                    <label class="stack-field">
                        <span class="field-label">Tarih</span>
                        <input type="date" class="portal-input" id="payment-date" value="@_paymentDate" @onchange="e => _paymentDate = e.Value?.ToString()" />
                    </label>
                    <MudTextField T="string" @bind-Value="_payment.Description" Label="Açıklama" Variant="Variant.Outlined" Margin="Margin.Dense" InputId="payment-description" Lines="2" />
                    <div class="form-actions">
                        <span style="flex: 1"></span>
                        <MudButton Variant="Variant.Text" Disabled="@Busy" OnClick="ClosePayment">Vazgeç</MudButton>
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="@(_paymentIsCollection ? Color.Success : Color.Error)" Disabled="@Busy" id="customer-payment-save">Kaydet</MudButton>
                    </div>
                </form>
            </ChildContent>
        </DetailSheet>

        <DetailSheet Id="customer-void-sheet" Open="_voidOpen" Busy="Busy" Eyebrow="Cari" Title="Hareketi iptal et" OnClose="CloseVoidMovement">
            <ChildContent>
                @if (_voiding is { } voiding)
                {
                    <form class="stack-form" id="customer-void-form" @onsubmit="ConfirmVoidAsync" @onsubmit:preventDefault>
                        <p class="text-muted">@KindLabel(voiding) · @DayText(voiding.Date) · @Fmt.Money(voiding.Debit + voiding.Credit)</p>
                        <MudTextField T="string" @bind-Value="_voidReason" Label="Gerekçe" Variant="Variant.Outlined" Margin="Margin.Dense" InputId="void-reason" Lines="2" Required="true" />
                        <div class="form-actions">
                            <span style="flex: 1"></span>
                            <MudButton Variant="Variant.Text" Disabled="@Busy" OnClick="CloseVoidMovement">Vazgeç</MudButton>
                            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Error" Disabled="@Busy" id="void-confirm">İptal et</MudButton>
                        </div>
                    </form>
                }
            </ChildContent>
        </DetailSheet>

        <DetailSheet Id="customer-edit-movement-sheet" Open="_editMovementOpen" Busy="Busy" Eyebrow="Cari" Title="Hareketi düzenle" OnClose="CloseEditMovement">
            <ChildContent>
                @if (_editingMovement is { } editing)
                {
                    <form class="stack-form" id="customer-edit-movement-form" @onsubmit="SaveEditMovementAsync" @onsubmit:preventDefault>
                        <p class="text-muted">@KindLabel(editing) · @DayText(editing.Date)</p>
                        <MudNumericField T="decimal?" @bind-Value="_editMovement.Amount" Label="Tutar" Variant="Variant.Outlined" Margin="Margin.Dense" InputId="edit-movement-amount" Min="@(0.01m)" Adornment="Adornment.End" AdornmentText="TL" Required="true" />
                        @if (_editingIsAdjustment)
                        {
                            <label class="stack-field">
                                <span class="field-label">Yön</span>
                                <select class="portal-select" id="edit-movement-debit" value="@(_editMovement.Debit == true ? "debit" : "credit")" @onchange="e => _editMovement.Debit = IsDebitOption(e.Value)">
                                    <option value="debit">Borç</option>
                                    <option value="credit">Alacak</option>
                                </select>
                            </label>
                            <MudTextField T="string" @bind-Value="_editMovement.Reason" Label="Düzeltmenin gerekçesi" Variant="Variant.Outlined" Margin="Margin.Dense" InputId="edit-movement-reason" Lines="2" Required="true" />
                        }
                        else
                        {
                            <label class="stack-field">
                                <span class="field-label">Ödeme şekli</span>
                                <select class="portal-select" id="edit-movement-payment-type" value="@_editMovement.PaymentType" @onchange="e => _editMovement.PaymentType = e.Value?.ToString()">
                                    @foreach (var type in PaymentTypes)
                                    {
                                        <option value="@type">@type</option>
                                    }
                                </select>
                            </label>
                            <MudTextField T="string" @bind-Value="_editMovement.Description" Label="Açıklama" Variant="Variant.Outlined" Margin="Margin.Dense" InputId="edit-movement-description" Lines="2" />
                        }
                        <label class="stack-field">
                            <span class="field-label">Tarih</span>
                            <input type="date" class="portal-input" id="edit-movement-date" value="@_editMovementDate" @onchange="e => _editMovementDate = e.Value?.ToString()" />
                        </label>
                        <MudTextField T="string" @bind-Value="_editMovement.VoidReason" Label="Neden düzenleniyor" Variant="Variant.Outlined" Margin="Margin.Dense" InputId="edit-movement-void-reason" Lines="2" Required="true" />
                        <div class="form-actions">
                            <span style="flex: 1"></span>
                            <MudButton Variant="Variant.Text" Disabled="@Busy" OnClick="CloseEditMovement">Vazgeç</MudButton>
                            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@Busy" id="edit-movement-save">Kaydet</MudButton>
                        </div>
                    </form>
                }
            </ChildContent>
        </DetailSheet>

        <DetailSheet Id="customer-adjustment-sheet" Open="_adjustmentOpen" Busy="Busy" Eyebrow="Cari" Title="Manuel düzeltme" OnClose="CloseAdjustment">
            <ChildContent>
                <form class="stack-form" id="customer-adjustment-form" @onsubmit="SaveAdjustmentAsync" @onsubmit:preventDefault>
                    <MudNumericField T="decimal?" @bind-Value="_adjustment.Amount" Label="Tutar" Variant="Variant.Outlined" Margin="Margin.Dense" InputId="adjustment-amount" Min="@(0.01m)" Adornment="Adornment.End" AdornmentText="TL" Required="true" />
                    <label class="stack-field">
                        <span class="field-label">Yön</span>
                        <select class="portal-select" id="adjustment-debit" value="@(_adjustment.Debit ? "debit" : "credit")" @onchange="e => _adjustment.Debit = IsDebitOption(e.Value)">
                            <option value="debit">Borç (cari daha çok borçlanır)</option>
                            <option value="credit">Alacak (cari daha az borçlanır)</option>
                        </select>
                    </label>
                    <MudTextField T="string" @bind-Value="_adjustment.Reason" Label="Gerekçe" Variant="Variant.Outlined" Margin="Margin.Dense" InputId="adjustment-reason" Lines="2" Required="true" />
                    <label class="stack-field">
                        <span class="field-label">Tarih</span>
                        <input type="date" class="portal-input" id="adjustment-date" value="@_adjustmentDate" @onchange="e => _adjustmentDate = e.Value?.ToString()" />
                    </label>
                    <div class="form-actions">
                        <span style="flex: 1"></span>
                        <MudButton Variant="Variant.Text" Disabled="@Busy" OnClick="CloseAdjustment">Vazgeç</MudButton>
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Secondary" Disabled="@Busy" id="customer-adjustment-save">Kaydet</MudButton>
                    </div>
                </form>
            </ChildContent>
        </DetailSheet>
    }
}

@code {
    protected override PortalArea Requires => PortalArea.Ledger;

    private static readonly (string Kind, string Label)[] KindLabels =
    [
        ("sale", "Satış"), ("sale_return", "Satış iadesi"), ("purchase", "Alış"), ("purchase_return", "Alış iadesi"),
        ("collection", "Tahsilat"), ("payment", "Tediye"), ("other", "Diğer"),
    ];

    private string? _code;
    private string? _listQuery;
    private DateOnly? _from;
    private DateOnly? _to;
    private readonly List<string> _kinds = [];
    private bool _includeVoided;
    private int _page = 1;
    private int _pageSize = 50;

    private CustomerCardDto? _card;
    private LedgerResponse? _ledger;

    private bool _documentOpen;
    private bool _documentBusy;
    private string? _documentError;
    private LedgerRowDto? _opened;
    private CustomerDocumentDto? _document;

    private static DateOnly Today => Fmt.Today();

    private string BackHref => "cariler" + (_listQuery ?? string.Empty);

    protected override void OnInitialized()
    {
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
        string? One(string name) => query.TryGetValue(name, out var v) && !string.IsNullOrWhiteSpace(v) ? v[^1]!.Trim() : null;
        _code = One("kod");
        _listQuery = One("liste") is { } list && list.StartsWith('?') ? list : null;
        // A statement opens on this year, the way accounting reads it; "hepsi" asks for every movement.
        var all = One("aralik") == "hepsi";
        _from = all ? null : Fmt.TryIsoDay(One("bas"), out var from) ? from : new DateOnly(Today.Year, 1, 1);
        _to = all ? null : Fmt.TryIsoDay(One("bit"), out var to) ? to : null;
        if (query.TryGetValue("tur", out var kinds))
            _kinds.AddRange(kinds.Where(k => KindLabels.Any(l => l.Kind == k)).Select(k => k!).Distinct());
        if (int.TryParse(One("sayfa"), out var page) && page > 0) _page = page;
        if (int.TryParse(One("boyut"), out var size) && Pager.Sizes.Contains(size)) _pageSize = size;
    }

    protected override async Task LoadAsync()
    {
        if (string.IsNullOrWhiteSpace(_code))
        {
            Nav.NavigateTo("cariler");
            return;
        }
        _card = await Api.CustomerCardAsync(_code);
        await LoadLedgerAsync();
    }

    private async Task LoadLedgerAsync()
    {
        _ledger = await Api.LedgerAsync(_code!, _from, _to, _kinds, _includeVoided, _page, _pageSize);
        if (_ledger.Items.Count == 0 && _ledger.Total > 0 && _page > 1)
        {
            _page = Math.Max(1, (int)Math.Ceiling(_ledger.Total / (double)_pageSize));
            _ledger = await Api.LedgerAsync(_code!, _from, _to, _kinds, _includeVoided, _page, _pageSize);
        }
        SyncAddress();
    }

    private Task ToggleIncludeVoidedAsync()
    {
        _includeVoided = !_includeVoided;
        return ReloadFromFirstPageAsync();
    }

    private void SyncAddress()
    {
        var parts = new List<string> { "kod=" + Uri.EscapeDataString(_code!) };
        if (_from is null && _to is null) parts.Add("aralik=hepsi");
        if (_from is { } from && from != new DateOnly(Today.Year, 1, 1)) parts.Add("bas=" + Fmt.IsoDay(from));
        if (_to is { } to) parts.Add("bit=" + Fmt.IsoDay(to));
        parts.AddRange(_kinds.Select(k => "tur=" + k));
        if (_page != 1) parts.Add("sayfa=" + _page);
        if (_pageSize != 50) parts.Add("boyut=" + _pageSize);
        if (_listQuery is not null) parts.Add("liste=" + Uri.EscapeDataString(_listQuery));
        Nav.NavigateTo(new Uri(Nav.Uri).GetLeftPart(UriPartial.Path) + "?" + string.Join("&", parts), new NavigationOptions { ReplaceHistoryEntry = true });
    }

    private Task ReloadFromFirstPageAsync()
    {
        _page = 1;
        return RunAsync(LoadLedgerAsync);
    }

    private Task FromChangedAsync(ChangeEventArgs e)
    {
        _from = Fmt.TryIsoDay(e.Value?.ToString(), out var day) ? day : null;
        return ReloadFromFirstPageAsync();
    }

    private Task ToChangedAsync(ChangeEventArgs e)
    {
        _to = Fmt.TryIsoDay(e.Value?.ToString(), out var day) ? day : null;
        return ReloadFromFirstPageAsync();
    }

    private Task PresetAsync(DateOnly? from, DateOnly? to)
    {
        _from = from;
        _to = to;
        return ReloadFromFirstPageAsync();
    }

    private Task ToggleKindAsync(string kind)
    {
        if (!_kinds.Remove(kind)) _kinds.Add(kind);
        return ReloadFromFirstPageAsync();
    }

    private Task ClearKindsAsync()
    {
        _kinds.Clear();
        return ReloadFromFirstPageAsync();
    }

    private Task GoToAsync(int page)
    {
        _page = page;
        return RunAsync(LoadLedgerAsync);
    }

    private Task PageSizeAsync(int size)
    {
        _pageSize = size;
        return ReloadFromFirstPageAsync();
    }

    private async Task OpenAsync(LedgerRowDto row)
    {
        if (row.DocumentKey is null) return;
        _opened = row;
        _document = null;
        _documentError = null;
        _documentOpen = true;
        _documentBusy = true;
        StateHasChanged();
        bool Current() => _documentOpen && ReferenceEquals(_opened, row);
        try
        {
            var document = await Api.CustomerDocumentAsync(_code!, row.DocumentKey);
            if (Current()) _document = document;
        }
        catch (PortalApiException failed)
        {
            if (Current()) _documentError = failed.Message;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            if (Current()) _documentError = "Sunucuya ulaşılamadı. Tekrar deneyin.";
        }
        catch (SessionEndedException)
        {
            _documentOpen = false;
            await RunAsync(LoadLedgerAsync);
        }
        finally
        {
            if (Current()) _documentBusy = false;
        }
        StateHasChanged();
    }

    private void CloseDocument()
    {
        _documentOpen = false;
        _opened = null;
        _document = null;
    }

    private static string KindLabel(LedgerRowDto row) =>
        row.Kind == "other" && !string.IsNullOrWhiteSpace(row.SourceType)
            ? row.SourceType!
            : KindLabels.FirstOrDefault(k => k.Kind == row.Kind).Label ?? row.Kind;

    private static string KindTone(string kind) => kind switch
    {
        "sale" => "primary",
        "collection" => "success",
        "sale_return" or "purchase_return" => "danger",
        "payment" or "purchase" => "warning",
        _ => "muted",
    };

    private static string? Iso(DateOnly? day) => day is { } d ? Fmt.IsoDay(d) : null;

    private static string DayText(string iso) =>
        Fmt.TryIsoDay(iso, out var day) ? day.ToString("dd.MM.yyyy", Fmt.Turkish) : iso;

    private static string? Join(string? a, string? b) =>
        string.Join(" / ", new[] { a, b }.Where(v => !string.IsNullOrWhiteSpace(v))) is { Length: > 0 } joined ? joined : null;

    private static RenderFragment Fact(string label, string? value) => __builder =>
    {
        if (string.IsNullOrWhiteSpace(value)) return;
        <dt>@label</dt>
        <dd>@value</dd>
    };

    // ---- düzenle (GOAL_PANEL_ERPSIZ E2b, ERP'siz firma) --------------------------

    private string? Notice { get; set; }
    private bool _editOpen;
    private NativeCustomerCardRequest _editCard = new();

    private void OpenEditCard()
    {
        if (_card is null) return;
        Notice = null;
        _editCard = new NativeCustomerCardRequest
        {
            CustomerCode = _card.CustomerCode,
            Title = _card.Title,
            Phone = _card.Phone,
            Email = _card.Email,
            TaxOffice = _card.TaxOffice,
            TaxNo = _card.TaxNo,
            RegionCode = _card.RegionCode,
            OperationId = Guid.NewGuid().ToString("N"),
        };
        _editOpen = true;
    }

    private void CloseEditCard() => _editOpen = false;

    private Task SaveEditCardAsync()
    {
        Notice = null;
        _editCard.Title = (_editCard.Title ?? string.Empty).Trim();
        var title = _editCard.Title;
        return RunAsync(async () =>
        {
            await Api.SaveNativeCustomerCardAsync(_editCard);
            _editOpen = false;
            await LoadAsync();
            Notice = $"{title} kaydedildi.";
        });
    }

    // ---- tahsilat / tediye (GOAL_PANEL_ERPSIZ E3b, ERP'siz firma) --------------------------

    private static readonly string[] PaymentTypes = ["Nakit", "Kredi Kartı", "EFT / Havale", "Çek", "Diğer"];

    private bool _paymentOpen;
    private bool _paymentIsCollection = true;
    private string? _paymentDate;
    private NativePaymentRequest _payment = new();

    private void OpenPayment(bool collection)
    {
        if (_card is null) return;
        Notice = null;
        Error = null;
        _paymentIsCollection = collection;
        _paymentDate = Fmt.IsoDay(Today);
        _payment = new NativePaymentRequest { CustomerCode = _card.CustomerCode, PaymentType = PaymentTypes[0], OperationId = Guid.NewGuid().ToString("N") };
        _paymentOpen = true;
    }

    private void ClosePayment() => _paymentOpen = false;

    private Task SavePaymentAsync()
    {
        Notice = null;
        if (_payment.Amount is not > 0)
        {
            Error = PortalMessages.For("INVALID_PAYMENT");
            return Task.CompletedTask;
        }
        _payment.OccurredAt = Fmt.TryIsoDay(_paymentDate, out var day) && day != Today ? Fmt.IsoDay(day) : null;
        var kind = _paymentIsCollection ? "Tahsilat" : "Ödeme";
        var amount = _payment.Amount;
        return RunAsync(async () =>
        {
            if (_paymentIsCollection) await Api.RecordNativeCollectionAsync(_payment);
            else await Api.RecordNativeDisbursementAsync(_payment);
            _paymentOpen = false;
            await LoadAsync();
            Notice = $"{kind}: {Fmt.Money(amount ?? 0)} kaydedildi.";
        });
    }

    // ---- hesap hareketi düzeltme/iptal/manuel düzeltme (GOAL_PANEL_ERPSIZ E4a/b/c/e, ERP'siz firma) ----

    /// <summary>Only for a movement E7b's audit trail can actually show history for (D5/D11): a standalone
    /// collection/disbursement/manual adjustment, whether editable now or already voided.</summary>
    private static string? LedgerEntityOf(LedgerRowDto row) => row switch
    {
        { Kind: "collection" } when row.Editable || row.Voided => "collection",
        { Kind: "payment" } when row.Editable || row.Voided => "disbursement",
        { Kind: "other", SourceType: "Düzeltme" } when row.Editable || row.Voided => "ledger_adjustment",
        _ => null,
    };

    private bool _voidOpen;
    private LedgerRowDto? _voiding;
    private string? _voidReason;

    private void OpenVoidMovement(LedgerRowDto row)
    {
        Notice = null;
        _voiding = row;
        _voidReason = null;
        _voidOpen = true;
    }

    private void CloseVoidMovement() => _voidOpen = false;

    private Task ConfirmVoidAsync()
    {
        Notice = null;
        if (string.IsNullOrWhiteSpace(_voidReason))
        {
            Error = "İptal için gerekçe gerekli.";
            return Task.CompletedTask;
        }
        var row = _voiding!;
        var reason = _voidReason!.Trim();
        return RunAsync(async () =>
        {
            await Api.VoidNativeLedgerEntryAsync(row.Id, new NativeLedgerVoidRequest { Reason = reason, OperationId = Guid.NewGuid().ToString("N") });
            _voidOpen = false;
            await LoadLedgerAsync();
            await ReloadCardAsync();
            Notice = "Hareket iptal edildi.";
        });
    }

    private bool _editMovementOpen;
    private LedgerRowDto? _editingMovement;
    private bool _editingIsAdjustment;
    private NativeLedgerEditRequest _editMovement = new();
    private string? _editMovementDate;

    private void OpenEditMovement(LedgerRowDto row)
    {
        Notice = null;
        _editingMovement = row;
        _editingIsAdjustment = row.Kind == "other";
        _editMovementDate = Fmt.IsoDay(Fmt.TryIsoDay(row.Date, out var day) ? day : Today);
        _editMovement = new NativeLedgerEditRequest
        {
            Amount = row.Debit + row.Credit,
            Debit = _editingIsAdjustment ? row.Debit > 0 : null,
            Description = _editingIsAdjustment ? null : row.Description,
            Reason = _editingIsAdjustment ? row.Description : null,
            OperationId = Guid.NewGuid().ToString("N"),
        };
        _editMovementOpen = true;
    }

    private void CloseEditMovement() => _editMovementOpen = false;

    private Task SaveEditMovementAsync()
    {
        Notice = null;
        if (_editMovement.Amount is not > 0)
        {
            Error = "Düzeltilmiş tutar gerekli.";
            return Task.CompletedTask;
        }
        if (string.IsNullOrWhiteSpace(_editMovement.VoidReason))
        {
            Error = "Düzenleme için gerekçe gerekli.";
            return Task.CompletedTask;
        }
        if (_editingIsAdjustment && string.IsNullOrWhiteSpace(_editMovement.Reason))
        {
            Error = "Düzeltmenin kendi gerekçesi gerekli.";
            return Task.CompletedTask;
        }
        var row = _editingMovement!;
        _editMovement.OccurredAt = Fmt.TryIsoDay(_editMovementDate, out var day) ? Fmt.IsoDay(day) : null;
        return RunAsync(async () =>
        {
            await Api.EditNativeLedgerEntryAsync(row.Id, _editMovement);
            _editMovementOpen = false;
            await LoadLedgerAsync();
            await ReloadCardAsync();
            Notice = "Hareket düzenlendi.";
        });
    }

    private bool _adjustmentOpen;
    private NativeLedgerAdjustmentRequest _adjustment = new();
    private string? _adjustmentDate;

    private void OpenAdjustment()
    {
        if (_card is null) return;
        Notice = null;
        Error = null;
        _adjustmentDate = Fmt.IsoDay(Today);
        _adjustment = new NativeLedgerAdjustmentRequest { CustomerCode = _card.CustomerCode, Debit = true, OperationId = Guid.NewGuid().ToString("N") };
        _adjustmentOpen = true;
    }

    private void CloseAdjustment() => _adjustmentOpen = false;

    private Task SaveAdjustmentAsync()
    {
        Notice = null;
        if (_adjustment.Amount is not > 0)
        {
            Error = "Tutar gerekli.";
            return Task.CompletedTask;
        }
        if (string.IsNullOrWhiteSpace(_adjustment.Reason))
        {
            Error = "Gerekçe gerekli.";
            return Task.CompletedTask;
        }
        _adjustment.OccurredAt = Fmt.TryIsoDay(_adjustmentDate, out var day) && day != Today ? Fmt.IsoDay(day) : null;
        var amount = _adjustment.Amount;
        return RunAsync(async () =>
        {
            await Api.PostNativeLedgerAdjustmentAsync(_adjustment);
            _adjustmentOpen = false;
            await LoadAsync();
            Notice = $"Manuel düzeltme: {Fmt.Money(amount ?? 0)} kaydedildi.";
        });
    }

    private async Task ReloadCardAsync() => _card = await Api.CustomerCardAsync(_code!);

    private static bool IsDebitOption(object? value) => value?.ToString() == "debit";
}
