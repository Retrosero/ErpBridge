@page "/"
@inject ErpBridge.Admin.Api.CentralApiClient Api
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Genel Bakış — ErpBridge Yönetim</PageTitle>
<AdminPageHeader Title="Genel bakış" Description="ERP bağlantılarınızın ve operasyon akışınızın güncel durumunu tek ekrandan izleyin.">
    <Actions><button class="btn btn-secondary" @onclick="LoadAsync" disabled="@_loading">↻ Yenile</button></Actions>
</AdminPageHeader>

@if (_loading) { <AdminLoading Text="Sistem durumu hazırlanıyor…" /> }
else if (!string.IsNullOrWhiteSpace(_error)) { <AdminState Tone="error" Icon="!" Title="Veriler alınamadı" Message="@_error" /> }
else {
    <section class="admin-grid admin-grid--stats" aria-label="Sistem özeti">
        <article class="admin-stat"><span class="admin-stat__label">Müşteriler</span><strong>@_tenants.Count</strong><small>@_tenants.Count(x => x.IsActive) aktif hesap</small></article>
        <article class="admin-stat admin-stat--success"><span class="admin-stat__label">Aktif lisanslar</span><strong>@_licenses.Count(x => x.IsActive)</strong><small>@_licenses.Count toplam lisans</small></article>
        <article class="admin-stat"><span class="admin-stat__label">Bağlı ajanlar</span><strong>@OnlineAgents</strong><small>@_agents.Count kayıtlı ajan</small></article>
        <article class="admin-stat @(_jobs.Any() ? "admin-stat--warning" : null)"><span class="admin-stat__label">Bekleyen işler</span><strong>@_jobs.Count</strong><small>İşlem kuyruğunda</small></article>
    </section>
    <div class="dashboard-layout">
        <section class="admin-panel"><header class="admin-panel__header"><div><h2>Operasyon sağlığı</h2><p>Dikkat gerektiren alanların kısa özeti</p></div></header><div class="admin-panel__body dashboard-health">
            <div class="dashboard-health__item"><span>Ajan bağlantıları</span><AdminStatusBadge Text="@(OnlineAgents == _agents.Count ? "Sağlıklı" : "Kontrol gerekli")" Tone="@(OnlineAgents == _agents.Count ? "success" : "warning")" /></div>
            <div class="dashboard-health__item"><span>İş kuyruğu</span><AdminStatusBadge Text="@(_jobs.Count == 0 ? "Temiz" : $"{_jobs.Count} bekliyor")" Tone="@(_jobs.Count == 0 ? "success" : "warning")" /></div>
            <div class="dashboard-health__item"><span>Lisans durumu</span><AdminStatusBadge Text="@(_licenses.Any(x => !x.IsActive) ? "Pasif kayıt var" : "Tümü aktif")" Tone="@(_licenses.Any(x => !x.IsActive) ? "muted" : "success")" /></div>
        </div></section>
        <section class="admin-panel"><header class="admin-panel__header"><div><h2>Hızlı işlemler</h2><p>Sık kullanılan yönetim alanları</p></div></header><div class="admin-panel__body dashboard-quick-links">
            <a class="dashboard-quick-link" href="tenants/create"><span>Yeni müşteri oluştur</span><span>→</span></a>
            <a class="dashboard-quick-link" href="licenses"><span>Lisansları yönet</span><span>→</span></a>
            <a class="dashboard-quick-link" href="jobs"><span>İş kuyruğunu aç</span><span>→</span></a>
        </div></section>
    </div>
}

@code {
    private bool _loading = true; private string? _error;
    private IReadOnlyList<TenantDto> _tenants = Array.Empty<TenantDto>();
    private IReadOnlyList<LicenseDto> _licenses = Array.Empty<LicenseDto>();
    private IReadOnlyList<AgentDto> _agents = Array.Empty<AgentDto>();
    private IReadOnlyList<JobDto> _jobs = Array.Empty<JobDto>();
    private int OnlineAgents => _agents.Count(a => a.LastHeartbeatAtUtc is not null && a.LastHeartbeatAtUtc > DateTimeOffset.UtcNow.AddMinutes(-5));
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync() { _loading = true; _error = null; try { var tenants=Api.ListTenantsAsync(); var licenses=Api.ListLicensesAsync(); var agents=Api.ListAgentsAsync(); var jobs=Api.ListJobsAsync("pending",200); await Task.WhenAll(tenants,licenses,agents,jobs); _tenants=await tenants; _licenses=await licenses; _agents=await agents; _jobs=await jobs; } catch(Exception ex) { _error=ex.Message; } finally { _loading=false; } }
}
