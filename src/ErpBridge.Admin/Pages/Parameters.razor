    /// <summary>
    /// Applies an exported file to the open scope.
    ///
    /// Matched by Mikro id rather than by the catalogue entry's own id: that id belongs to this
    /// installation, so a file from another environment would match nothing. An id the set does
    /// not declare is skipped and counted rather than dropped silently.
    /// </summary>
    private async Task ImportAsync()
    {
        if (SelectedSet is not { } set || _values is null) return;

        _saving = true;
        _saveMessage = null;
        _error = null;

        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(_importJson);

            if (!doc.RootElement.TryGetProperty("values", out var values)
                || values.ValueKind != System.Text.Json.JsonValueKind.Array)
            {
                _error = "Dosyada 'values' dizisi yok.";
                return;
            }

            var byId = _values.Items
                .GroupBy(i => i.ParametreId)
                .ToDictionary(g => g.Key, g => g.First().CatalogEntryId);

            var changes = new List<ParameterChangeDto>();
            var skipped = 0;

            foreach (var item in values.EnumerateArray())
            {
                if (!item.TryGetProperty("parametreId", out var idEl) || !idEl.TryGetInt32(out var id)
                    || !byId.TryGetValue(id, out var entryId))
                {
                    skipped++;
                    continue;
                }

                changes.Add(new ParameterChangeDto
                {
                    CatalogEntryId = entryId,
                    Value = item.TryGetProperty("value", out var v) ? v.GetString() ?? "" : "",
                });
            }

            if (changes.Count == 0)
            {
                _error = $"Uygulanacak parametre yok ({skipped} satır bu kümede tanınmadı).";
                return;
            }

            Guid? userId = Guid.TryParse(_mobileUserId, out var u) ? u : null;

            var response = await Api.SaveParameterValuesAsync(new ParameterWriteRequestDto
            {
                TenantId = Guid.Parse(_tenantId),
                ErpCompanyId = Guid.Parse(_erpCompanyId),
                MobileUserId = set.ScopeKind == ParameterScopeKindNames.MobileUser ? userId : null,
                Scope1 = string.IsNullOrWhiteSpace(_scope1) ? null : _scope1.Trim(),
                Scope2 = string.IsNullOrWhiteSpace(_scope2) ? null : _scope2.Trim(),
                Changes = [.. changes],
            });

            _saveMessage = $"{changes.Count} ayar uygulandı"
                + (skipped > 0 ? $", {skipped} satır bu kümede tanınmadığı için atlandı" : "")
                + $". Kapsam sürümü: {response.Revision}.";

            _importJson = string.Empty;
            await LoadValuesAsync();
        }
        catch (System.Text.Json.JsonException)
        {
            _error = "Girilen metin geçerli JSON değil.";
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _saving = false; }
    }

    private string _search = string.Empty;

    /// <summary>What the search matches, or everything when the box is empty.</summary>
    private IReadOnlyList<ParameterValueDto> Matches =>
        ParameterLayout.Search(_values?.Items ?? Array.Empty<ParameterValueDto>(), _search);

    /// <summary>
    /// Re-derives the tree from the matches, so the tree itself answers "where does this live?".
    /// Searching 1,801 parameters and then still having to guess the tab would be no help.
    /// </summary>
    private void OnSearch(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? string.Empty;

        var matches = Matches;
        _tabs = ParameterLayout.BuildTabs(matches);

        // Keep the open tab when it still has hits; otherwise fall back to the tree.
        if (_selectedTab is not null && Find(_tabs, _selectedTab) is { } still)
        {
            SelectTab(still);
        }
        else
        {
            _selectedTab = null;
            _groups = Array.Empty<ParameterLayout.FieldGroup>();
        }
    }

    private static ParameterLayout.TabNode? Find(IReadOnlyList<ParameterLayout.TabNode> nodes, string path)
    {
        foreach (var node in nodes)
        {
            if (node.Path == path) return node;
            if (Find(node.Children, path) is { } hit) return hit;
        }

        return null;
    }

    private RenderFragment RenderTab(ParameterLayout.TabNode node, int depth) => builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "prm-tab");
        builder.AddAttribute(2, "style", $"padding-left:{depth * 0.9m}rem");

        builder.OpenElement(3, "button");
        builder.AddAttribute(4, "type", "button");
        builder.AddAttribute(5, "class", node.Path == _selectedTab ? "prm-tab__link prm-tab__link--on" : "prm-tab__link");
        builder.AddAttribute(6, "onclick", EventCallback.Factory.Create(this, () => SelectTab(node)));
        builder.AddContent(7, node.Title);

        // The count is what makes a 63-tab tree navigable: it says where the work is.
        builder.OpenElement(8, "small");
        builder.AddAttribute(9, "class", "text-muted ms-2");
        builder.AddContent(10, node.TotalCount.ToString(System.Globalization.CultureInfo.InvariantCulture));
        builder.CloseElement();

        if (node.OverriddenCount > 0)
        {
            builder.OpenElement(11, "span");
            builder.AddAttribute(12, "class", "badge bg-warning text-dark ms-2");
            builder.AddAttribute(13, "title", "Bu sekmede varsayılanından ayrılmış ayar var");
            builder.AddContent(14, node.OverriddenCount.ToString(System.Globalization.CultureInfo.InvariantCulture));
            builder.CloseElement();
        }

        builder.CloseElement();
        builder.CloseElement();

        foreach (var child in node.Children)
        {
            builder.AddContent(15, RenderTab(child, depth + 1));
        }
    };

    /// <summary>Edits not yet written. Keyed by catalogue entry, which is the parameter's identity.</summary>
    private readonly Dictionary<Guid, string> _drafts = new();

    private bool _saving;
    private string? _saveMessage;

    private string Draft(ParameterValueDto field) =>
        _drafts.TryGetValue(field.CatalogEntryId, out var v) ? v : field.Value;

    private void SetDraft(ParameterValueDto field, string value)
    {
        // Typing a value back to what the server returned is not a change, so it leaves no draft
        // and no request: the server would answer "Unchanged" anyway.
        if (string.Equals(value, field.Value, StringComparison.Ordinal))
        {
            _drafts.Remove(field.CatalogEntryId);
            return;
        }

        _drafts[field.CatalogEntryId] = value;
    }

    /// <summary>
    /// Removes one parameter's stored row so its catalogue default applies again.
    ///
    /// Sent straight away rather than held as a draft: "put this back" is not the same decision as
    /// "I am editing this", and holding it would leave the field showing a value the operator has
    /// already asked to be rid of.
    /// </summary>
    private async Task RevertAsync(ParameterValueDto field)
    {
        if (SelectedSet is not { } set) return;

        _saving = true;
        _saveMessage = null;
        _error = null;

        try
        {
            Guid? userId = Guid.TryParse(_mobileUserId, out var u) ? u : null;

            var response = await Api.ResetParameterValuesAsync(new ParameterResetRequestDto
            {
                TenantId = Guid.Parse(_tenantId),
                ErpCompanyId = Guid.Parse(_erpCompanyId),
                MobileUserId = set.ScopeKind == ParameterScopeKindNames.MobileUser ? userId : null,
                Scope1 = string.IsNullOrWhiteSpace(_scope1) ? null : _scope1.Trim(),
                Scope2 = string.IsNullOrWhiteSpace(_scope2) ? null : _scope2.Trim(),
                CatalogEntryIds = [field.CatalogEntryId],
            });

            _drafts.Remove(field.CatalogEntryId);
            _saveMessage = $"{field.Label ?? field.Name} varsayılana döndü. Kapsam sürümü: {response.Revision}.";

            await LoadValuesAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _saving = false; }
    }

    /// <summary>VAT rates the pending batch would change, once the server has said so.</summary>
    private IReadOnlyList<string>? _pendingConfirmation;

    private void CancelConfirmation() => _pendingConfirmation = null;

    /// <summary>The value a named parameter currently holds, for the confirmation box.</summary>
    private string OldOf(string name) =>
        _values?.Items.FirstOrDefault(i => i.Name == name)?.Value ?? "";

    private string NewOf(string name)
    {
        var field = _values?.Items.FirstOrDefault(i => i.Name == name);
        return field is null ? "" : Draft(field);
    }

    private Task SaveAsync() => WriteDraftsAsync(confirmed: false);

    private Task ConfirmSaveAsync() => WriteDraftsAsync(confirmed: true);

    private async Task WriteDraftsAsync(bool confirmed)
    {
        if (_drafts.Count == 0 || SelectedSet is not { } set) return;

        _saving = true;
        _saveMessage = null;
        _error = null;

        try
        {
            Guid? userId = Guid.TryParse(_mobileUserId, out var u) ? u : null;

            var response = await Api.SaveParameterValuesAsync(new ParameterWriteRequestDto
            {
                TenantId = Guid.Parse(_tenantId),
                ErpCompanyId = Guid.Parse(_erpCompanyId),
                MobileUserId = set.ScopeKind == ParameterScopeKindNames.MobileUser ? userId : null,
                Scope1 = string.IsNullOrWhiteSpace(_scope1) ? null : _scope1.Trim(),
                Scope2 = string.IsNullOrWhiteSpace(_scope2) ? null : _scope2.Trim(),
                ConfirmSensitive = confirmed,
                Changes = _drafts.Select(d => new ParameterChangeDto
                {
                    CatalogEntryId = d.Key,
                    Value = d.Value,
                }).ToArray(),
            });

            var removed = response.Results.Count(r => r.Outcome == "Deleted");
            _saveMessage = removed > 0
                ? $"{response.Results.Length} değişiklik kaydedildi ({removed} tanesi varsayılana döndüğü için satır silindi). Kapsam sürümü: {response.Revision}."
                : $"{response.Results.Length} değişiklik kaydedildi. Kapsam sürümü: {response.Revision}.";

            _drafts.Clear();
            _picked.Clear();
            _pendingConfirmation = null;

            // A write has just happened or the scope changed; the loaded trail is stale either way.
            _history = null;

            // A write has just happened or the scope changed; the loaded trail is stale either way.
            _history = null;

            // Reload rather than patch in memory: the server decides whether a row exists, and the
            // "sapmış" marks have to match what it decided.
            await LoadValuesAsync();
        }
        catch (ApiCallException ex) when (ex.ErrorCode == "PARAMETER_CONFIRMATION_REQUIRED")
        {
            // Not a failure: the server is asking for the second step, and the drafts stay so the
            // operator can say yes without typing them again.
            _pendingConfirmation = _drafts.Keys
                .Select(id => _values?.Items.FirstOrDefault(i => i.CatalogEntryId == id))
                .Where(f => f is { ChangesAmounts: true })
                .Select(f => f!.Name)
                .OrderBy(n => n, StringComparer.Ordinal)
                .ToList();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _saving = false; }
    }

    private async Task LoadValuesAsync()
    {
        if (SelectedSet is not { } set || !CanLoad) return;

        _loading = true;
        _error = null;

        try
        {
            Guid? userId = Guid.TryParse(_mobileUserId, out var u) ? u : null;

            _values = await Api.ListParameterValuesAsync(
                Guid.Parse(_tenantId),
                Guid.Parse(_erpCompanyId),
                set.CatalogMethod,
                set.ScopeKind == ParameterScopeKindNames.MobileUser ? userId : null,
                string.IsNullOrWhiteSpace(_scope1) ? null : _scope1.Trim(),
                string.IsNullOrWhiteSpace(_scope2) ? null : _scope2.Trim(),
                _onlyOverridden);

            _tabs = ParameterLayout.BuildTabs(Matches);
            _drafts.Clear();

            var keep = _selectedTab;
            _selectedTab = null;
            _groups = Array.Empty<ParameterLayout.FieldGroup>();

            // Stay on the tab the operator was on: a save reloads, and being thrown back to the
            // tree after every change would make editing a long tab unbearable.
            var previous = keep is null ? null : Find(_tabs, keep);
            if (previous is not null)
            {
                SelectTab(previous);
            }
            else if (_tabs.Count == 1 && _tabs[0].Children.Count == 0)
            {
                // One tab means nothing to choose; open it so the fields are on screen at once.
                SelectTab(_tabs[0]);
            }
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }
