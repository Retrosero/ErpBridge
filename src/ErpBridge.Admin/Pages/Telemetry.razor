@page "/telemetry"
@inject ErpBridge.Admin.Api.CentralApiClient Api
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Mobil Tanılama — ErpBridge Yönetim</PageTitle>
<AdminPageHeader Title="Mobil tanılama" Description="Uygulamanın gizlilikten arındırılmış hata ve işlem kayıtları." />
<div class="admin-filter-bar mb-3 row g-2"><div class="col-auto"><select class="form-select" @bind="_tenantId"><option value="">Tüm müşteriler</option>@foreach (var tenant in _tenants) { <option value="@tenant.Id">@tenant.Name</option> }</select></div><div class="col-auto"><select class="form-select" @bind="_severity"><option value="ERROR">Hatalar</option><option value="FATAL">Kritik</option><option value="">Tümü</option></select></div><div class="col-auto"><button class="btn btn-primary" @onclick="ReloadAsync">Listele</button></div></div>

@if (_loading) { <AdminLoading Text="Mobil kayıtlar yükleniyor…" /> }
else if (!string.IsNullOrWhiteSpace(_error)) { <AdminState Tone="error" Icon="!" Title="Kayıtlar alınamadı" Message="@_error" /> }
else if (_events.Count == 0) { <AdminState Tone="empty" Icon="✓" Title="Kayıt bulunamadı" Message="Seçilen filtre için henüz mobil tanılama kaydı yok." /> }
else
{
    <div class="admin-record-list" aria-label="Mobil hata kayıtları">
        @foreach (var item in _events)
        {
            var expanded = _expandedId == item.Id;
            var presentation = Present(item);
            <article class="admin-record admin-record--error @(expanded ? "admin-record--expanded" : null)">
                <button class="admin-record__summary" @onclick="() => Toggle(item.Id)" aria-expanded="@expanded">
                    <span class="admin-record__primary"><strong>@presentation.Title</strong><span>@presentation.Summary</span></span><span class="admin-record__customer">@TenantName(item.TenantId)</span><code class="admin-record__code">@item.Severity</code><time datetime="@item.OccurredAtUtc.ToString("O")">@item.OccurredAtUtc.LocalDateTime.ToString("dd MMM yyyy, HH:mm")</time><span class="admin-record__chevron" aria-hidden="true">⌄</span>
                </button>
                @if (expanded) { <div class="admin-record__detail"><div class="admin-error-explainer"><strong>@presentation.Title</strong><p>@presentation.Detail</p><p><b>Önerilen işlem:</b> @presentation.Suggestion</p></div><dl class="admin-kv"><div><dt>Sürüm</dt><dd>@item.AppVersion</dd></div><div><dt>Cihaz</dt><dd>@item.DeviceModel / @item.AndroidVersion</dd></div></dl><details class="admin-technical-details"><summary>Teknik ayrıntıyı göster</summary><dl class="admin-kv"><div class="admin-kv__wide"><dt>Ham hata</dt><dd><code>@(string.IsNullOrWhiteSpace(item.ExceptionType) ? item.Message : $"{item.ExceptionType}: {item.Message}")</code></dd></div><div class="admin-kv__wide"><dt>İz kaydı</dt><dd><code>@item.StackTrace</code></dd></div></dl></details></div> }
            </article>
        }
    </div>
}

@code {
    private bool _loading = true; private string _tenantId = string.Empty; private string _severity = "ERROR"; private Guid? _expandedId; private string? _error;
    private IReadOnlyList<ErpBridge.Admin.Api.TenantDto> _tenants = Array.Empty<ErpBridge.Admin.Api.TenantDto>(); private IReadOnlyList<ErpBridge.Admin.Api.MobileTelemetryEventDto> _events = Array.Empty<ErpBridge.Admin.Api.MobileTelemetryEventDto>();
    protected override async Task OnInitializedAsync() { try { _tenants = await Api.ListTenantsAsync(); await ReloadAsync(); } catch (Exception ex) { _loading = false; _error = ex.Message; } }
    private async Task ReloadAsync() { _loading = true; _error = null; _expandedId = null; try { _events = await Api.ListTelemetryAsync(Guid.TryParse(_tenantId, out var id) ? id : null, _severity); } catch (Exception ex) { _error = ex.Message; } finally { _loading = false; } }
    private void Toggle(Guid id) => _expandedId = _expandedId == id ? null : id;
    private string TenantName(Guid id) => _tenants.FirstOrDefault(t => t.Id == id)?.Name ?? id.ToString()[..8];
    private static ErrorPresentation Present(ErpBridge.Admin.Api.MobileTelemetryEventDto item)
    {
        var raw = $"{item.ExceptionType} {item.Message}".ToLowerInvariant();
        if (raw.Contains("no jsonadapter") || raw.Contains("linkedhashmap") || raw.Contains("moshi"))
            return new("Belge verisi okunamadı", "Gönderilmek istenen belgedeki bir alan uygulama tarafından işlenemedi.", "Uygulamayı güncelleyin; devam ederse belgeyi yeniden kaydedip gönderin.");
        if (raw.Contains("timeout") || raw.Contains("timed out"))
            return new("Sunucuya zamanında ulaşılamadı", "Bağlantı süresi doldu; belge kaybolmadı ve kuyrukta yeniden denenebilir.", "İnternet bağlantısını kontrol edin ve kuyruktan tekrar deneyin.");
        if (raw.Contains("unauthorized") || raw.Contains("401") || raw.Contains("forbidden") || raw.Contains("403"))
            return new("Sunucu erişimi reddedildi", "Bu cihazın sunucu erişim bilgileri geçersiz veya süresi dolmuş olabilir.", "Ayarlar üzerinden senkronizasyon bağlantısını yenileyin.");
        return new("İşlem tamamlanamadı", "Uygulama bu işlemi tamamlayamadı; kayıt hata listesine alındı.", "Belgeyi ve bağlantıyı kontrol edip tekrar deneyin; sürerse teknik ayrıntıyı destek ekibiyle paylaşın.");
    }
    private sealed record ErrorPresentation(string Title, string Summary, string Detail, string Suggestion)
    {
        public ErrorPresentation(string title, string detail, string suggestion) : this(title, detail, detail, suggestion) { }
    }
}
