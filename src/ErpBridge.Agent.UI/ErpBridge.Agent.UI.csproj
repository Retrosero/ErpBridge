<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ErpBridge.Agent.UI</RootNamespace>
    <AssemblyName>ErpBridge.Agent.UI</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ErpBridge.Shared\ErpBridge.Shared.csproj" />
    <ProjectReference Include="..\ErpBridge.Core\ErpBridge.Core.csproj" />
    <ProjectReference Include="..\ErpBridge.LocalStore\ErpBridge.LocalStore.csproj" />
    <ProjectReference Include="..\ErpBridge.RemoteApi\ErpBridge.RemoteApi.csproj" />
    <ProjectReference Include="..\ErpBridge.Erp.Abstractions\ErpBridge.Erp.Abstractions.csproj" />
    <ProjectReference Include="..\ErpBridge.Erp.Mikro\ErpBridge.Erp.Mikro.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="H.NotifyIcon.Wpf" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationIcon Include="assets\icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="assets\icon.ico" />
    <Resource Include="assets\icon-256.png" />
    <Resource Include="assets\tray-32.png" />
  </ItemGroup>

  <!-- Microsoft.Data.SqlClient 5.x keeps a small platform-neutral guard
       assembly at publish root and the real Windows implementation under
       runtimes/win. A directly launched self-contained WPF publish can bind
       the guard first, producing "not supported on this platform". Flatten
       the Windows implementation into the publish root after publishing. -->
  <Target Name="UseWindowsSqlClientRuntime" AfterTargets="Publish"
          Condition="Exists('$(PublishDir)runtimes\win\lib\net6.0\Microsoft.Data.SqlClient.dll')">
    <Copy SourceFiles="$(PublishDir)runtimes\win\lib\net6.0\Microsoft.Data.SqlClient.dll"
          DestinationFiles="$(PublishDir)Microsoft.Data.SqlClient.dll" />
  </Target>

  <!--
    UI references Core/Shared/LocalStore/RemoteApi + Erp.Abstractions +
    ErpBridge.Erp.Mikro. The Mikro reference was added in Faz 2 Track 1 so
    the WPF "Bağlantıyı test et" action can resolve an
    IErpAdapterFactory and run MikroAdapter.TestConnectionAsync via the
    AddErpBridgeMikro DI registration. Core still does not reference Mikro
    (architectural rule, SKILL.md section 3 rule 1); only the UI does.
  -->

</Project>
