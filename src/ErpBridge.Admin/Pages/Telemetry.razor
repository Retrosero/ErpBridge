@page "/telemetry"
@inject ErpBridge.Admin.Api.CentralApiClient Api
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Mobil Tanılama — ErpBridge Yönetim</PageTitle>
<AdminPageHeader Title="Mobil tanılama" Description="Uygulamanın gizlilikten arındırılmış hata ve işlem kayıtları." />

<div class="admin-filter-bar mb-3 row g-2">
    <div class="col-auto"><select class="form-select" @bind="_tenantId"><option value="">Tüm müşteriler</option>@foreach (var tenant in _tenants) { <option value="@tenant.Id">@tenant.Name</option> }</select></div>
    <div class="col-auto"><select class="form-select" @bind="_severity"><option value="ERROR">Hatalar</option><option value="FATAL">Kritik</option><option value="">Tümü</option></select></div>
    <div class="col-auto"><button class="btn btn-primary" @onclick="ReloadAsync">Listele</button></div>
</div>

@if (_loading) { <AdminLoading Text="Mobil kayıtlar yükleniyor…" /> }
else if (!string.IsNullOrWhiteSpace(_error)) { <AdminState Tone="error" Icon="!" Title="Kayıtlar alınamadı" Message="@_error" /> }
else if (_events.Count == 0) { <AdminState Tone="empty" Icon="✓" Title="Kayıt bulunamadı" Message="Seçilen filtre için henüz mobil tanılama kaydı yok." /> }
else { <div class="admin-data-surface"><table class="table admin-data-table"><thead><tr><th>Zaman</th><th>Müşteri</th><th>Seviye</th><th>Ekran / işlem</th><th>Hata</th><th>Sürüm</th></tr></thead><tbody>
@foreach (var item in _events) { <tr><td data-label="Zaman">@item.OccurredAtUtc.LocalDateTime.ToString("dd MMM HH:mm")</td><td data-label="Müşteri">@TenantName(item.TenantId)</td><td data-label="Seviye"><strong>@item.Severity</strong></td><td data-label="Ekran / işlem">@item.Screen<br /><small>@item.Operation</small></td><td data-label="Hata">@(string.IsNullOrWhiteSpace(item.ExceptionType) ? item.Message : $"{item.ExceptionType}: {item.Message}")</td><td data-label="Sürüm">@item.AppVersion</td></tr> }
</tbody></table></div> }

@code {
    private bool _loading = true;
    private string _tenantId = string.Empty;
    private string _severity = "ERROR";
    private string? _error;
    private IReadOnlyList<ErpBridge.Admin.Api.TenantDto> _tenants = Array.Empty<ErpBridge.Admin.Api.TenantDto>();
    private IReadOnlyList<ErpBridge.Admin.Api.MobileTelemetryEventDto> _events = Array.Empty<ErpBridge.Admin.Api.MobileTelemetryEventDto>();
    protected override async Task OnInitializedAsync() { try { _tenants = await Api.ListTenantsAsync(); await ReloadAsync(); } catch (Exception ex) { _loading = false; _error = ex.Message; } }
    private async Task ReloadAsync() { _loading = true; _error = null; try { _events = await Api.ListTelemetryAsync(Guid.TryParse(_tenantId, out var id) ? id : null, _severity); } catch (Exception ex) { _error = ex.Message; } finally { _loading = false; } }
    private string TenantName(Guid id) => _tenants.FirstOrDefault(t => t.Id == id)?.Name ?? id.ToString()[..8];
}
