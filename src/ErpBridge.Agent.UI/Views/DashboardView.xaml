<UserControl x:Class="ErpBridge.Agent.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ErpBridge.Agent.UI.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             Background="{DynamicResource WindowBackgroundBrush}">

    <!--
        Tek tablo yerleşimi. Önceden üç ayrı blok vardı — tablo başına gönder
        butonları, MikroDB satır sayıları ve son çalıştırma özeti — aynı 13
        varlığı üç kez listeliyorlardı. Operatörün sorduğu soru ("MikroDB'de
        kaç satır var, son gönderimde kaçı gitti, tekrar göndereyim mi?") tek
        satırda cevaplanıyor artık. Son senkronizasyon zamanı bu ekrandan
        kaldırıldı; alt durum çubuğunun sağında sürekli görünüyor.
    -->
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ Başlık + birincil aksiyonlar ============ -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Dashboard"
                               FontSize="22" FontWeight="SemiBold"
                               Foreground="{DynamicResource HeaderBrush}"
                               VerticalAlignment="Center" />
                    <Border Background="{Binding StatusBadgeBrush}"
                            CornerRadius="9"
                            Padding="9,2"
                            Margin="12,2,0,0"
                            VerticalAlignment="Center"
                            ToolTip="Senkronizasyon gecikmesi / sağlık durumu">
                        <TextBlock Text="{Binding StatusBadgeText}"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   FontSize="11" />
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding NextEligibleRunDisplay}"
                           Style="{StaticResource CardCaptionStyle}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Senkronize Et"
                        Command="{Binding RunSyncDeltaCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="126" Padding="14,7" Margin="0,0,8,0"
                        ToolTip="Son sync'ten bu yana değişen INSERT/UPDATE/DELETE satırlarını gönderir." />
                <Button Content="Bootstrap"
                        Command="{Binding RunBootstrapCommand}"
                        Style="{StaticResource TintedButtonStyle}"
                        MinWidth="106" Padding="14,7" Margin="0,0,8,0"
                        ToolTip="Tüm referans veriyi baştan okuyup gönderir (60 dk idempotency penceresini bypass eder)." />
                <Button Content="Sıfırdan Kur"
                        Command="{Binding RebuildSnapshotCommand}"
                        MinWidth="112" Padding="14,7" Margin="0,0,8,0"
                        ToolTip="Sunucudaki snapshot'ı silip Mikro'dan baştan kurar. ERP'de silinmiş kayıtlar mobilde görünmeye devam ediyorsa bunu kullanın." />
                <Button Content="Yenile"
                        Command="{Binding RefreshCommand}"
                        MinWidth="84" Padding="14,7"
                        ToolTip="Ekrandaki durum bilgilerini tazeler." />
            </StackPanel>
        </Grid>

        <!-- ============ Hata bandı — yalnızca hata varken ============ -->
        <Border Grid.Row="1"
                Background="{DynamicResource WarningLightBrush}"
                BorderBrush="{DynamicResource WarningBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14,10"
                Margin="0,0,0,14"
                Visibility="{Binding LastErrorDisplay, Converter={StaticResource StringToVisibilityConverter}}">
            <TextBlock Text="{Binding LastErrorDisplay}"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="{DynamicResource WarningBrush}" />
        </Border>

        <!-- ============ Veri tablosu ============ -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="20,16,20,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Kart başlığı + sayıları tazeleme aksiyonu -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Veri Tabloları" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Style="{StaticResource CardCaptionStyle}"
                                   Text="MikroDB'deki canlı satır sayısı ile son gönderimde aktarılan satır sayısını karşılaştırır. Bir satır 0 gönderildiyse kaynağın gerçekten boş mu olduğunu buradan ayırt edebilirsiniz." />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Sayıları Al"
                            Command="{Binding CheckMikroRowCountsCommand}"
                            MinWidth="104" Padding="12,6"
                            VerticalAlignment="Top"
                            Margin="16,0,0,0"
                            ToolTip="Tüm Mikro tablolarında SELECT COUNT(*) çalıştırır." />
                </Grid>

                <!-- Sütun başlıkları. Sağdaki 17px, aşağıdaki ScrollViewer'ın
                     her zaman görünür dikey çubuğunun genişliği — ayrılmazsa
                     başlıklar veri sütunlarına göre kayıyor. -->
                <Grid Grid.Row="1" Margin="0,16,17,0">
                    <!-- Isim sutunu siniri: yildiz genislik tam ekranda tum
                         bosluğu yutup sayi ve aksiyon sutunlarini sag kenara
                         sikistiriyordu. MaxWidth ile tablo sola toplaniyor. -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="380" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="TABLO" Style="{StaticResource TableHeaderCellStyle}" />
                    <TextBlock Grid.Column="1" Text="MIKRODB" Style="{StaticResource TableHeaderCellStyle}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="2" Text="SON GÖNDERİM" Style="{StaticResource TableHeaderCellStyle}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="" Style="{StaticResource TableHeaderCellStyle}" />
                    <Border Grid.ColumnSpan="5" Style="{StaticResource TableRowDividerStyle}" Margin="0,0,0,-6" />
                </Grid>

                <!-- Satırlar. Her satır: etiket + Mikro tablo adı (alt satır),
                     canlı sayı, son gönderim sayısı, varsa tekil gönder aksiyonu.
                     Ayrı push komutu olmayan varlıklar (adres, yetkili, barkod,
                     satış şartı) ana varlıkla birlikte gider; aksiyon sütununda
                     bunu söyleyen soluk bir not durur. -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" Margin="0,10,0,0">
                    <Grid>
                        <!-- Basliktaki sutun genislikleriyle birebir ayni
                             kalmali; yoksa basliklar verilerden kayar. -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="380" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                        </Grid.RowDefinitions>

                        <!-- 1 · Cariler -->
                        <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Cariler" Style="{StaticResource TableLabelCellStyle}" />
                            <TextBlock Text="CARI_HESAPLAR" Style="{StaticResource TableSubLabelCellStyle}" />
                        </StackPanel>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding MikroCustomersCountDisplay}" Style="{StaticResource TableNumberCellStyle}" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding LastCustomersCountDisplay}" Style="{StaticResource TableNumberCellStyle}" />
                        <Button Grid.Row="0" Grid.Column="3" Content="Gönder" Command="{Binding PushCustomersCommand}" Style="{StaticResource RowActionButtonStyle}" HorizontalAlignment="Right" />
                        <Border Grid.Row="0" Grid.ColumnSpan="5" Style="{StaticResource TableRowDividerStyle}" />

                        <!-- 2 · Cari adresleri -->
                        <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Cari adresleri" Style="{StaticResource TableLabelCellStyle}" />
                            <TextBlock Text="CARI_HESAP_ADRESLERI" Style="{StaticResource TableSubLabelCellStyle}" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MikroCustomerAddressesCountDisplay}" Style="{StaticResource TableNumberCellStyle}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding LastCustomerAddressesCountDisplay}" Style="{StaticResource TableNumberCellStyle}" />
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="Carilerle" Style="{StaticResource TableSubLabelCellStyle}" HorizontalAlignment="Right" />
                        <Border Grid.Row="1" Grid.ColumnSpan="5" Style="{StaticResource TableRowDividerStyle}" />

                        <!-- 3 · Cari yetkilileri -->
                        <StackPanel Grid.Row="2" Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Cari yetkilileri" Style="{StaticResource TableLabelCellStyle}" />
                            <TextBlock Text="CARI_HESAP_YETKILILERI" Style="{StaticResource TableSubLabelCellStyle}" />
                        </StackPanel>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MikroCustomerContactsCountDisplay}" Style="{StaticResource TableNumberCellStyle}" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding LastCustomerContactsCountDisplay}" Style="{StaticResource TableNumberCellStyle}" />
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="Carilerle" Style="{StaticResource TableSubLabelCellStyle}" HorizontalAlignment="Right" />
                        <Border Grid.Row="2" Grid.ColumnSpan="5" Style="{StaticResource TableRowDividerStyle}" />

                        <!-- 4 · Cari hareketleri -->
                        <StackPanel Grid.Row="3" Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Cari hareketleri" Style="{StaticResource TableLabelCellStyle}" />
                            <TextBlock Text="CARI_HESAP_HAREKETLERI" Style="{StaticResource TableSubLabelCellStyle}" />
                        </StackPanel>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding MikroCustomerTransactionsCountDisplay}" Style="{StaticResource TableNumberCellStyle}" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding LastCustomerTransactionsCountDisplay}" Style="{StaticResource TableNumberCellStyle}" />
                        <Button Grid.Row="3" Grid.Column="3" Content="Gönder" Command="{Binding PushCustomerTransactionsCommand}" Style="{StaticResource RowActionButtonStyle}" HorizontalAlignment="Right" />
                        <Border Grid.Row="3" Grid.ColumnSpan="5" Style="{StaticResource TableRowDividerStyle}" />

                        <!-- 5 · Stoklar -->
                        <StackPanel Grid.Row="4" Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Stoklar" Style="{StaticResource TableLabelCellStyle}" />
                            <TextBlock Text="STOKLAR" Style="{StaticResource TableSubLabelCellStyle}" />
                        </StackPanel>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding MikroStocksCountDisplay}" Style="{StaticResource TableNumberCellStyle}" />
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding LastStocksCountDisplay}" Style="{StaticResource TableNumberCellStyle}" />
                        <Button Grid.Row="4" Grid.Column="3" Content="Gönder" Command="{Binding PushStocksCommand}" Style="{StaticResource RowActionButtonStyle}" HorizontalAlignment="Right" />
                        <Border Grid.Row="4" Grid.ColumnSpan="5" Style="{StaticResource TableRowDividerStyle}" />

                        <!-- 6 · Barkodlar -->
                        <StackPanel Grid.Row="5" Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Barkodlar" Style="{StaticResource TableLabelCellStyle}" />
                            <TextBlock Text="BARKOD_TANIMLARI" Style="{StaticResource TableSubLabelCellStyle}" />
                        </StackPanel>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding MikroBarcodesCountDisplay}" Style="{StaticResource TableNumberCellStyle}" />
                        <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding LastBarcodesCountDisplay}" Style="{StaticResource TableNumberCellStyle}" />
                        <TextBlock Grid.Row="5" Grid.Column="3" Text="Stoklarla" Style="{StaticResource TableSubLabelCellStyle}" HorizontalAlignment="Right" />
                        <Border Grid.Row="5" Grid.ColumnSpan="5" Style="{StaticResource TableRowDividerStyle}" />

                        <!-- 7 · Stok hareketleri -->
                        <StackPanel Grid.Row="6" Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Stok hareketleri" Style="{StaticResource TableLabelCellStyle}" />
                            <TextBlock Text="STOK_HAREKETLERI" Style="{StaticResource TableSubLabelCellStyle}" />
                        </StackPanel>
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding MikroStockTransactionsCountDisplay}" Style="{StaticResource TableNumberCellStyle}" />
                        <TextBlock Grid.Row="6" Grid.Column="2" Text="{Binding LastStockTransactionsCountDisplay}" Style="{StaticResource TableNumberCellStyle}" />
                        <Button Grid.Row="6" Grid.Column="3" Content="Gönder" Command="{Binding PushStockTransactionsCommand}" Style="{StaticResource RowActionButtonStyle}" HorizontalAlignment="Right" />
                        <Border Grid.Row="6" Grid.ColumnSpan="5" Style="{StaticResource TableRowDividerStyle}" />

                        <!-- 8 · Envanter -->
                        <StackPanel Grid.Row="7" Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Envanter" Style="{StaticResource TableLabelCellStyle}" />
                            <TextBlock Text="STOK_HAREKETTEN_ELDEKI_MIKTAR_VIEW" Style="{StaticResource TableSubLabelCellStyle}" />
                        </StackPanel>
                        <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding MikroInventoryCountDisplay}" Style="{StaticResource TableNumberCellStyle}" />
                        <TextBlock Grid.Row="7" Grid.Column="2" Text="—" Style="{StaticResource TableNumberCellStyle}" Foreground="{DynamicResource MutedTextBrush}" />
                        <Button Grid.Row="7" Grid.Column="3" Content="Gönder" Command="{Binding PushInventoryCommand}" Style="{StaticResource RowActionButtonStyle}" HorizontalAlignment="Right" />
                        <Border Grid.Row="7" Grid.ColumnSpan="5" Style="{StaticResource TableRowDividerStyle}" />

                        <!-- 9 · Fiyatlar -->
                        <StackPanel Grid.Row="8" Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Fiyatlar" Style="{StaticResource TableLabelCellStyle}" />
                            <TextBlock Text="STOK_SATIS_FIYAT_LISTELERI" Style="{StaticResource TableSubLabelCellStyle}" />
                        </StackPanel>
                        <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding MikroPricesCountDisplay}" Style="{StaticResource TableNumberCellStyle}" />
                        <TextBlock Grid.Row="8" Grid.Column="2" Text="{Binding LastPricesCountDisplay}" Style="{StaticResource TableNumberCellStyle}" />
                        <Button Grid.Row="8" Grid.Column="3" Content="Gönder" Command="{Binding PushPricesCommand}" Style="{StaticResource RowActionButtonStyle}" HorizontalAlignment="Right" />
                        <Border Grid.Row="8" Grid.ColumnSpan="5" Style="{StaticResource TableRowDividerStyle}" />

                        <!-- 10 · Açık siparişler -->
                        <StackPanel Grid.Row="9" Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Açık siparişler" Style="{StaticResource TableLabelCellStyle}" />
                            <TextBlock Text="SIPARISLER" Style="{StaticResource TableSubLabelCellStyle}" />
                        </StackPanel>
                        <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding MikroOpenOrdersCountDisplay}" Style="{StaticResource TableNumberCellStyle}" />
                        <TextBlock Grid.Row="9" Grid.Column="2" Text="{Binding LastOpenOrdersCountDisplay}" Style="{StaticResource TableNumberCellStyle}" />
                        <Button Grid.Row="9" Grid.Column="3" Content="Gönder" Command="{Binding PushOpenOrdersCommand}" Style="{StaticResource RowActionButtonStyle}" HorizontalAlignment="Right" />
                        <Border Grid.Row="9" Grid.ColumnSpan="5" Style="{StaticResource TableRowDividerStyle}" />

                        <!-- 11 · Satış şartları -->
                        <StackPanel Grid.Row="10" Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Satış şartları" Style="{StaticResource TableLabelCellStyle}" />
                            <TextBlock Text="SATIS_SARTLARI" Style="{StaticResource TableSubLabelCellStyle}" />
                        </StackPanel>
                        <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding MikroSalesConditionsCountDisplay}" Style="{StaticResource TableNumberCellStyle}" />
                        <TextBlock Grid.Row="10" Grid.Column="2" Text="{Binding LastSalesConditionsCountDisplay}" Style="{StaticResource TableNumberCellStyle}" />
                        <TextBlock Grid.Row="10" Grid.Column="3" Text="Carilerle" Style="{StaticResource TableSubLabelCellStyle}" HorizontalAlignment="Right" />
                        <Border Grid.Row="10" Grid.ColumnSpan="5" Style="{StaticResource TableRowDividerStyle}" />

                        <!-- 12 · Kasa / Banka -->
                        <StackPanel Grid.Row="11" Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Kasa / Banka" Style="{StaticResource TableLabelCellStyle}" />
                            <TextBlock Text="KASALAR + BANKALAR" Style="{StaticResource TableSubLabelCellStyle}" />
                        </StackPanel>
                        <TextBlock Grid.Row="11" Grid.Column="1" Text="{Binding MikroCashAndBankCountDisplay}" Style="{StaticResource TableNumberCellStyle}" />
                        <TextBlock Grid.Row="11" Grid.Column="2" Text="—" Style="{StaticResource TableNumberCellStyle}" Foreground="{DynamicResource MutedTextBrush}" />
                        <Button Grid.Row="11" Grid.Column="3" Content="Gönder" Command="{Binding PushCashAndBankCommand}" Style="{StaticResource RowActionButtonStyle}" HorizontalAlignment="Right" />
                        <Border Grid.Row="11" Grid.ColumnSpan="5" Style="{StaticResource TableRowDividerStyle}" />

                        <!-- 13 · Lookup -->
                        <StackPanel Grid.Row="12" Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Lookup" Style="{StaticResource TableLabelCellStyle}" />
                            <TextBlock Text="DEPOLAR + PERSONEL" Style="{StaticResource TableSubLabelCellStyle}" />
                        </StackPanel>
                        <TextBlock Grid.Row="12" Grid.Column="1" Text="{Binding MikroLookupsCountDisplay}" Style="{StaticResource TableNumberCellStyle}" />
                        <TextBlock Grid.Row="12" Grid.Column="2" Text="—" Style="{StaticResource TableNumberCellStyle}" Foreground="{DynamicResource MutedTextBrush}" />
                        <Button Grid.Row="12" Grid.Column="3" Content="Gönder" Command="{Binding PushLookupsCommand}" Style="{StaticResource RowActionButtonStyle}" HorizontalAlignment="Right" />
                    </Grid>
                </ScrollViewer>

                <!-- Kart altı: son çalıştırma rozeti + özet + sayım zamanı -->
                <Grid Grid.Row="3" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Background="{Binding LastRunStatusBrush}"
                            CornerRadius="9"
                            Padding="9,2"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding LastRunStatusDisplay}"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   FontSize="11" />
                    </Border>
                    <TextBlock Grid.Column="1"
                               Text="{Binding LastRunSummaryDisplay}"
                               Style="{StaticResource CardCaptionStyle}"
                               Margin="10,0,10,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding MikroCountTimeDisplay, StringFormat='Sayım: {0}'}"
                               Style="{StaticResource CardCaptionStyle}"
                               Margin="0"
                               VerticalAlignment="Center"
                               Visibility="{Binding HasMikroCountResult, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
