<div class="admin-state admin-state--@Tone" role="@(Tone == "error" ? "alert" : "status")">
    <span class="admin-state__icon" aria-hidden="true">@Icon</span>
    <div><strong>@Title</strong>@if (!string.IsNullOrWhiteSpace(Message)) { <p>@Message</p> }@ChildContent</div>
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Message { get; set; }
    [Parameter] public string Tone { get; set; } = "empty";
    [Parameter] public string Icon { get; set; } = "◇";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
