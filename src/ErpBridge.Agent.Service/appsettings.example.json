{
  "AgentService": {
    "ServiceName": "ErpBridge Agent",
    "JobPollIntervalSeconds": 30,
    "JobPollFirstRunDelaySeconds": 5
  },
  "ErpBridge": {
    "Reconciliation": {
      "Enabled": true,
      "PeriodSeconds": 300,
      "LookbackMinutes": 60,
      "DailyAlertThreshold": 5
    }
  },
  "Agent": {
    "LicenseKey": "",
    "TenantId": "",
    "AgentId": "",
    "ErpType": "Mikro",
    "SqlServer": "",
    "SqlUserName": "",
    "SqlPassword": "",
    "ErpDatabaseName": "",
    "CompanyNo": 1,
    "BranchNo": 1,
    "ApiBaseUrl": "https://api.erpbridge.local",
    "Jwt": ""
  },
  "Mikro": {
    "Server": "",
    "UserId": "",
    "Password": "",
    "DatabaseName": ""
  },
  "CentralApi": {
    "BaseUrl": "https://api.erpbridge.local",
    "TimeoutSeconds": 30,
    "Retry": {
      "MaxAttempts": 4,
      "InitialDelaySeconds": 5
    },
    "Jwt": ""
  },
  "LocalStore": {
    "ConnectionString": "Data Source=%LOCALAPPDATA%\\ErpBridge\\agent.db"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  }
}
