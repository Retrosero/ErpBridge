@page "/stok"
@inherits PortalPageBase

<PageTitle>Stok — Yönetim Paneli</PageTitle>

@if (!Ready)
{
    <PageLoading />
}
else
{
    <PageHeader Title="Stok durumu" Eyebrow="Kayıtlar" Subtitle="Ürünler, depo miktarları ve fiyatlar" Busy="Busy">
        <Actions>
            <form class="toolbar-search" @onsubmit="SearchAsync" @onsubmit:preventDefault>
                <MudTextField T="string" @bind-Value="_search" Placeholder="Kod, ürün adı veya barkod" Variant="Variant.Outlined" Margin="Margin.Dense"
                              InputId="stock-search" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Rounded.Search" Clearable="true" />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@Busy">Ara</MudButton>
            </form>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.FilterList" OnClick="OpenFilters" id="stock-filters-open">
                Filtreler@(_filter.PanelFilterCount > 0 ? $" ({_filter.PanelFilterCount})" : null)
            </MudButton>
            @if (Session.CanEditNativeData)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.UploadFile" OnClick="@(() => _importOpen = true)" id="stock-import-open">İçe aktar</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Checklist" Href="stok/sayim" id="stock-count-open">Sayım</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add" OnClick="OpenNewCard" id="stock-new">Yeni ürün</MudButton>
            }
        </Actions>
    </PageHeader>

    <ErpReadOnlyNote />

    <div class="stock-toolbar">
        <div class="seg-tabs" role="tablist" id="stock-status">
            @foreach (var (status, label) in Statuses)
            {
                <button type="button" role="tab" class="seg-tab @(status == _filter.Status ? "is-active" : null)" aria-selected="@(status == _filter.Status ? "true" : "false")"
                        data-status="@status" disabled="@Busy" @onclick="() => StatusAsync(status)">@label</button>
            }
        </div>
        @if (_filter.Status == "below")
        {
            <label class="inline-field">
                Eşik
                <input type="number" step="any" class="portal-input portal-input--short" id="stock-below" value="@Num(_filter.Below ?? 0)" @onchange="BelowChangedAsync" />
            </label>
        }
        @if (_facets is { Warehouses.Count: > 1 })
        {
            <label class="toolbar-switch" id="stock-warehouse-columns">
                <input type="checkbox" checked="@_warehouseColumns" @onchange="e => _warehouseColumns = e.Value is true" />
                Depo kolonları
            </label>
        }
    </div>

    @if (Error is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="page-alert" id="page-error">@Error</MudAlert>
    }
    @if (Notice is not null)
    {
        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="page-alert" id="page-notice">@Notice</MudAlert>
    }

    @if (ActiveChips().ToList() is { Count: > 0 } chips)
    {
        <div class="filter-chips" id="stock-chips">
            @foreach (var chip in chips)
            {
                <span class="filter-chip" data-chip="@chip.Key">
                    @chip.Label
                    <button type="button" aria-label="@($"{chip.Label} filtresini kaldır")" @onclick="() => RemoveChipAsync(chip.Remove)">×</button>
                </span>
            }
            <button type="button" class="link-button" id="stock-chips-clear" @onclick="ClearAsync">Tümünü temizle</button>
        </div>
    }

    @if (_result is not null)
    {
        <section class="stat-grid stat-grid--four">
            <StatCard Id="stock-products" Label="Ürün" Value="@N(_result.Summary.Products)" Caption="filtreye uyan" Icon="@Icons.Material.Rounded.Inventory2" Tone="primary" />
            <StatCard Id="stock-in" Label="Stokta olan" Value="@N(_result.Summary.InStock)" Icon="@Icons.Material.Rounded.CheckCircle" Tone="success" />
            <StatCard Id="stock-out" Label="Tükenen" Value="@N(_result.Summary.OutOfStock)" Caption="miktar ≤ 0" Icon="@Icons.Material.Rounded.DoNotDisturbOn" Tone="danger" Attention="@(_result.Summary.OutOfStock > 0)" />
            <StatCard Id="stock-negative" Label="Eksiye düşen" Value="@N(_result.Summary.Negative)" Icon="@Icons.Material.Rounded.TrendingDown" Tone="warning" />
        </section>

        <MudPaper Outlined="true" Class="panel panel--table mt-3">
            @if (_result.Items.Count == 0)
            {
                <EmptyState Id="stock-empty" Icon="@Icons.Material.Rounded.Inventory2" Title="Filtreye uyan ürün yok." Hint="Filtreleri gevşetmeyi ya da aramayı temizlemeyi deneyin." />
            }
            else
            {
                <div class="table-scroll">
                    <table class="data-table data-table--plain" id="stock-table">
                        <thead>
                            <tr>
                                @SortHeader("code", "Kod")
                                @SortHeader("name", "Ürün")
                                @SortHeader("group", "Grup")
                                @SortHeader("brand", "Marka")
                                @SortHeader("shelf", "Reyon")
                                @SortHeader("qty", QuantityTitle, numeric: true)
                                @if (_warehouseColumns && _facets is not null)
                                {
                                    @foreach (var warehouse in _facets.Warehouses)
                                    {
                                        <th class="num" data-warehouse-col="@warehouse.Number">@warehouse.Name</th>
                                    }
                                }
                                @SortHeader("price", PriceTitle, numeric: true)
                                @if (_facets?.HasMovementDates == true)
                                {
                                    @SortHeader("lastMovement", "Son hareket", numeric: true)
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _result.Items)
                            {
                                var open = _expanded.Contains(row.StockCode);
                                <tr data-stock="@row.StockCode" class="row-clickable @(open ? "is-open" : null)" @onclick="() => Toggle(row.StockCode)">
                                    <td class="mono">@row.StockCode</td>
                                    <td class="cell-title">
                                        @row.Name
                                        @if (row.Barcodes.Count > 0 || row.Unit is not null)
                                        {
                                            <div class="cell-sub">@string.Join(" · ", new[] { row.Unit, row.Barcodes.FirstOrDefault() }.Where(v => v is not null))</div>
                                        }
                                    </td>
                                    <td>
                                        @(row.MainGroup ?? "—")
                                        @if (row.SubGroup is not null)
                                        {
                                            <div class="cell-sub">@row.SubGroup</div>
                                        }
                                    </td>
                                    <td>@(row.Brand ?? "—")</td>
                                    <td>@(row.Shelf ?? "—")</td>
                                    <td class="num">
                                        @if (row.Quantity <= 0)
                                        {
                                            <span class="badge @(row.Quantity < 0 ? "badge--warning" : "badge--off")">@Fmt.Quantity(row.Quantity)</span>
                                        }
                                        else
                                        {
                                            @Fmt.Quantity(row.Quantity)
                                        }
                                        @if (row.Reserved != 0)
                                        {
                                            <div class="cell-sub cell-sub--end">rezerve @Fmt.Quantity(row.Reserved)</div>
                                        }
                                    </td>
                                    @if (_warehouseColumns && _facets is not null)
                                    {
                                        @foreach (var warehouse in _facets.Warehouses)
                                        {
                                            var share = row.Warehouses.FirstOrDefault(w => w.WarehouseNo == warehouse.Number);
                                            <td class="num" data-warehouse="@warehouse.Number">@(share is null ? "—" : Fmt.Quantity(share.Quantity))</td>
                                        }
                                    }
                                    <td class="num">@(row.Price is { } price ? Fmt.Money(price) : "—")</td>
                                    @if (_facets?.HasMovementDates == true)
                                    {
                                        <td class="num">@DateText(row.LastMovementDate)</td>
                                    }
                                </tr>
                                @if (open)
                                {
                                    <tr class="row-detail" data-stock-detail="@row.StockCode">
                                        <td colspan="@ColumnCount">
                                            <div class="stock-detail">
                                                <div>
                                                    <h4>Depolar</h4>
                                                    @if (row.Warehouses.Count == 0)
                                                    {
                                                        <p class="text-muted">Depo kaydı yok.</p>
                                                    }
                                                    else
                                                    {
                                                        <dl class="detail-facts">
                                                            @foreach (var w in row.Warehouses)
                                                            {
                                                                <dt>@w.Name</dt>
                                                                <dd>@Fmt.Quantity(w.Quantity)@(w.Reserved != 0 ? $" (rezerve {Fmt.Quantity(w.Reserved)})" : null)</dd>
                                                            }
                                                        </dl>
                                                    }
                                                </div>
                                                <div>
                                                    <h4>Fiyatlar</h4>
                                                    @if (row.Prices.Count == 0)
                                                    {
                                                        <p class="text-muted">Fiyat yok.</p>
                                                    }
                                                    else
                                                    {
                                                        <dl class="detail-facts">
                                                            @foreach (var p in row.Prices)
                                                            {
                                                                <dt>@p.Name</dt>
                                                                <dd>@Fmt.Money(p.Price)</dd>
                                                            }
                                                        </dl>
                                                    }
                                                </div>
                                                <div>
                                                    <h4>Barkodlar</h4>
                                                    @if (row.Barcodes.Count == 0)
                                                    {
                                                        <p class="text-muted">Barkod yok.</p>
                                                    }
                                                    else
                                                    {
                                                        <ul class="plain-list mono">
                                                            @foreach (var barcode in row.Barcodes)
                                                            {
                                                                <li>@barcode</li>
                                                            }
                                                        </ul>
                                                    }
                                                </div>
                                                @if (Session.CanEditNativeData)
                                                {
                                                    <div class="stock-detail-actions">
                                                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Edit"
                                                                   OnClick="@(() => OpenEditCardAsync(row.StockCode))" data-edit="@row.StockCode">Düzenle</MudButton>
                                                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Rounded.SwapVert"
                                                                   OnClick="@(() => OpenMovementsAsync(row.StockCode, row.Name))" data-movements="@row.StockCode">Hareketler</MudButton>
                                                    </div>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
            <div class="table-foot pager" id="stock-pager">
                <span id="stock-range">@RangeText</span>
                <label class="inline-field">
                    Sayfada
                    <select class="portal-select portal-select--short" id="stock-page-size" value="@_filter.PageSize" @onchange="PageSizeChangedAsync" disabled="@Busy">
                        @foreach (var size in StockFilter.PageSizes)
                        {
                            <option value="@size">@size</option>
                        }
                    </select>
                </label>
                <span class="pager-buttons">
                    <MudIconButton Icon="@Icons.Material.Rounded.FirstPage" Size="Size.Small" Disabled="@(Busy || _filter.Page <= 1)" OnClick="() => GoToAsync(1)" aria-label="İlk sayfa" Class="pager-first" />
                    <MudIconButton Icon="@Icons.Material.Rounded.ChevronLeft" Size="Size.Small" Disabled="@(Busy || _filter.Page <= 1)" OnClick="() => GoToAsync(_filter.Page - 1)" aria-label="Önceki sayfa" Class="pager-prev" />
                    <span class="pager-page" id="stock-page">Sayfa @_filter.Page / @PageCount</span>
                    <MudIconButton Icon="@Icons.Material.Rounded.ChevronRight" Size="Size.Small" Disabled="@(Busy || _filter.Page >= PageCount)" OnClick="() => GoToAsync(_filter.Page + 1)" aria-label="Sonraki sayfa" Class="pager-next" />
                    <MudIconButton Icon="@Icons.Material.Rounded.LastPage" Size="Size.Small" Disabled="@(Busy || _filter.Page >= PageCount)" OnClick="() => GoToAsync(PageCount)" aria-label="Son sayfa" Class="pager-last" />
                </span>
            </div>
        </MudPaper>
    }

    <DetailSheet Id="stock-filters" Open="_filtersOpen" Eyebrow="Stok" Title="Filtreler" OnClose="() => _filtersOpen = false">
        <ChildContent>
            @if (_draft is not null && _facets is not null)
            {
                <div class="filter-grid">
                    @if (_facets.Warehouses.Count > 1)
                    {
                    <label class="stack-field">
                        <span class="field-label">Depo</span>
                        <select class="portal-select" id="filter-warehouse" value="@(_draft.Warehouse?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                                @onchange="e => _draft.Warehouse = int.TryParse(e.Value?.ToString(), out var n) ? n : null">
                            <option value="">Tüm depolar (toplam)</option>
                            @foreach (var warehouse in _facets.Warehouses)
                            {
                                <option value="@warehouse.Number">@warehouse.Name</option>
                            }
                        </select>
                    </label>
                    }
                    <label class="stack-field">
                        <span class="field-label">Fiyat listesi</span>
                        <select class="portal-select" id="filter-price-list" value="@(_draft.PriceList?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                                @onchange="e => _draft.PriceList = int.TryParse(e.Value?.ToString(), out var n) ? n : null">
                            <option value="">Varsayılan liste</option>
                            @foreach (var list in _facets.PriceLists)
                            {
                                <option value="@list.Number">@list.Name</option>
                            }
                        </select>
                    </label>
                    <div class="stack-field">
                        <span class="field-label">Miktar aralığı</span>
                        <div class="range-inputs">
                            <input type="number" step="any" class="portal-input" id="filter-min-qty" placeholder="En az" value="@Num(_draft.MinQuantity)" @onchange="e => _draft.MinQuantity = Dec(e)" />
                            <span>–</span>
                            <input type="number" step="any" class="portal-input" id="filter-max-qty" placeholder="En çok" value="@Num(_draft.MaxQuantity)" @onchange="e => _draft.MaxQuantity = Dec(e)" />
                        </div>
                    </div>
                    <div class="stack-field">
                        <span class="field-label">Fiyat aralığı</span>
                        <div class="range-inputs">
                            <input type="number" step="any" class="portal-input" id="filter-min-price" placeholder="En az" value="@Num(_draft.MinPrice)" @onchange="e => _draft.MinPrice = Dec(e)" />
                            <span>–</span>
                            <input type="number" step="any" class="portal-input" id="filter-max-price" placeholder="En çok" value="@Num(_draft.MaxPrice)" @onchange="e => _draft.MaxPrice = Dec(e)" />
                        </div>
                    </div>
                    @if (_facets.HasMovementDates)
                    {
                        <label class="stack-field">
                            <span class="field-label">Hareketsiz ürünler</span>
                            <span class="range-inputs">
                                <input type="number" min="0" step="1" class="portal-input" id="filter-idle" placeholder="Gün" value="@_draft.IdleDays" @onchange="e => _draft.IdleDays = int.TryParse(e.Value?.ToString(), out var n) && n >= 0 ? n : null" />
                                <span class="text-muted">günden uzun süredir hareket görmeyenler</span>
                            </span>
                        </label>
                    }
                </div>
                <FacetChecklist Id="filter-main-groups" Title="Ana grup" Options="_facets.MainGroups" Selected="_draft.MainGroups" Changed="DraftChanged" EmptyText="Ürünlerde grup bilgisi yok." />
                <FacetChecklist Id="filter-sub-groups" Title="Alt grup" Options="SubGroupOptions" Selected="_draft.SubGroups" ShowParent="true" EmptyText="Alt grup bilgisi yok." />
                <FacetChecklist Id="filter-brands" Title="Marka" Options="_facets.Brands" Selected="_draft.Brands" EmptyText="Ürünlerde marka bilgisi yok." />
                <FacetChecklist Id="filter-shelves" Title="Reyon" Options="_facets.Shelves" Selected="_draft.Shelves" EmptyText="Ürünlerde reyon bilgisi yok." />
            }
        </ChildContent>
        <Footer>
            <div class="form-actions">
                <MudButton Variant="Variant.Text" OnClick="ResetDraft" id="filter-reset">Temizle</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ApplyFiltersAsync" id="filter-apply">Uygula</MudButton>
            </div>
        </Footer>
    </DetailSheet>

    @if (Session.CanEditNativeData)
    {
        <CardImport Kind="stock" Open="_importOpen" OnClose="@(() => _importOpen = false)" OnImported="ImportedAsync" />
        <DetailSheet Id="stock-movements" Open="_movesOpen" Busy="_movesBusy" Eyebrow="Stok hareketleri" Title="@(_movesName ?? _movesCode ?? "Ürün")" OnClose="CloseMovements">
            <ChildContent>
                @if (_movesError is not null)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="page-alert" id="movements-error">@_movesError</MudAlert>
                }
                <div class="ledger-toolbar">
                    <label class="inline-field">
                        Başlangıç
                        <input type="date" class="portal-input portal-input--date" id="movements-from" value="@(_movesFrom is { } f ? Fmt.IsoDay(f) : null)"
                               @onchange="e => MovesRangeAsync(e, start: true)" />
                    </label>
                    <label class="inline-field">
                        Bitiş
                        <input type="date" class="portal-input portal-input--date" id="movements-to" value="@(_movesTo is { } t ? Fmt.IsoDay(t) : null)"
                               @onchange="e => MovesRangeAsync(e, start: false)" />
                    </label>
                    <button type="button" class="kind-toggle @(_movesVoided ? "is-active" : null)" aria-pressed="@(_movesVoided ? "true" : "false")"
                            id="movements-include-voided" @onclick="ToggleMovesVoidedAsync">İptal edilenleri göster</button>
                </div>
                @if (_moves is { } moves)
                {
                    <dl class="detail-facts">
                        <dt>Devir</dt><dd id="movements-opening">@Fmt.Quantity(moves.Opening)</dd>
                        <dt>Giriş / çıkış</dt><dd>@Fmt.Quantity(moves.TotalIn) / @Fmt.Quantity(moves.TotalOut)</dd>
                        <dt>Dönem sonu</dt><dd id="movements-closing">@Fmt.Quantity(moves.Closing)</dd>
                    </dl>
                    @if (moves.Items.Count == 0)
                    {
                        <EmptyState Id="movements-empty" Icon="@Icons.Material.Rounded.SwapVert" Title="Bu aralıkta hareket yok." />
                    }
                    else
                    {
                        <div class="table-scroll">
                            <table class="data-table detail-lines" id="movements-table">
                                <thead>
                                    <tr><th>Tarih</th><th>Tür</th><th>Belge</th><th class="num">Giriş</th><th class="num">Çıkış</th><th class="num">Stok</th><th></th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var move in moves.Items)
                                    {
                                        <tr data-movement="@move.Id" data-kind="@move.Kind" class="@(move.Voided ? "is-voided" : null)">
                                            <td class="nowrap">@DateText(move.Date)</td>
                                            <td>
                                                @MoveKind(move.Kind)
                                                @if (move.Voided)
                                                {
                                                    <div class="cell-sub">İptal: @move.Reason</div>
                                                }
                                                else if (move.Description is not null)
                                                {
                                                    <div class="cell-sub">@move.Description</div>
                                                }
                                            </td>
                                            <td class="mono">@(move.DocumentNo ?? "—")@(move.CustomerCode is null ? null : $" · {move.CustomerCode}")</td>
                                            <td class="num">@(move.In == 0 ? null : Fmt.Quantity(move.In))</td>
                                            <td class="num">@(move.Out == 0 ? null : Fmt.Quantity(move.Out))</td>
                                            <td class="num">@Fmt.Quantity(move.Balance)</td>
                                            <td>
                                                @if (move.Kind == "count" && !move.Voided)
                                                {
                                                    <button type="button" class="link-button" data-action="void-count" @onclick="() => OpenVoidCount(move)">Sayımı iptal et</button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <Pager Id="movements-pager" Page="_movesPage" PageSize="_movesPageSize" Total="moves.Total" Busy="_movesBusy" Unit="hareket"
                               PageChanged="MovesPageAsync" PageSizeChanged="MovesPageSizeAsync" />
                    }
                }
                @if (_voidingCount is { } voiding)
                {
                    <form class="stack-form mt-3" id="count-void-form" @onsubmit="ConfirmVoidCountAsync" @onsubmit:preventDefault>
                        <p class="text-muted">Sayımın bütün satırları geri alınır (@DateText(voiding.Date)).</p>
                        <MudTextField T="string" @bind-Value="_voidCountReason" Label="Gerekçe" Variant="Variant.Outlined" Margin="Margin.Dense" InputId="count-void-reason" Lines="2" Required="true" />
                        <div class="form-actions">
                            <span style="flex: 1"></span>
                            <MudButton Variant="Variant.Text" OnClick="@(() => _voidingCount = null)">Vazgeç</MudButton>
                            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Error" Disabled="@_movesBusy" id="count-void-confirm">Sayımı iptal et</MudButton>
                        </div>
                    </form>
                }
            </ChildContent>
        </DetailSheet>

        <DetailSheet Id="stock-card" Open="_cardOpen" Busy="Busy" Eyebrow="Stok" Title="@(_cardIsNew ? "Yeni ürün" : "Ürünü düzenle")" OnClose="CloseCard">
            <ChildContent>
                <form class="stack-form" id="stock-card-form" @onsubmit="SaveCardAsync" @onsubmit:preventDefault>
                    <MudTextField T="string" @bind-Value="_card.StockCode" Label="Kod" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  InputId="card-code" MaxLength="64" ReadOnly="@(!_cardIsNew)" Required="true"
                                  HelperText="@(_cardIsNew ? null : "Kaydedildikten sonra değiştirilemez")" />
                    <MudTextField T="string" @bind-Value="_card.Name" Label="Ürün adı" Variant="Variant.Outlined" Margin="Margin.Dense" InputId="card-name" Required="true" />
                    <MudTextField T="string" @bind-Value="_card.Unit" Label="Birim" Variant="Variant.Outlined" Margin="Margin.Dense" InputId="card-unit" Placeholder="Adet, Kg, Paket…" />
                    <MudNumericField T="decimal?" @bind-Value="_card.VatRate" Label="KDV (%)" Variant="Variant.Outlined" Margin="Margin.Dense" id="card-vat" Min="0" Max="100" />
                    <MudTextField T="string" @bind-Value="_card.Category" Label="Kategori" Variant="Variant.Outlined" Margin="Margin.Dense" InputId="card-category" />
                    <MudTextField T="string" @bind-Value="_card.Brand" Label="Marka" Variant="Variant.Outlined" Margin="Margin.Dense" InputId="card-brand" />
                    <MudTextField T="string" @bind-Value="_card.Aisle" Label="Reyon" Variant="Variant.Outlined" Margin="Margin.Dense" InputId="card-aisle" />
                    <MudTextField T="string" @bind-Value="_card.Barcode" Label="Barkod" Variant="Variant.Outlined" Margin="Margin.Dense" InputId="card-barcode" autocomplete="off" />
                    <MudNumericField T="decimal?" @bind-Value="_card.Price" Label="Fiyat" Variant="Variant.Outlined" Margin="Margin.Dense" id="card-price" Min="0" Adornment="Adornment.End" AdornmentText="TL" />
                    @if (_cardIsNew)
                    {
                        <MudNumericField T="decimal?" @bind-Value="_card.OpeningQuantity" Label="Açılış miktarı" Variant="Variant.Outlined" Margin="Margin.Dense" id="card-opening"
                                         HelperText="Yalnız yeni ürünlerde; sonradan bu alan yok sayılır" />
                    }
                    @if (!_cardIsNew && _confirmDelete)
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" id="stock-delete-confirm">
                            <div class="form-actions">
                                <span>"@_card.Name" ürününü silmek istediğinize emin misiniz?</span>
                                <div>
                                    <MudButton Variant="Variant.Text" OnClick="@(() => _confirmDelete = false)">Vazgeç</MudButton>
                                    <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="DeleteCardAsync" id="stock-delete-confirm-yes">Evet, sil</MudButton>
                                </div>
                            </div>
                        </MudAlert>
                    }
                    <div class="form-actions">
                        @if (!_cardIsNew)
                        {
                            <MudButton Variant="Variant.Text" Color="Color.Error" Disabled="@Busy" OnClick="@(() => _confirmDelete = true)" id="stock-card-delete">Sil</MudButton>
                        }
                        <span style="flex: 1"></span>
                        <MudButton Variant="Variant.Text" Disabled="@Busy" OnClick="CloseCard">Vazgeç</MudButton>
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@Busy" id="stock-card-save">Kaydet</MudButton>
                    </div>
                </form>
            </ChildContent>
        </DetailSheet>
    }
}

@code {
    protected override PortalArea Requires => PortalArea.Ledger;

    private static readonly (string Status, string Label)[] Statuses =
        [("all", "Tümü"), ("in", "Stokta"), ("out", "Tükenen"), ("negative", "Eksi"), ("below", "Eşik altı")];

    private StockFilter _filter = new();
    private StockFilter? _draft;
    private string? _search;
    private StockSearchResponse? _result;
    private StockFacetsResponse? _facets;
    private bool _filtersOpen;
    private bool _warehouseColumns;
    private readonly HashSet<string> _expanded = new(StringComparer.OrdinalIgnoreCase);

    private int PageCount => _result is null ? 1 : Math.Max(1, (int)Math.Ceiling(_result.Total / (double)_filter.PageSize));

    private int ColumnCount => 7 + (_facets?.HasMovementDates == true ? 1 : 0) + (_warehouseColumns ? _facets?.Warehouses.Count ?? 0 : 0);

    private string RangeText => _result is null || _result.Total == 0
        ? "0 ürün"
        : $"{N((_filter.Page - 1) * _filter.PageSize + 1)}–{N((_filter.Page - 1) * _filter.PageSize + _result.Items.Count)} / {N(_result.Total)} ürün";

    private string QuantityTitle => _filter.Warehouse is { } w
        ? "Miktar (" + (_facets?.Warehouses.FirstOrDefault(x => x.Number == w)?.Name ?? $"Depo {w}") + ")"
        : "Miktar";

    private string PriceTitle => _result?.PriceList is { } l
        ? "Fiyat (" + (_facets?.PriceLists.FirstOrDefault(x => x.Number == l)?.Name ?? $"Liste {l}") + ")"
        : "Fiyat";

    /// <summary>Sub groups of the chosen main groups, or all of them.</summary>
    private IReadOnlyList<FacetValueDto> SubGroupOptions => _facets is null || _draft is null
        ? []
        : _draft.MainGroups.Count == 0
            ? _facets.SubGroups
            : _facets.SubGroups.Where(s => s.Parent is not null && _draft.MainGroups.Contains(s.Parent, StringComparer.OrdinalIgnoreCase)).ToList();

    protected override void OnInitialized()
    {
        _filter = StockFilter.FromAddress(new Uri(Nav.Uri).Query);
        _search = _filter.Search;
    }

    protected override async Task LoadAsync()
    {
        var facets = Api.StockFacetsAsync();
        await LoadPageAsync();
        _facets = await facets;
    }

    // ---- ürün kartı (GOAL_PANEL_ERPSIZ E1c, ERP'siz firma) --------------------------

    private string? Notice { get; set; }
    private bool _cardOpen;
    private bool _cardIsNew;
    private bool _confirmDelete;
    private NativeStockCardRequest _card = new();

    private void OpenNewCard()
    {
        Notice = null;
        Error = null;
        _card = new NativeStockCardRequest { OperationId = Guid.NewGuid().ToString("N") };
        _originalBarcode = null;
        _cardIsNew = true;
        _confirmDelete = false;
        _cardOpen = true;
    }

    /// <summary>
    /// The barcode as it was when the sheet opened, so a save that never touched the field can leave
    /// it out of the request. <c>stock_card</c> lists one barcode and drops every other one it finds
    /// for the product (Faz 34), so resending an unchanged value on every edit would, over a few saves,
    /// erase any extra barcode the product happens to carry (Codex review of #163, P1).
    /// </summary>
    private string? _originalBarcode;

    private Task OpenEditCardAsync(string code)
    {
        Notice = null;
        _confirmDelete = false;
        _cardIsNew = false;
        return RunAsync(async () =>
        {
            var detail = await Api.NativeStockCardAsync(code);
            // stock_card only ever books a price on list 1 (BookStockCardAsync); showing a
            // different list's price here would resubmit it as list 1 on save, creating a second,
            // wrong-list price while leaving the real one untouched (Codex review of #163, P1).
            var listOnePrice = detail.Prices.FirstOrDefault(p => p.ListNumber == 1)?.Price;
            _originalBarcode = detail.Barcodes.FirstOrDefault();
            _card = new NativeStockCardRequest
            {
                StockCode = detail.StockCode,
                Name = detail.Name,
                Unit = detail.Unit,
                VatRate = detail.VatRate,
                Category = detail.Category,
                Brand = detail.Brand,
                Aisle = detail.Aisle,
                Barcode = _originalBarcode,
                Price = listOnePrice,
                OperationId = Guid.NewGuid().ToString("N"),
            };
            _cardOpen = true;
        });
    }

    private void CloseCard()
    {
        _cardOpen = false;
        _confirmDelete = false;
    }

    private Task SaveCardAsync()
    {
        Notice = null;
        _card.StockCode = (_card.StockCode ?? string.Empty).Trim();
        _card.Name = (_card.Name ?? string.Empty).Trim();
        var name = _card.Name;
        // A copy: only an actually-typed barcode change goes out, so an edit to an unrelated field
        // (name, price…) leaves every barcode the product has alone rather than replaying the one
        // shown here and tombstoning the rest.
        var request = new NativeStockCardRequest
        {
            StockCode = _card.StockCode, Name = _card.Name, Unit = _card.Unit, VatRate = _card.VatRate,
            Category = _card.Category, Brand = _card.Brand, Aisle = _card.Aisle, Price = _card.Price,
            OpeningQuantity = _card.OpeningQuantity, OperationId = _card.OperationId,
            Barcode = string.Equals((_card.Barcode ?? string.Empty).Trim(), _originalBarcode, StringComparison.Ordinal)
                ? null : _card.Barcode,
        };
        return RunAsync(async () =>
        {
            await Api.SaveNativeStockCardAsync(request);
            _cardOpen = false;
            await LoadPageAsync();
            Notice = $"{name} kaydedildi.";
        });
    }

    private Task DeleteCardAsync()
    {
        Notice = null;
        var code = _card.StockCode;
        var name = _card.Name;
        var operationId = _card.OperationId ?? Guid.NewGuid().ToString("N");
        return RunAsync(async () =>
        {
            await Api.DeleteNativeStockCardAsync(code, operationId);
            _cardOpen = false;
            _confirmDelete = false;
            await LoadPageAsync();
            Notice = $"{name} silindi.";
        });
    }

    private async Task LoadPageAsync()
    {
        _result = await Api.StockSearchAsync(_filter);
        _expanded.Clear();
        // A page past the end (rows sold out, filters narrowed) falls back to the last one.
        if (_result.Items.Count == 0 && _result.Total > 0 && _filter.Page > 1)
        {
            _filter.Page = PageCount;
            _result = await Api.StockSearchAsync(_filter);
        }
        Nav.NavigateTo(new Uri(Nav.Uri).GetLeftPart(UriPartial.Path) + _filter.ToAddressQuery(), new NavigationOptions { ReplaceHistoryEntry = true });
    }

    private Task ReloadFromFirstPageAsync()
    {
        _filter.Page = 1;
        return RunAsync(LoadPageAsync);
    }

    private Task SearchAsync()
    {
        _filter.Search = string.IsNullOrWhiteSpace(_search) ? null : _search.Trim();
        return ReloadFromFirstPageAsync();
    }

    private Task StatusAsync(string status)
    {
        if (status == _filter.Status) return Task.CompletedTask;
        _filter.Status = status;
        return ReloadFromFirstPageAsync();
    }

    private Task BelowChangedAsync(ChangeEventArgs e)
    {
        _filter.Below = Dec(e) ?? 0;
        return ReloadFromFirstPageAsync();
    }

    private Task SortAsync(string sort)
    {
        if (_filter.Sort == sort) _filter.Descending = !_filter.Descending;
        else
        {
            _filter.Sort = sort;
            // Numbers are most useful largest first; text alphabetically.
            _filter.Descending = sort is "qty" or "price" or "lastMovement";
        }
        return ReloadFromFirstPageAsync();
    }

    private Task GoToAsync(int page)
    {
        _filter.Page = Math.Clamp(page, 1, PageCount);
        return RunAsync(LoadPageAsync);
    }

    private Task PageSizeChangedAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size) && StockFilter.PageSizes.Contains(size)) _filter.PageSize = size;
        return ReloadFromFirstPageAsync();
    }

    private void OpenFilters()
    {
        _draft = _filter.Clone();
        _filtersOpen = true;
    }

    /// <summary>The sub group list follows the ticked main groups.</summary>
    private void DraftChanged() { }

    private void ResetDraft()
    {
        if (_draft is null) return;
        var keep = _draft;
        _draft = new StockFilter { Search = keep.Search, Status = keep.Status, Below = keep.Below, Sort = keep.Sort, Descending = keep.Descending, PageSize = keep.PageSize };
    }

    private Task ApplyFiltersAsync()
    {
        if (_draft is null) return Task.CompletedTask;
        // A sub group that no longer sits under a chosen main group would silently empty the list.
        if (_draft.MainGroups.Count > 0 && _facets is not null)
            _draft.SubGroups.RemoveAll(s => !SubGroupOptions.Any(o => string.Equals(o.Code, s, StringComparison.OrdinalIgnoreCase)));
        _filter = _draft;
        _draft = null;
        _filtersOpen = false;
        return ReloadFromFirstPageAsync();
    }

    private Task ClearAsync()
    {
        _filter = new StockFilter { Status = _filter.Status, Below = _filter.Below, Sort = _filter.Sort, Descending = _filter.Descending, PageSize = _filter.PageSize };
        _search = null;
        return ReloadFromFirstPageAsync();
    }

    private Task RemoveChipAsync(Action<StockFilter> remove)
    {
        remove(_filter);
        _search = _filter.Search;
        return ReloadFromFirstPageAsync();
    }

    private void Toggle(string code)
    {
        if (!_expanded.Remove(code)) _expanded.Add(code);
    }

    private sealed record Chip(string Key, string Label, Action<StockFilter> Remove);

    private IEnumerable<Chip> ActiveChips()
    {
        var f = _filter;
        if (f.Search is { } q) yield return new Chip("q", $"Arama: {q}", x => x.Search = null);
        foreach (var g in f.MainGroups) yield return new Chip("grup:" + g, $"Grup: {g}", x => x.MainGroups.Remove(g));
        foreach (var g in f.SubGroups) yield return new Chip("altgrup:" + g, $"Alt grup: {g}", x => x.SubGroups.Remove(g));
        foreach (var b in f.Brands) yield return new Chip("marka:" + b, $"Marka: {b}", x => x.Brands.Remove(b));
        foreach (var s in f.Shelves) yield return new Chip("reyon:" + s, $"Reyon: {s}", x => x.Shelves.Remove(s));
        if (f.Warehouse is { } w)
            yield return new Chip("depo", "Depo: " + (_facets?.Warehouses.FirstOrDefault(x => x.Number == w)?.Name ?? w.ToString(Fmt.Turkish)), x => x.Warehouse = null);
        if (f.PriceList is { } l)
            yield return new Chip("liste", "Liste: " + (_facets?.PriceLists.FirstOrDefault(x => x.Number == l)?.Name ?? l.ToString(Fmt.Turkish)), x => x.PriceList = null);
        if (f.MinQuantity is not null || f.MaxQuantity is not null)
            yield return new Chip("miktar", $"Miktar: {Range(f.MinQuantity, f.MaxQuantity, Fmt.Quantity)}", x => { x.MinQuantity = null; x.MaxQuantity = null; });
        if (f.MinPrice is not null || f.MaxPrice is not null)
            yield return new Chip("fiyat", $"Fiyat: {Range(f.MinPrice, f.MaxPrice, Fmt.Money)}", x => { x.MinPrice = null; x.MaxPrice = null; });
        if (f.IdleDays is { } d) yield return new Chip("hareketsiz", $"{d} gündür hareketsiz", x => x.IdleDays = null);
    }

    private static string Range(decimal? min, decimal? max, Func<decimal, string> format) => (min, max) switch
    {
        ({ } a, { } b) => $"{format(a)} – {format(b)}",
        ({ } a, null) => $"≥ {format(a)}",
        (null, { } b) => $"≤ {format(b)}",
        _ => string.Empty,
    };

    private RenderFragment SortHeader(string sort, string title, bool numeric = false) => __builder =>
    {
        var active = _filter.Sort == sort;
        <th class="@(numeric ? "num" : null)" aria-sort="@(active ? (_filter.Descending ? "descending" : "ascending") : "none")">
            <button type="button" class="sort-button @(active ? "is-active" : null)" data-sort="@sort" disabled="@Busy" @onclick="() => SortAsync(sort)">
                @title
                <span class="sort-arrow" aria-hidden="true">@(active ? (_filter.Descending ? "↓" : "↑") : "↕")</span>
            </button>
        </th>
    };

    // ---- toplu içe aktarma (GOAL_PANEL_ERPSIZ E1d) ---------------------------------------------

    private bool _importOpen;

    private Task ImportedAsync() => RunAsync(LoadAsync);
    // ---- ürün hareketleri ve sayım iptali (GOAL_PANEL_ERPSIZ E6c) ------------------------------

    private bool _movesOpen;
    private bool _movesBusy;
    private string? _movesError;
    private string? _movesCode;
    private string? _movesName;
    private DateOnly? _movesFrom;
    private DateOnly? _movesTo;
    private bool _movesVoided;
    private int _movesPage = 1;
    private int _movesPageSize = 50;
    private StockMovementsResponse? _moves;
    private StockMovementRowDto? _voidingCount;
    private string? _voidCountReason;
    private string _voidCountOperationId = string.Empty;

    private Task OpenMovementsAsync(string code, string name)
    {
        Notice = null;
        _movesCode = code;
        _movesName = name;
        _movesFrom = null;
        _movesTo = null;
        _movesVoided = false;
        _movesPage = 1;
        _moves = null;
        _voidingCount = null;
        _movesOpen = true;
        return LoadMovesAsync();
    }

    private void CloseMovements()
    {
        _movesOpen = false;
        _moves = null;
        _voidingCount = null;
    }

    /// <summary>Bumped by every drawer request: only the newest request's answer, error and end of busy apply (Codex #196).</summary>
    private int _movesGeneration;

    private async Task LoadMovesAsync()
    {
        var code = _movesCode;
        if (code is null) return;
        var generation = ++_movesGeneration;
        bool Current() => generation == _movesGeneration && _movesOpen && _movesCode == code;
        _movesBusy = true;
        _movesError = null;
        StateHasChanged();
        try
        {
            var moves = await Api.NativeStockMovementsAsync(code, _movesFrom, _movesTo, _movesVoided, _movesPage, _movesPageSize);
            if (Current()) _moves = moves;
        }
        catch (PortalApiException failed)
        {
            if (Current()) _movesError = failed.Message;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            if (Current()) _movesError = "Sunucuya ulaşılamadı. Tekrar deneyin.";
        }
        catch (SessionEndedException)
        {
            // The page's own path signs out and goes to the login page (Codex #193).
            await EndDrawerSessionAsync();
        }
        finally
        {
            if (generation == _movesGeneration) _movesBusy = false;
        }
        StateHasChanged();
    }

    /// <summary>The session ended while the drawer asked the server: close it and let the page's own reload end the session.</summary>
    private Task EndDrawerSessionAsync()
    {
        CloseMovements();
        return RunAsync(LoadAsync);
    }

    private Task MovesRangeAsync(ChangeEventArgs e, bool start)
    {
        DateOnly? day = Fmt.TryIsoDay(e.Value?.ToString(), out var d) ? d : null;
        if (start) _movesFrom = day;
        else _movesTo = day;
        _movesPage = 1;
        return LoadMovesAsync();
    }

    private Task ToggleMovesVoidedAsync()
    {
        _movesVoided = !_movesVoided;
        _movesPage = 1;
        return LoadMovesAsync();
    }

    private Task MovesPageAsync(int page)
    {
        _movesPage = page;
        return LoadMovesAsync();
    }

    private Task MovesPageSizeAsync(int size)
    {
        _movesPageSize = size;
        _movesPage = 1;
        return LoadMovesAsync();
    }

    private void OpenVoidCount(StockMovementRowDto move)
    {
        _voidingCount = move;
        _voidCountReason = null;
        _voidCountOperationId = Guid.NewGuid().ToString("N");
    }

    private async Task ConfirmVoidCountAsync()
    {
        if (_voidingCount is not { } move) return;
        if (string.IsNullOrWhiteSpace(_voidCountReason))
        {
            _movesError = "İptal için gerekçe gerekli.";
            return;
        }
        _movesBusy = true;
        _movesError = null;
        var cancelled = false;
        try
        {
            await Api.VoidNativeStockCountAsync(move.Id, new NativeLedgerVoidRequest { Reason = _voidCountReason.Trim(), OperationId = _voidCountOperationId });
            _voidingCount = null;
            cancelled = true;
            Notice = "Sayım iptal edildi; stok geri alındı.";
        }
        catch (PortalApiException failed)
        {
            _movesError = failed.Message;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            _movesError = "Sunucuya ulaşılamadı. Tekrar deneyin.";
        }
        catch (SessionEndedException)
        {
            await EndDrawerSessionAsync();
            return;
        }
        finally
        {
            _movesBusy = false;
        }
        // Reload only after a cancellation went through: a reload clears the drawer's error, and a refused
        // cancellation must keep saying why (Codex #193).
        if (!cancelled) return;
        await LoadMovesAsync();
        await RunAsync(LoadAsync);
    }

    private static string MoveKind(string kind) => kind switch
    {
        "sale" => "Satış",
        "purchase" => "Alış",
        "sale_return" => "Satış iadesi",
        "count" => "Sayım",
        "void" => "İptal",
        _ => "Diğer",
    };

    private static string N(int value) => value.ToString("N0", Fmt.Turkish);

    private static string? Num(decimal? value) => value?.ToString(System.Globalization.CultureInfo.InvariantCulture);

    private static decimal? Dec(ChangeEventArgs e) =>
        decimal.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var n) ? n : null;

    private static string DateText(string? iso) =>
        DateOnly.TryParseExact(iso, "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var d)
            ? d.ToString("dd.MM.yyyy", Fmt.Turkish)
            : "—";
}
