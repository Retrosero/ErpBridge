@page "/stok"
@inherits PortalPageBase

<PageTitle>Stok — Yönetim Paneli</PageTitle>

@if (!Ready)
{
    <PageLoading />
}
else
{
    <PageHeader Title="Stok durumu" Eyebrow="Kayıtlar" Subtitle="Tüm depoların toplam miktarı" Busy="Busy">
        <Actions>
            <form class="toolbar-search" @onsubmit="SearchAsync" @onsubmit:preventDefault>
                <MudTextField T="string" @bind-Value="_search" Placeholder="Stok kodu veya ürün adı" Variant="Variant.Outlined" Margin="Margin.Dense"
                              InputId="stock-search" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Rounded.Search" Clearable="true" />
                <div id="stock-out-only" class="toolbar-switch">
                    <MudSwitch T="bool" @bind-Value="_outOnly" Color="Color.Error" Label="Yalnızca tükenenler" />
                </div>
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@Busy">Göster</MudButton>
            </form>
        </Actions>
    </PageHeader>

    @if (Error is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="page-alert" id="page-error">@Error</MudAlert>
    }

    @if (_stock is not null)
    {
        var outCount = _stock.Rows.Count(r => r.Quantity <= 0);
        <section class="stat-grid stat-grid--three">
            <StatCard Label="Listelenen ürün" Value="@_stock.Rows.Count.ToString(Fmt.Turkish)" Icon="@Icons.Material.Rounded.Inventory2" Tone="primary" />
            <StatCard Label="Stokta olan" Value="@((_stock.Rows.Count - outCount).ToString(Fmt.Turkish))" Caption="listelenenler içinde" Icon="@Icons.Material.Rounded.CheckCircle" Tone="success" />
            <StatCard Label="Tükenen" Value="@outCount.ToString(Fmt.Turkish)" Caption="listelenenler içinde" Icon="@Icons.Material.Rounded.DoNotDisturbOn" Tone="danger" Attention="@(outCount > 0)" />
        </section>

        <MudPaper Outlined="true" Class="panel panel--table mt-3">
            @if (_stock.Rows.Count == 0)
            {
                <EmptyState Id="stock-empty" Icon="@Icons.Material.Rounded.Inventory2" Title="Listeye uyan ürün yok." />
            }
            else
            {
                <div class="table-scroll">
                    <MudSimpleTable Hover="true" Dense="true" Elevation="0" Class="data-table" id="stock-table">
                        <thead>
                            <tr>
                                <th>Kod</th>
                                <th>Ürün</th>
                                <th class="num">Miktar</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _stock.Rows)
                            {
                                <tr data-stock="@row.StockCode">
                                    <td class="mono">@row.StockCode</td>
                                    <td class="cell-title">@row.Name</td>
                                    <td class="num">
                                        @if (row.Quantity <= 0)
                                        {
                                            <span class="badge badge--off">@Fmt.Quantity(row.Quantity)</span>
                                        }
                                        else
                                        {
                                            @Fmt.Quantity(row.Quantity)
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </div>
                @if (_stock.Truncated)
                {
                    <div class="table-foot" id="stock-truncated">İlk @_stock.Rows.Count ürün gösteriliyor. Belirli bir ürün için arama yapın.</div>
                }
            }
        </MudPaper>
    }
}

@code {
    private string? _search;
    private bool _outOnly;
    private StockResponse? _stock;

    protected override async Task LoadAsync() => _stock = await Api.StockAsync(_search, _outOnly);

    private Task SearchAsync() => RunAsync(LoadAsync);
}
