@* Title row of every signed-in page: title and subtitle on the left, filters on the right. *@
<div class="page-header">
    <div class="page-header-text">
        @if (!string.IsNullOrEmpty(Eyebrow))
        {
            <div class="page-eyebrow">@Eyebrow</div>
        }
        <MudText Typo="Typo.h4" HtmlTag="h1">@Title</MudText>
        @if (!string.IsNullOrEmpty(Subtitle))
        {
            <MudText Typo="Typo.body2" Class="text-muted page-subtitle">@Subtitle</MudText>
        }
    </div>
    @if (Actions is not null)
    {
        <div class="page-header-actions">@Actions</div>
    }
</div>

@if (Busy)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Size="Size.Small" Class="page-progress" />
}
else
{
    <div class="page-progress page-progress--idle"></div>
}

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? Eyebrow { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public bool Busy { get; set; }
}
