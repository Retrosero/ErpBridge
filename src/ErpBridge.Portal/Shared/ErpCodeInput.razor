@* An ERP code: a list to pick from when the ERP sent one, free text otherwise (goal ERP yazım Y1c). *@

<label class="stack-field">
    <span class="field-label">@Label</span>
    @if (Items.Count > 0)
    {
        <select class="portal-select" id="@Id" value="@(Value ?? "")" disabled="@Disabled" @onchange="e => ChangeAsync(e.Value?.ToString())">
            <option value="">@EmptyText</option>
            @if (!string.IsNullOrEmpty(Value) && Items.All(i => i.Code != Value))
            {
                <option value="@Value">@Value (ERP listesinde yok)</option>
            }
            @foreach (var item in Items)
            {
                <option value="@item.Code">@item.Code — @item.Name</option>
            }
        </select>
    }
    else
    {
        <input class="portal-input" id="@Id" value="@Value" maxlength="@MaxLength" placeholder="@EmptyText" disabled="@Disabled"
               @onchange="e => ChangeAsync(e.Value?.ToString())" />
    }
    @if (Hint is not null)
    {
        <span class="field-hint">@Hint</span>
    }
</label>

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public IReadOnlyList<ErpLookupItem> Items { get; set; } = [];

    /// <summary>What an empty value means here ("Seçilmedi", "Firma varsayılanı").</summary>
    [Parameter] public string EmptyText { get; set; } = "Seçilmedi";

    [Parameter] public int MaxLength { get; set; } = 25;
    [Parameter] public string? Hint { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private Task ChangeAsync(string? value) => ValueChanged.InvokeAsync(string.IsNullOrWhiteSpace(value) ? null : value.Trim());
}
