<UserControl x:Class="ErpBridge.Agent.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ErpBridge.Agent.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             Background="{DynamicResource WindowBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="28,22,28,32" MinWidth="880">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header row: title + status badge + refresh button -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Vertical">
                <TextBlock Text="Dashboard"
                           FontSize="28" FontWeight="SemiBold"
                           Foreground="{DynamicResource HeaderBrush}" />
                <TextBlock Text="ERP senkronizasyon durumu, veri akışı ve hızlı işlemler"
                           FontSize="13"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Margin="0,2,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{Binding StatusBadgeBrush}"
                        CornerRadius="3"
                        Padding="10,3"
                        Margin="0,0,12,0"
                        ToolTip="Senkronizasyon gecikmesi / sağlık durumu">
                    <TextBlock Text="{Binding StatusBadgeText}"
                               Foreground="White"
                               FontWeight="SemiBold"
                               FontSize="13" />
                </Border>
                <Button Content="🚀 Şimdi Bootstrap Et"
                        Command="{Binding RunBootstrapCommand}"
                        MinWidth="180"
                        Margin="0,0,8,0"
                        Padding="10,4"
                        ToolTip="Mikro'dan referans verileri çek ve Central API'ye gönder (60 dk idempotency penceresini bypass eder)" />
                <Button Content="🔄 Yenile"
                        Command="{Binding RefreshCommand}"
                        MinWidth="110"
                        Padding="10,4" />
                <Button Content="⚙ Ayarlar"
                        Click="OpenSettings_Click"
                        MinWidth="110"
                        Margin="8,0,0,0"
                        Padding="10,4" />
            </StackPanel>
        </Grid>

        <!-- Per-section bootstrap buttons (workaround for slow Cloudflare tunnel) -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,8"
                Margin="0,0,0,16">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Tablo Senkronizasyonları"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource HeaderBrush}" />
                        <TextBlock Text="Her tablonun son başarılı güncellemesini izleyebilir veya tek başına yenileyebilirsiniz."
                                   FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#ECFDF5" CornerRadius="12"
                            Padding="12,6" VerticalAlignment="Center">
                        <TextBlock Text="Canlı izleme otomatik"
                                   Foreground="#047857" FontWeight="SemiBold" />
                    </Border>
                </Grid>

                <Border Background="#F8FAFC" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="12,8">
                    <StackPanel>
                        <Grid Margin="10,0,10,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="TABLO" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock Grid.Column="1" Text="KAYIT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock Grid.Column="2" Text="SON ALGILAMA" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock Grid.Column="3" Text="SON AKTARIM" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock Grid.Column="4" Text="İŞLEM" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding SectionStatuses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="{DynamicResource DividerBrush}"
                                            BorderThickness="0,1,0,0" Padding="10,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding CountDisplay}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding LastDetectedDisplay}"
                                                       Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding LastUpdatedDisplay}"
                                                       Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                            <Button Grid.Column="4" Content="Senkronize Et"
                                                    Command="{Binding SyncCommand}" Padding="8,5" MinHeight="30" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- MikroDB row-count diagnostic. Disambiguates "MikroDB empty"
                     from "SQL filter wrong" — both look like 0-row push. -->
                <Button Content="🔢 MikroDB Satır Sayıları"
                        Command="{Binding CheckMikroRowCountsCommand}"
                        MinWidth="220" Margin="0,8,0,0" Padding="8,4"
                        ToolTip="Tüm Mikro tablolarından SELECT COUNT(*) çalıştırır. Push 0 dönüyorsa MikroDB gerçekten boş mu yoksa SQL filtresi mi yanlış, bunu ayırt etmek için kullanılır." />

                <Border Margin="0,8,0,0"
                        Padding="10,8"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Background="{DynamicResource StatusBackgroundBrush}"
                        Visibility="{Binding HasMikroCountResult, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{Binding MikroCountSummaryDisplay}"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Foreground="{DynamicResource HeaderBrush}"
                                   TextWrapping="Wrap" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="CARI_HESAPLAR" Margin="0,1" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding MikroCustomersCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="STOKLAR" Margin="0,1" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MikroStocksCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="SIPARISLER (açık)" Margin="0,1" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MikroOpenOrdersCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="KASALAR" Margin="0,1" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding MikroCashCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" />
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="BANKALAR" Margin="0,1" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding MikroBankCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" />
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="KASALAR + BANKALAR" Margin="0,1" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding MikroCashAndBankCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" />
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="DEPOLAR + PERSONEL" Margin="0,1" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding MikroLookupsCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" />
                            <TextBlock Grid.Row="7" Grid.Column="0" Text="STOK_SATIS_FIYAT_LISTELERI" Margin="0,1" />
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding MikroPricesCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" />
                            <TextBlock Grid.Row="8" Grid.Column="0" Text="STOK_HAREKETLERI" Margin="0,1" />
                            <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding MikroInventoryCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" />
                            <TextBlock Grid.Row="9" Grid.Column="0" Text="CARI_HESAP_ADRESLERI" Margin="0,1" />
                            <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding MikroCustomerAddressesCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" />
                            <TextBlock Grid.Row="10" Grid.Column="0" Text="CARI_HESAP_YETKILILERI" Margin="0,1" />
                            <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding MikroCustomerContactsCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" />
                            <TextBlock Grid.Row="11" Grid.Column="0" Text="BARKOD_TANIMLARI" Margin="0,1" />
                            <TextBlock Grid.Row="11" Grid.Column="1" Text="{Binding MikroBarcodesCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" />
                            <TextBlock Grid.Row="12" Grid.Column="0" Text="SATIS_SARTLARI" Margin="0,1" />
                            <TextBlock Grid.Row="12" Grid.Column="1" Text="{Binding MikroSalesConditionsCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" />
                            <TextBlock Grid.Row="13" Grid.Column="0" Text="CARI_HESAP_HAREKETLERI" Margin="0,1" />
                            <TextBlock Grid.Row="13" Grid.Column="1" Text="{Binding MikroCustomerTransactionsCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" />
                            <TextBlock Grid.Row="14" Grid.Column="0" Text="STOK_HAREKETLERI (satırlar)" Margin="0,1" />
                            <TextBlock Grid.Row="14" Grid.Column="1" Text="{Binding MikroStockTransactionsCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" />
                        </Grid>
                        <TextBlock Text="{Binding MikroCountTimeDisplay, StringFormat='Son kontrol: {0}'}"
                                   FontSize="10"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Top cards: last sync + counts -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Last sync card -->
            <Border Grid.Column="0"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="Son Senkronizasyon"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock Text="{Binding LastSyncAtDisplay}"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource HeaderBrush}"
                               Margin="0,6,0,0" />
                    <TextBlock Text="{Binding LastSyncRelativeDisplay}"
                               FontSize="12"
                               Foreground="{DynamicResource AccentBrush}"
                               Margin="0,2,0,0" />
                    <TextBlock Text="{Binding NextEligibleRunDisplay}"
                               FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- Last run summary card -->
            <Border Grid.Column="2"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="Son Çalıştırma Özeti"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Cariler" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LastCustomersCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Stoklar" Margin="0,2,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LastStocksCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" Margin="0,2,0,0" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Fiyatlar" Margin="0,2,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LastPricesCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" Margin="0,2,0,0" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Açık siparişler" Margin="0,2,0,0" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LastOpenOrdersCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" Margin="0,2,0,0" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Cari adresleri" Margin="0,2,0,0" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding LastCustomerAddressesCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" Margin="0,2,0,0" />
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Cari yetkilileri" Margin="0,2,0,0" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding LastCustomerContactsCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" Margin="0,2,0,0" />
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Barkodlar" Margin="0,2,0,0" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding LastBarcodesCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" Margin="0,2,0,0" />
                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Satış şartları" Margin="0,2,0,0" />
                        <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding LastSalesConditionsCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" Margin="0,2,0,0" />
                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Cari hareketleri" Margin="0,2,0,0" />
                        <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding LastCustomerTransactionsCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" Margin="0,2,0,0" />
                        <TextBlock Grid.Row="9" Grid.Column="0" Text="Stok hareketleri" Margin="0,2,0,0" />
                        <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding LastStockTransactionsCountDisplay}" FontFamily="Consolas, Lucida Console, monospace" Margin="0,2,0,0" />
                    </Grid>

                    <Border Background="{Binding LastRunStatusBrush}"
                            CornerRadius="3"
                            Padding="8,3"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Left">
                        <TextBlock Text="{Binding LastRunStatusDisplay}"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   FontSize="12" />
                    </Border>
                    <TextBlock Text="{Binding LastRunSummaryDisplay}"
                               FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Bottom: status / hint area -->
        <Border Grid.Row="3"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16">
            <StackPanel>
                <TextBlock Text="Hatırlatma"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedTextBrush}" />
                <TextBlock TextWrapping="Wrap"
                           Foreground="{DynamicResource SubtleHeaderBrush}"
                           Margin="0,8,0,0">
                    <Run Text="Uygulama sistem tepsisine (saat kısmının yanı) küçültüldüğünde arka planda çalışmaya devam eder. Çift tıklayarak pencereyi geri getirebilirsiniz." />
                    <LineBreak />
                    <LineBreak />
                    <Run Text="Son senkronizasyon, Central API'ye gönderilen en son başarılı bootstrap yüklemesidir. İdempotency penceresi 60 dakikadır — bu süre içinde yeni bir tetikleme yapılmaz." />
                </TextBlock>

                <Border Background="{DynamicResource WarningLightBrush}"
                        BorderBrush="{DynamicResource WarningBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10,8"
                        Margin="0,16,0,0"
                        Visibility="{Binding LastErrorDisplay, Converter={StaticResource StringToVisibilityConverter}}">
                    <TextBlock Text="{Binding LastErrorDisplay}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource WarningBrush}" />
                </Border>
            </StackPanel>
        </Border>
    </Grid>
    </ScrollViewer>
</UserControl>
