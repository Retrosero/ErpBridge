@page "/licenses"
@inject ErpBridge.Admin.Api.CentralApiClient Api
@inject NavigationManager Nav
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using ErpBridge.Admin.Api

<PageTitle>@Current.Name lisansları — ErpBridge Admin</PageTitle>

@* Ürünler hiçbir zaman aynı listede görünmez: her ürünün kendi sekmesi, rengi, harf işareti ve anahtar öneki vardır.
   Yeni lisans formu açık sekmenin ürününe kilitlidir, yanlış ürüne anahtar üretilemez. *@
<section class="license-page license-theme--@Current.CssModifier" aria-labelledby="licenses-title">
    <header class="license-page__header">
        <div>
            <p class="license-page__eyebrow">ERPBRIDGE / ERİŞİM YÖNETİMİ</p>
            <h1 id="licenses-title">Lisanslar</h1>
            <p class="license-page__subtitle">Her ürünün lisansları ayrı tutulur. Bir ürünün anahtarı yalnız o üründe çalışır; öneki ve rengi ürünü gösterir.</p>
        </div>
        <button class="btn license-refresh" @onclick="ReloadAsync" disabled="@_loading" aria-label="Lisans listesini yenile"><svg class="admin-icon" aria-hidden="true"><use href="icons.svg#refresh" /></svg> Yenile</button>
    </header>

    <nav class="license-products" role="tablist" aria-label="Ürün">
        @foreach (var p in LicenseProductCatalog.All)
        {
            var mine = _licenses.Where(l => LicenseProductCatalog.Get(l.Product).Key == p.Key).ToList();
            var selected = p.Key == Current.Key;
            <button type="button" role="tab" id="license-tab-@p.Key" aria-selected="@(selected ? "true" : "false")"
                    class="license-product-tab license-product--@p.CssModifier @(selected ? "is-selected" : "")" @onclick="() => Select(p.Key)">
                <span class="license-mark" aria-hidden="true">@p.Mark</span>
                <span class="license-product-tab__text">
                    <strong>@p.Name</strong>
                    <small>@p.Summary</small>
                </span>
                <span class="license-product-tab__count" title="Aktif / toplam">@mine.Count(l => l.IsActive)<em>/@mine.Count</em></span>
            </button>
        }
    </nav>

    <div class="license-context license-product--@Current.CssModifier" id="license-context">
        <span class="license-mark" aria-hidden="true">@Current.Mark</span>
        <p>
            Şu an <strong>@Current.Name</strong> lisanslarını görüyorsunuz. Anahtarlar <code class="license-prefix">@Current.KeyPrefix</code> ile başlar
            ve yalnız bu üründe çalışır. @Current.WhereUsed
        </p>
    </div>

    @if (_loading)
    {
        <div class="license-loading" role="status"><span class="license-loading__spinner" aria-hidden="true"></span>Lisanslar hazırlanıyor…</div>
    }
    else
    {
        <div class="license-summary" aria-label="@Current.Name lisans özeti">
            <div class="license-stat"><span>@Current.Name lisansı</span><strong>@Visible.Count</strong><small>@Current.Name müşteri lisansları</small></div>
            <div class="license-stat license-stat--active"><span>Aktif lisans</span><strong>@Visible.Count(l => l.IsActive)</strong><small>Erişimi açık lisanslar</small></div>
            <div class="license-stat license-stat--inactive"><span>Pasif lisans</span><strong>@Visible.Count(l => !l.IsActive)</strong><small>Erişimi kapalı lisanslar</small></div>
        </div>

        <section class="license-issue" aria-labelledby="issue-license-title">
            <div class="license-issue__heading">
                <span class="license-mark license-product--@Current.CssModifier" aria-hidden="true">@Current.Mark</span>
                <div><h2 id="issue-license-title">Yeni @Current.Name lisansı</h2><p>Üretilen anahtar <code class="license-prefix">@Current.KeyPrefix</code> ile başlar. Başka bir ürün için yukarıdan o ürünün sekmesine geçin.</p></div>
            </div>
            <div class="license-issue__form">
                <label><span>Müşteri</span><select class="form-select" @bind="_create.TenantIdString" aria-label="Müşteri seçin"><option value="">Müşteri seçin…</option>@foreach (var t in _tenants) { <option value="@t.Id.ToString()">@t.Name</option> }</select></label>
                <label><span>Bitiş tarihi <em>(isteğe bağlı)</em></span><input class="form-control" type="datetime-local" @bind="_create.ExpiresAtLocal" /><small>Tarih seçilmezse lisans süresiz olur.</small></label>
                <button id="license-create" class="btn btn-primary license-issue__button" @onclick="CreateAsync" disabled="@(string.IsNullOrEmpty(_create.TenantIdString) || _busy)">@(_busy ? "Oluşturuluyor…" : $"{Current.Name} lisansı oluştur")</button>
            </div>
        </section>

        @if (_lastIssued is { } issued)
        {
            var product = LicenseProductCatalog.Get(issued.Product);
            <div class="license-notice license-notice--success" role="status"><span class="license-notice__icon" aria-hidden="true">✓</span><div><strong>@product.Name lisansı oluşturuldu</strong><p>Bu anahtar yalnızca şimdi tam olarak görüntülenir. @product.WhereUsed</p><code id="license-issued-key">@issued.LicenseKey</code></div></div>
        }
        @if (!string.IsNullOrEmpty(_info)) { <div class="license-notice license-notice--success" role="status"><span class="license-notice__icon" aria-hidden="true">✓</span><div><strong>@_info</strong></div></div> }
        @if (!string.IsNullOrEmpty(_error)) { <div class="license-notice license-notice--error" role="alert">@_error</div> }

        <section class="license-list" aria-labelledby="license-list-title">
            <div class="license-list__heading"><div><h2 id="license-list-title">@Current.Name lisansları</h2><p>Müşteri erişimleri ve lisans geçerlilik bilgileri</p></div><span class="license-list__count">@Visible.Count kayıt</span></div>
            @if (Visible.Count == 0)
            {
                <div class="license-empty"><svg class="admin-icon" aria-hidden="true"><use href="icons.svg#license" /></svg><h3>Henüz @Current.Name lisansı yok</h3><p>İlk lisansı yukarıdaki formdan oluşturabilirsiniz.</p></div>
            }
            else
            {
                <div class="license-cards">
                    @foreach (var l in Visible)
                    {
                        var product = LicenseProductCatalog.Get(l.Product);
                        var isGo = product.Key == LicenseProductNames.Go;
                        var prefix = product.KeyPrefix;
                        var hasPrefix = !LicenseProductCatalog.HasForeignPrefix(l);
                        <article class="license-card license-product--@product.CssModifier" data-product="@product.Key">
                            <div class="license-card__topline">
                                <div class="license-card__customer"><span class="license-card__mark" aria-hidden="true"><svg class="admin-icon"><use href="icons.svg#customers" /></svg></span><div><small>Müşteri</small><h3 class="license-card__tenant">@(TenantName(l.TenantId))</h3></div></div>
                                <span class="license-status @(l.IsActive ? "license-status--active" : "license-status--inactive")"><i aria-hidden="true"></i>@(l.IsActive ? "Aktif" : "Pasif")</span>
                            </div>
                            <div class="license-card__identity"><span class="license-product-chip"><span class="license-mark license-mark--small" aria-hidden="true">@product.Mark</span>@product.Name · Lisans anahtarı</span><code class="license-card__key">@if (hasPrefix) { <span class="license-prefix">@prefix</span>@l.LicenseKey[prefix.Length..] } else { @l.LicenseKey }</code></div>
                            @if (!hasPrefix)
                            {
                                <p class="license-card__legacy">Önekten önce üretilmiş anahtar; ürünü etiketinden anlaşılır.</p>
                            }
                            <dl class="license-card__details"><div><dt>Oluşturulma</dt><dd>@l.IssuedAtUtc.LocalDateTime.ToString("dd MMM yyyy, HH:mm")</dd></div><div><dt>Bitiş</dt><dd>@(l.ExpiresAtUtc?.LocalDateTime.ToString("dd MMM yyyy, HH:mm") ?? "Süresiz")</dd></div></dl>
                            @if (isGo)
                            {
                                <div class="license-device">
                                    @if (l.GoInstallation is { } device)
                                    {
                                        <p><strong>Bilgisayar:</strong> @(device.MachineName ?? "adı bilinmiyor") @(device.AppVersion is { } v ? $"· sürüm {v}" : "")</p>
                                        <p class="license-device__meta">Etkinleştirme @device.ActivatedAtUtc.LocalDateTime.ToString("dd MMM yyyy, HH:mm") · son görülme @device.LastSeenAtUtc.LocalDateTime.ToString("dd MMM yyyy, HH:mm")</p>
                                    }
                                    else
                                    {
                                        <p class="license-device__meta">Henüz bir bilgisayarda etkinleştirilmedi.</p>
                                    }
                                </div>
                                @* Go modülleri firmaya aittir: aynı firmanın bütün Go lisansları aynı seti gösterir ve taşır. *@
                                <div class="license-modules" data-license="@l.Id">
                                    <p class="license-modules__title"><strong>Modüller</strong><span>firma geneli</span></p>
                                    @if (l.GoModules is { Length: > 0 } modules)
                                    {
                                        <ul class="license-module-chips">
                                            @foreach (var m in modules) { <li class="license-module-chip">@GoModuleCatalog.Name(m)</li> }
                                        </ul>
                                    }
                                    else
                                    {
                                        <p class="license-device__meta">Açık modül yok.</p>
                                    }
                                </div>
                            }
                            <div class="license-card__actions">
                                @if (!isGo)
                                {
                                    <button class="btn btn-outline-primary license-mobile-toggle" @onclick="() => ToggleMobileLogin(l.Id)" aria-expanded="@(_mobileLoginFor == l.Id ? "true" : "false")">@(_mobileLoginFor == l.Id ? "Telefon girişini kapat" : "Telefon girişi oluştur")</button>
                                }
                                @if (l.IsActive)
                                {
                                    <button class="btn btn-outline-secondary" @onclick="() => ToggleExpiry(l)" aria-expanded="@(_expiryFor == l.Id ? "true" : "false")">Süreyi değiştir</button>
                                }
                                @if (isGo && l.IsActive)
                                {
                                    <button class="btn btn-outline-secondary license-modules-toggle" @onclick="() => ToggleModules(l)" aria-expanded="@(_modulesFor == l.Id ? "true" : "false")">Modülleri düzenle</button>
                                }
                                @if (isGo && l.GoInstallation is not null)
                                {
                                    <button class="btn btn-outline-secondary" @onclick="() => ReleaseAsync(l.Id)" disabled="@_busy" title="Anahtar başka bir bilgisayarda etkinleştirilebilir hale gelir">Bilgisayarı serbest bırak</button>
                                }
                                @if (l.IsActive) { <button class="btn license-revoke" @onclick="() => RevokeAsync(l.Id)" disabled="@_busy">Lisansı iptal et</button> }
                            </div>
                            @if (_expiryFor == l.Id)
                            {
                                <div class="license-expiry">
                                    <label><span>Yeni bitiş tarihi <em>(boş = süresiz)</em></span><input class="form-control" type="datetime-local" @bind="_expiryLocal" /></label>
                                    <button class="btn btn-primary" @onclick="() => SaveExpiryAsync(l.Id)" disabled="@_busy">Kaydet</button>
                                </div>
                            }
                            @if (_modulesFor == l.Id)
                            {
                                <fieldset class="license-modules-edit">
                                    <legend>Go modülleri</legend>
                                    <div class="license-modules-edit__options">
                                        @foreach (var m in GoModuleCatalog.All)
                                        {
                                            var key = m.Key;
                                            <label class="license-module-option"><input type="checkbox" id="go-module-@key" checked="@_modulesDraft.Contains(key)" @onchange="e => ToggleModule(key, e.Value is true)" /><span>@m.Name</span></label>
                                        }
                                    </div>
                                    <p class="license-modules-edit__note">
                                        Modüller lisansa değil firmaya açılır: <strong>@TenantName(l.TenantId)</strong> firmasının bütün Go lisansları aynı modülleri taşır.
                                        Değişiklik müşterinin bilgisayarına bir sonraki lisans yenilemesinde ulaşır: uygulama 6 saatte bir yeniler, hemen almak için Go'nun Lisans ekranında "Şimdi doğrula"ya basılır.
                                    </p>
                                    <button id="go-modules-save" class="btn btn-primary" @onclick="() => SaveModulesAsync(l.Id)" disabled="@_busy">Kaydet</button>
                                </fieldset>
                            }
                            @if (_mobileLoginFor == l.Id)
                            {
                                <ErpBridge.Admin.Shared.MobileLoginPanel TenantId="l.TenantId" />
                            }
                        </article>
                    }
                </div>
            }
        </section>
    }
</section>

@code {
    /// <summary>Açık ürün sekmesi (<c>/licenses?urun=go</c>); boş ya da bilinmeyen değer ErpBridge'dir.</summary>
    [SupplyParameterFromQuery(Name = "urun")] public string? ProductQuery { get; set; }

    private bool _loading = true;
    private bool _busy;
    private IReadOnlyList<LicenseDto> _licenses = Array.Empty<LicenseDto>();
    private IReadOnlyList<TenantDto> _tenants = Array.Empty<TenantDto>();
    private LicenseDto? _lastIssued;
    private string? _info;
    private string? _error;
    private readonly CreateModel _create = new();
    private sealed class CreateModel { public string TenantIdString { get; set; } = string.Empty; public DateTime? ExpiresAtLocal { get; set; } public Guid TenantId => Guid.TryParse(TenantIdString, out var g) ? g : Guid.Empty; }
    // One license at a time shows the phone-login panel; each panel loads its tenant on demand.
    private Guid? _mobileLoginFor;
    private Guid? _expiryFor;
    private DateTime? _expiryLocal;
    // Go module editor: one license at a time; the draft holds the ticked keys until saved.
    private Guid? _modulesFor;
    private readonly HashSet<string> _modulesDraft = new(StringComparer.Ordinal);

    private LicenseProductInfo Current => LicenseProductCatalog.Get(ProductQuery);
    private List<LicenseDto> Visible => _licenses.Where(l => LicenseProductCatalog.Get(l.Product).Key == Current.Key).ToList();

    private void Select(string product)
    {
        _mobileLoginFor = null;
        _expiryFor = null;
        _modulesFor = null;
        _lastIssued = null;
        _info = null;
        _error = null;
        Nav.NavigateTo(Nav.GetUriWithQueryParameter("urun", product));
    }

    private void ToggleMobileLogin(Guid licenseId) => _mobileLoginFor = _mobileLoginFor == licenseId ? null : licenseId;
    private void ToggleExpiry(LicenseDto l) { _expiryFor = _expiryFor == l.Id ? null : l.Id; _expiryLocal = l.ExpiresAtUtc?.LocalDateTime; }

    /// <summary>Opens the module editor with the company's current set; keys the console does not know are left out (the server would refuse them).</summary>
    private void ToggleModules(LicenseDto l)
    {
        _modulesFor = _modulesFor == l.Id ? null : l.Id;
        _modulesDraft.Clear();
        foreach (var key in l.GoModules ?? []) if (GoModuleCatalog.All.Any(m => m.Key == key)) _modulesDraft.Add(key);
    }

    private void ToggleModule(string key, bool on) { if (on) _modulesDraft.Add(key); else _modulesDraft.Remove(key); }
    private string TenantName(Guid id) => _tenants.FirstOrDefault(t => t.Id == id)?.Name ?? id.ToString().Substring(0, 8);
    private static DateTimeOffset? ToOffset(DateTime? local) => local is { } d ? new DateTimeOffset(DateTime.SpecifyKind(d, DateTimeKind.Local)) : null;
    protected override async Task OnInitializedAsync() => await ReloadAsync();
    private async Task ReloadAsync() { _loading = true; _error = null; try { _tenants = await Api.ListTenantsAsync(); _licenses = await Api.ListLicensesAsync(); } catch (Exception ex) { _error = ex.Message; } finally { _loading = false; } }
    private async Task CreateAsync() { _busy = true; _error = null; _info = null; try { _lastIssued = await Api.CreateLicenseAsync(_create.TenantId, ToOffset(_create.ExpiresAtLocal), Current.Key); await ReloadAsync(); } catch (Exception ex) { _error = ex.Message; } finally { _busy = false; } }
    private async Task RevokeAsync(Guid id) { _busy = true; _info = null; try { await Api.RevokeLicenseAsync(id); await ReloadAsync(); } catch (Exception ex) { _error = ex.Message; } finally { _busy = false; } }
    private async Task SaveExpiryAsync(Guid id) { _busy = true; _error = null; _info = null; try { await Api.UpdateLicenseExpiryAsync(id, ToOffset(_expiryLocal)); _expiryFor = null; _info = "Bitiş tarihi güncellendi. Uygulama yeni tarihi bir sonraki doğrulamada alır."; await ReloadAsync(); } catch (Exception ex) { _error = ex.Message; } finally { _busy = false; } }
    private async Task SaveModulesAsync(Guid id) { _busy = true; _error = null; _info = null; try { await Api.SetGoModulesAsync(id, GoModuleCatalog.All.Select(m => m.Key).Where(_modulesDraft.Contains).ToList()); _modulesFor = null; _info = "Modüller kaydedildi. Firmanın Go lisanslarının hepsine uygulanır; müşterinin bilgisayarı bir sonraki lisans yenilemesinde alır (6 saatte bir ya da Lisans ekranında \"Şimdi doğrula\")."; await ReloadAsync(); } catch (Exception ex) { _error = ex.Message; } finally { _busy = false; } }
    private async Task ReleaseAsync(Guid id) { _busy = true; _error = null; _info = null; try { await Api.ReleaseGoInstallationAsync(id); _info = "Bilgisayar serbest bırakıldı. Anahtarı yeni bilgisayarda hemen etkinleştirin; eski bilgisayar açıksa ve önce yenilerse anahtarı yeniden alır."; await ReloadAsync(); } catch (Exception ex) { _error = ex.Message; } finally { _busy = false; } }
}
