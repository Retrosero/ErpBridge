{
  "ConnectionStrings": {
    "CentralApi": "Host=<host>;Port=5432;Database=erpbridge_central;Username=<user>;Password=<password>"
  },
  "Jwt": {
    "Issuer": "ErpBridge.CentralApi",
    "Audience": "ErpBridge.Agents",
    "SigningKey": "<at-least-32-byte-secret>",
    "AccessTokenMinutes": 60
  },
  "Admin": {
    "SeedEmail": "<admin-email>",
    "SeedPassword": "<admin-password>",
    "SeedDisplayName": "ErpBridge Admin"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5080"
      }
    }
  }
}