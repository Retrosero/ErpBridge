@page "/tenants"
@inject ErpBridge.Admin.Api.CentralApiClient Api
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Müşteriler — ErpBridge Yönetim</PageTitle>

<AdminPageHeader Title="Müşteriler" Description="ERP bağlantısı olan müşteri hesaplarını ve erişim durumlarını yönetin.">
    <Actions><a class="btn btn-primary" href="tenants/create">+ Yeni müşteri</a></Actions>
</AdminPageHeader>

@if (_loading)
{
    <AdminLoading Text="Müşteriler yükleniyor…" />
}
else if (!string.IsNullOrEmpty(_error))
{
    <AdminState Tone="error" Icon="!" Title="Müşteriler alınamadı" Message="@_error" />
}
else
{
    <div class="admin-data-surface">
    <table class="table admin-data-table">
        <thead>
            <tr>
                <th>Kimlik</th><th>Müşteri</th><th>Oluşturulma</th><th>Durum</th><th>İşlem</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in _tenants)
            {
                <tr>
                    <td data-label="Kimlik"><code>@t.Id.ToString().Substring(0, 8)</code></td>
                    <td data-label="Müşteri"><strong>@t.Name</strong></td>
                    <td data-label="Oluşturulma">@t.CreatedAtUtc.LocalDateTime.ToString("dd MMM yyyy, HH:mm")</td>
                    <td data-label="Durum"><AdminStatusBadge Text="@(t.IsActive ? "Aktif" : "Pasif")" Tone="@(t.IsActive ? "success" : "muted")" /></td>
                    <td data-label="İşlem" class="admin-data-table__action">
                        @if (t.IsActive)
                        {
                            <button class="btn btn-sm btn-warning" @onclick="() => DeactivateAsync(t.Id)">Pasifleştir</button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-success" @onclick="() => ActivateAsync(t.Id)">Etkinleştir</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

@code {
    private bool _loading = true;
    private IReadOnlyList<ErpBridge.Admin.Api.TenantDto> _tenants = Array.Empty<ErpBridge.Admin.Api.TenantDto>();
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _tenants = await Api.ListTenantsAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private async Task DeactivateAsync(Guid id)
    {
        try { await Api.UpdateTenantAsync(id, false); await ReloadAsync(); }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task ActivateAsync(Guid id)
    {
        try { await Api.UpdateTenantAsync(id, true); await ReloadAsync(); }
        catch (Exception ex) { _error = ex.Message; }
    }
}
